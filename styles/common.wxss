/**
 * 公共样式 - 统一所有页面的基础样式
 * 在 app.wxss 中通过 @import 引入，分包页面自动继承
 *
 * ========== 设计规范 ==========
 *
 * 【品牌色系】
 * - 主品牌色: #1F6FAD
 * - 主渐变: linear-gradient(135deg, #1F6FAD 0%, #2E8B9A 100%)
 *
 * 【角色主题色】
 * - 管理员: linear-gradient(135deg, #722ed1 0%, #9254de 100%)
 * - 教师: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%)
 * - 班主任: linear-gradient(135deg, #52c41a 0%, #95de64 100%)
 * - 领导: linear-gradient(135deg, #faad14 0%, #ffd666 100%)
 *
 * 【状态色】
 * - 成功/到课: #52c41a, 背景: #f6ffed
 * - 错误/缺课: #ff4d4f, 背景: #fff1f0
 * - 警告: #ff9800, 背景: #fff7e6
 * - 信息: #1890ff, 背景: #e6f7ff
 *
 * 【文本色】
 * - 主文本: #333333
 * - 次文本: #666666
 * - 辅助文本: #999999
 *
 * 【背景色】
 * - 页面背景: #f5f5f5
 * - 卡片背景: #ffffff
 * - 元素背景: #f5f7fa
 *
 * 【边框与圆角】
 * - 边框色: #e8e8e8, 悬停: #d0d0d0
 * - 卡片圆角: 12rpx
 * - 标签圆角: 20rpx
 *
 * 【卡片风格】扁平描边风格，无阴影
 * - border: 2rpx solid #e8e8e8
 * - border-radius: 12rpx
 */

/* ========== 顶部信息栏 ========== */
.header-section {
  background: linear-gradient(135deg, #1F6FAD 0%, #2E8B9A 100%);
  padding: 40rpx 30rpx;
  color: #ffffff;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

/* ========== 切换身份按钮 ========== */
.switch-role-btn {
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-role-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.switch-role-text {
  font-size: 24rpx;
  color: #fff;
}

/* ========== 日期选择器 ========== */
.date-selector {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  width: fit-content;
}

/* ========== 统计区域 ========== */
.stats-section {
  margin: -40rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.stat-content {
  padding: 30rpx 0;
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #333333;
}

.stat-number.present {
  color: #52c41a;
}

.stat-number.absent {
  color: #ff4d4f;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 页面标题样式 ========== */
.page-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title-text {
  font-size: 40rpx;
  font-weight: bold;
}

/* ========== 信息详情行 ========== */
.detail-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  flex-wrap: nowrap;
}

.detail-row:last-child {
  margin-bottom: 0;
}

/* ========== 加载更多 ========== */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

.load-more .load-more-text {
  margin-left: 10rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #999;
}

.empty-state .empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
}

/* ========== 2.1 页面容器 ========== */
.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.page-container.with-tabbar {
  padding-bottom: 140rpx;
}

/* ========== 2.2 通用卡片 - 扁平描边风格 ========== */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card:active {
  background-color: #fafafa;
  border-color: #d0d0d0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* ========== 2.3 状态标签 ========== */
.status-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.success,
.status-badge.present {
  background: #f6ffed;
  color: #52c41a;
}

.status-badge.error,
.status-badge.absent {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-badge.warning {
  background: #fff7e6;
  color: #ff9800;
}

.status-badge.info,
.status-badge.pending {
  background: #e6f7ff;
  color: #1890ff;
}

/* ========== 2.4 加载状态 ========== */
.loading-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* ========== 2.5 信息行 ========== */
.info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.info-row .label {
  color: #999;
  flex-shrink: 0;
}

.info-row .value {
  color: #333;
  font-weight: 500;
}

/* ========== 2.6 统计项 ========== */
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.stat-value.primary {
  color: #1890ff;
}

.stat-value.success {
  color: #52c41a;
}

.stat-value.error {
  color: #ff4d4f;
}

/* ========== 2.7 Tab 切换 ========== */
.tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 2rpx solid #e8e8e8;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1890ff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #1890ff;
  border-radius: 3rpx;
}

/* ========== 2.8 排名样式 ========== */
.ranking-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
}

.rank-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.rank-badge.first {
  background: #fffbe6;
  color: #ffd700;
}

.rank-badge.second {
  background: #f5f5f5;
  color: #c0c0c0;
}

.rank-badge.third {
  background: #fff7e6;
  color: #cd7f32;
}

.rate-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.rate-badge.excellent {
  background: #e6f7ff;
  color: #1890ff;
}

.rate-badge.good {
  background: #f6ffed;
  color: #52c41a;
}

.rate-badge.normal {
  background: #fff7e6;
  color: #ff9800;
}

.rate-badge.poor {
  background: #fff1f0;
  color: #ff4d4f;
}

/* ========== 2.9 操作按钮组 ========== */
.action-buttons {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-buttons.center {
  justify-content: center;
}

.action-buttons.space-between {
  justify-content: space-between;
}

/* ========== 2.10 搜索栏 ========== */
.search-bar {
  background-color: #fff;
  padding-bottom: 20rpx;
}

/* ========== 2.11 浮动操作按钮 ========== */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  z-index: 100;
}

.fab-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.fab-btn.admin {
  background: linear-gradient(135deg, #722ed1 0%, #9254de 100%);
  box-shadow: 0 8rpx 24rpx rgba(114, 46, 209, 0.4);
}

.fab-btn.teacher {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.4);
}

/* ========== 2.12 对话框样式 ========== */
.dialog-content {
  padding: 20rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

/* ========== 2.13 筛选器样式 ========== */
.filter-section {
  background-color: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.filter-picker {
  flex: 1;
}

.filter-picker-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s;
}

.filter-picker-content:active {
  background-color: #e6f7ff;
  border-color: #1890ff;
}

.filter-picker-content.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.filter-label {
  font-size: 22rpx;
  color: #999;
}

.filter-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.filter-reset {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #1890ff;
  background-color: #e6f7ff;
  border-radius: 8rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.filter-reset:active {
  background-color: #bae7ff;
}

.filter-reset.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

.filter-result {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
  padding: 12rpx 16rpx;
  background-color: #f0f9ff;
  border-radius: 6rpx;
  border-left: 4rpx solid #1890ff;
}

/* ========== 2.14 用户/学生信息样式 ========== */
.user-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.user-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #999;
}

/* ========== 2.15 滑动操作样式 ========== */
.swipe-actions {
  display: flex;
  height: 100%;
}

.swipe-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  color: #fff;
  font-size: 28rpx;
}

.swipe-action-btn.edit {
  background-color: #1890ff;
}

.swipe-action-btn.delete {
  background-color: #ff4d4f;
}

.swipe-action-btn.warning {
  background-color: #ff9800;
}

/* ========== 2.16 徽章样式 ========== */
.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.badge.success {
  background-color: #52c41a;
}

.badge.warning {
  background-color: #ff9800;
}

.badge.info {
  background-color: #1890ff;
}
