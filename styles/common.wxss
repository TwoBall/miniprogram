/**
 * 公共样式 - 统一所有页面的基础样式
 * 在 app.wxss 中通过 @import 引入，分包页面自动继承
 *
 * ========== 设计规范 - Editorial 教育杂志风 ==========
 *
 * 【品牌色系】
 * - 主品牌色: #1a365d (深蓝)
 * - 强调色: #ed8936 (暖橙)
 *
 * 【角色主题色】
 * - 管理员: linear-gradient(165deg, #553c9a 0%, #805ad5 100%) 紫色
 * - 教师: linear-gradient(165deg, #1a365d 0%, #2c5282 100%) 深蓝
 * - 班主任: linear-gradient(165deg, #276749 0%, #38a169 100%) 绿色
 * - 领导: linear-gradient(165deg, #744210 0%, #d69e2e 100%) 金色
 *
 * 【状态色】
 * - 成功/到课: #38a169, 背景: #c6f6d5
 * - 错误/缺课: #c53030, 背景: #fed7d7
 * - 警告: #dd6b20, 背景: #feebc8
 * - 信息: #2b6cb0, 背景: #bee3f8
 *
 * 【文本色】
 * - 主文本: #1a202c (gray-900)
 * - 次文本: #4a5568 (gray-700)
 * - 辅助文本: #718096 (gray-600)
 * - 占位符: #a0aec0 (gray-500)
 *
 * 【背景色】
 * - 页面背景: #fefcf6 (奶白)
 * - 卡片背景: #ffffff
 * - 区块背景: #f7fafc (gray-100)
 *
 * 【边框与圆角】
 * - 边框色: #edf2f7 (gray-200)
 * - 卡片圆角: 16rpx
 * - 按钮圆角: 12rpx
 *
 * 【卡片风格】Editorial 风格 - 微阴影 + 圆角
 * - box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04)
 * - border-radius: 16rpx
 *
 * 注意：以下旧样式保留是为了兼容性，新页面请使用 editorial.wxss 中的 .ed-* 类名
 */

/* ========== 切换身份按钮 ========== */
.switch-role-btn {
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-role-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.switch-role-text {
  font-size: 24rpx;
  color: #fff;
}

/* ========== 日期选择器 ========== */
.date-selector {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  width: fit-content;
}

/* ========== 统计区域 ========== */
.stats-section {
  margin: -40rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.stat-content {
  padding: 30rpx 0;
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #333333;
}

.stat-number.present {
  color: #52c41a;
}

.stat-number.absent {
  color: #ff4d4f;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 页面标题样式 ========== */
.page-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title-text {
  font-size: 40rpx;
  font-weight: bold;
}

/* ========== 信息详情行 ========== */
.detail-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  flex-wrap: nowrap;
}

.detail-row:last-child {
  margin-bottom: 0;
}

/* ========== 加载更多 ========== */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

.load-more .load-more-text {
  margin-left: 10rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #999;
}

.empty-state .empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
}

/* ========== 2.1 通用卡片 - 扁平描边风格 ========== */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card:active {
  background-color: #fafafa;
  border-color: #d0d0d0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* ========== 2.2 加载状态 ========== */
.loading-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* ========== 2.3 统计项 ========== */
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.stat-value.primary {
  color: #1890ff;
}

.stat-value.success {
  color: #52c41a;
}

.stat-value.error {
  color: #ff4d4f;
}

/* ========== 2.4 操作按钮组 ========== */
.action-buttons {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-buttons.center {
  justify-content: center;
}

.action-buttons.space-between {
  justify-content: space-between;
}

/* ========== 2.5 对话框样式 ========== */
.dialog-content {
  padding: 20rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

/* ========== 2.6 滑动操作样式 ========== */
.swipe-actions {
  display: flex;
  height: 100%;
}

.swipe-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  color: #fff;
  font-size: 28rpx;
}

.swipe-action-btn.edit {
  background-color: #1890ff;
}

.swipe-action-btn.delete {
  background-color: #ff4d4f;
}

.swipe-action-btn.warning {
  background-color: #ff9800;
}

/* ========== 2.7 徽章样式 ========== */
.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.badge.success {
  background-color: #52c41a;
}

.badge.warning {
  background-color: #ff9800;
}

.badge.info {
  background-color: #1890ff;
}
