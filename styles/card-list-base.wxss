/**
 * 卡片列表页面公共样式基类
 *
 * 使用此样式的页面：
 * - pages/admin/approval/approval.wxss
 * - pages/common/transfer/transfer.wxss
 * - pages/common/notifications/notifications.wxss
 * - pages/teacher/history/history.wxss
 *
 * 使用方式：
 * @import '../../../styles/card-list-base.wxss';
 *
 * 页面特有样式：
 * - 定义 .xxx-container 覆盖容器样式
 * - 定义 .xxx-item 覆盖卡片项样式
 */

/* ========== 页面容器 ========== */
.card-list-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ========== Tab 切换容器 ========== */
.card-list-tabs {
  background-color: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

/* ========== 列表容器 ========== */
.card-list {
  padding: 24rpx 30rpx;
}

.card-list-content {
  padding-bottom: 40rpx;
}

/* ========== 卡片项 ========== */
.card-list-item {
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s ease;
}

.card-list-item:active {
  transform: scale(0.98);
  background-color: #fafafa;
  border-color: #d0d0d0;
}

/* 状态边框变体 */
.card-list-item.approved {
  border-left: 6rpx solid #52c41a;
}

.card-list-item.rejected {
  border-left: 6rpx solid #ff4d4f;
}

.card-list-item.pending {
  border-left: 6rpx solid #1890ff;
}

.card-list-item.warning {
  border-left: 6rpx solid #ff9800;
}

.card-list-item.unread {
  background: linear-gradient(135deg, #f0f9ff 0%, #fff 100%);
  border-left: 6rpx solid #1890ff;
}

/* ========== 卡片头部 ========== */
.card-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-list-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.card-list-header-right {
  flex-shrink: 0;
}

/* ========== 卡片标题 ========== */
.card-list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card-list-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ========== 卡片内容 ========== */
.card-list-body {
  margin-bottom: 20rpx;
}

.card-list-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-list-info-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.card-list-info-row .label {
  color: #999;
  flex-shrink: 0;
  min-width: 120rpx;
}

.card-list-info-row .value {
  color: #333;
  flex: 1;
}

.card-list-info-row .value.reason {
  color: #ff4d4f;
}

/* ========== 卡片统计 ========== */
.card-list-stats {
  display: flex;
  gap: 40rpx;
}

.card-list-stat-item {
  font-size: 28rpx;
}

.card-list-stat-item .label {
  color: #999;
}

.card-list-stat-item .value {
  color: #333;
  font-weight: 500;
}

.card-list-stat-item .value.present {
  color: #52c41a;
}

.card-list-stat-item .value.absent {
  color: #ff4d4f;
}

/* ========== 卡片操作区 ========== */
.card-list-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.card-list-actions.center {
  justify-content: center;
}

/* ========== 结果信息 ========== */
.card-list-result {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 20rpx;
  flex-wrap: wrap;
}

.card-list-result.success {
  color: #52c41a;
}

.card-list-result.error {
  color: #ff4d4f;
}

.card-list-result-detail {
  width: 100%;
  margin-top: 8rpx;
  padding-top: 8rpx;
}

/* ========== 时间标签 ========== */
.card-list-time {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

/* ========== 箭头指示 ========== */
.card-list-arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #ccc;
}

/* ========== 加载状态 ========== */
.card-list-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}
