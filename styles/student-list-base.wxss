/**
 * 学生列表页面公共样式基类
 *
 * 使用此样式的页面：
 * - pages/teacher/club/club.wxss
 * - pages/classTeacher/students/students.wxss
 *
 * 使用方式：
 * @import '../../../styles/student-list-base.wxss';
 */

/* ========== 页面容器 ========== */
.student-list-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ========== 头部信息卡片 ========== */
.list-header {
  padding: 40rpx 32rpx;
  color: #fff;
}

.header-info {
  margin-bottom: 32rpx;
}

.header-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  opacity: 0.9;
}

.header-meta-item {
  font-size: 28rpx;
}

/* 统计数据 */
.header-stats {
  display: flex;
  gap: 48rpx;
}

.header-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.header-stat-value {
  font-size: 48rpx;
  font-weight: 700;
}

.header-stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.header-stat-item.warning {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
}

/* ========== 分布统计标签 ========== */
.distribution-section {
  background-color: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.distribution-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.distribution-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.distribution-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.distribution-tag:active {
  background-color: #e6f7ff;
  transform: scale(0.95);
}

.distribution-tag.active {
  background-color: #e6f7ff;
  border: 2rpx solid #1890ff;
}

.distribution-tag-name {
  font-size: 26rpx;
  color: #666;
}

.distribution-tag-count {
  font-size: 22rpx;
  color: #1890ff;
  font-weight: 500;
}

/* ========== Tab 切换 ========== */
.student-list-tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.student-list-tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.student-list-tab-item.active {
  color: #1890ff;
  font-weight: 600;
}

.student-list-tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #1890ff;
  border-radius: 3rpx;
}

/* ========== 搜索框 ========== */
.student-list-search {
  background-color: #fff;
  margin-bottom: 20rpx;
}

/* ========== 学生列表容器 ========== */
.student-list-content {
  margin-top: 20rpx;
}

/* 虚拟列表滚动容器 */
.student-list-scroll {
  width: 100%;
}

.student-list-wrapper {
  padding: 0 30rpx;
}

/* ========== 学生卡片 ========== */
.student-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s ease;
}

.student-card:active {
  transform: scale(0.98);
  background-color: #fafafa;
  border-color: #d0d0d0;
}

.student-card-avatar {
  flex-shrink: 0;
}

.student-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.student-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.student-card-name-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.student-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.student-card-meta {
  display: flex;
  gap: 32rpx;
}

.student-card-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666;
}

/* ========== 排行榜 ========== */
.student-rank-list {
  padding: 0 32rpx;
}

.student-rank-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s ease;
}

.student-rank-item:active {
  transform: scale(0.98);
  background-color: #fafafa;
  border-color: #d0d0d0;
}

.student-rank-item.top-rank {
  background: linear-gradient(135deg, #fff9e6 0%, #fff 100%);
  border: 2rpx solid #ffd700;
}

.student-rank-badge {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.student-rank-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #999;
}

.student-rank-number.first {
  color: #ffd700;
}

.student-rank-number.second {
  color: #c0c0c0;
}

.student-rank-number.third {
  color: #cd7f32;
}

.student-rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.student-rank-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.student-rank-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.student-rank-class {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.student-rank-stats {
  font-size: 24rpx;
  color: #999;
}

.student-rank-rate {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.student-rank-rate.excellent {
  background-color: #f0f9ff;
  color: #1890ff;
}

.student-rank-rate.good {
  background-color: #f0fdf4;
  color: #52c41a;
}

.student-rank-rate.normal {
  background-color: #fffbeb;
  color: #ff9800;
}

.student-rank-rate.poor {
  background-color: #fef2f2;
  color: #ff4d4f;
}

.student-rank-rate-value {
  font-size: 32rpx;
}

/* ========== 加载状态 ========== */
.student-list-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}
