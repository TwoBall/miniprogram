/* ========================================
   实用工具类 - Utility Classes
   ======================================== */

/* 文本颜色 */
.text-primary { color: #1a365d; }
.text-accent { color: #ed8936; }
.text-success { color: #38a169; }
.text-warning { color: #dd6b20; }
.text-error { color: #c53030; }
.text-info { color: #2b6cb0; }
.text-gray-900 { color: #1a202c; }
.text-gray-800 { color: #2d3748; }
.text-gray-700 { color: #4a5568; }
.text-gray-600 { color: #718096; }
.text-gray-500 { color: #a0aec0; }

/* 背景颜色 */
.bg-page { background-color: #fefcf6; }
.bg-card { background-color: #ffffff; }
.bg-section { background-color: #f7fafc; }
.bg-primary { background-color: #1a365d; }
.bg-accent { background-color: #ed8936; }
.bg-success { background-color: #c6f6d5; }
.bg-warning { background-color: #feebc8; }
.bg-error { background-color: #fed7d7; }
.bg-info { background-color: #bee3f8; }

/* 字号 */
.text-hero { font-size: 72rpx; }
.text-h1 { font-size: 40rpx; }
.text-h2 { font-size: 36rpx; }
.text-h3 { font-size: 32rpx; }
.text-h4 { font-size: 30rpx; }
.text-body { font-size: 28rpx; }
.text-small { font-size: 26rpx; }
.text-caption { font-size: 24rpx; }
.text-mini { font-size: 22rpx; }

/* 字重 */
.font-bold { font-weight: 800; }
.font-semibold { font-weight: 600; }
.font-medium { font-weight: 500; }
.font-normal { font-weight: 400; }

/* 圆角 */
.rounded-sm { border-radius: 6rpx; }
.rounded-md { border-radius: 12rpx; }
.rounded-lg { border-radius: 16rpx; }
.rounded-full { border-radius: 9999rpx; }
