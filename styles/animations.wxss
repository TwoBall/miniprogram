/**
 * 动画样式库
 * 提供全局可复用的动画效果
 *
 * 使用方式：
 * 1. 在 app.wxss 中引入: @import './styles/animations.wxss';
 * 2. 在元素上添加对应的类名
 *
 * 类别：
 * - 入场动画：fadeIn, slideIn, popIn, listItemEnter
 * - 交互反馈：btnActive, cardTap, ripple
 * - 加载动画：pulse, spin, shimmer
 * - 过渡效果：transition-all, transition-opacity, transition-transform
 */

/* ========== 基础过渡 ========== */
.transition-all {
  transition: all 0.3s ease;
}

.transition-opacity {
  transition: opacity 0.3s ease;
}

.transition-transform {
  transition: transform 0.3s ease;
}

.transition-fast {
  transition: all 0.15s ease;
}

.transition-slow {
  transition: all 0.5s ease;
}

/* ========== 淡入动画 ========== */
.fade-in {
  animation: fadeIn 0.3s ease-out;
}

.fade-in-up {
  animation: fadeInUp 0.3s ease-out;
}

.fade-in-down {
  animation: fadeInDown 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 滑入动画 ========== */
.slide-in-left {
  animation: slideInLeft 0.3s ease-out;
}

.slide-in-right {
  animation: slideInRight 0.3s ease-out;
}

.slide-in-bottom {
  animation: slideInBottom 0.3s ease-out;
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(40rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInBottom {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 弹出动画 ========== */
.pop-in {
  animation: popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.card-pop-in {
  animation: cardPopIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes popIn {
  0% {
    opacity: 0;
    transform: scale(0.8);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes cardPopIn {
  0% {
    opacity: 0;
    transform: scale(0.9) translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* ========== 列表项入场动画 ========== */
.list-item-enter {
  animation: listItemEnter 0.3s ease-out backwards;
}

/* 使用 CSS 变量实现交错动画 */
.list-item-enter:nth-child(1) { animation-delay: 0.05s; }
.list-item-enter:nth-child(2) { animation-delay: 0.1s; }
.list-item-enter:nth-child(3) { animation-delay: 0.15s; }
.list-item-enter:nth-child(4) { animation-delay: 0.2s; }
.list-item-enter:nth-child(5) { animation-delay: 0.25s; }
.list-item-enter:nth-child(6) { animation-delay: 0.3s; }
.list-item-enter:nth-child(7) { animation-delay: 0.35s; }
.list-item-enter:nth-child(8) { animation-delay: 0.4s; }
.list-item-enter:nth-child(9) { animation-delay: 0.45s; }
.list-item-enter:nth-child(10) { animation-delay: 0.5s; }

@keyframes listItemEnter {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 卡片列表入场 */
.card-list-enter {
  animation: cardListEnter 0.35s ease-out backwards;
}

.card-list-enter:nth-child(1) { animation-delay: 0.05s; }
.card-list-enter:nth-child(2) { animation-delay: 0.12s; }
.card-list-enter:nth-child(3) { animation-delay: 0.19s; }
.card-list-enter:nth-child(4) { animation-delay: 0.26s; }
.card-list-enter:nth-child(5) { animation-delay: 0.33s; }

@keyframes cardListEnter {
  from {
    opacity: 0;
    transform: translateY(30rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ========== 交互反馈动画 ========== */

/* 按钮点击效果 */
.btn-active {
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.btn-active:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 卡片点击效果 */
.card-tap {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-tap:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 列表项点击效果 */
.list-item-tap {
  transition: background-color 0.15s ease;
}

.list-item-tap:active {
  background-color: #f5f5f5;
}

/* 图标点击效果 */
.icon-tap {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.icon-tap:active {
  transform: scale(0.85);
  opacity: 0.7;
}

/* ========== 加载动画 ========== */

/* 脉冲效果 */
.pulse {
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* 旋转加载 */
.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 闪烁效果 */
.shimmer {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* 弹跳加载点 */
.bounce-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.bounce-loading .dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #1989fa;
  border-radius: 50%;
  animation: bounce 0.6s ease-in-out infinite;
}

.bounce-loading .dot:nth-child(2) {
  animation-delay: 0.1s;
}

.bounce-loading .dot:nth-child(3) {
  animation-delay: 0.2s;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

/* ========== 状态切换动画 ========== */

/* 展开/收起 */
.expand-enter {
  animation: expandEnter 0.3s ease-out;
  overflow: hidden;
}

.expand-leave {
  animation: expandLeave 0.3s ease-out forwards;
  overflow: hidden;
}

@keyframes expandEnter {
  from {
    max-height: 0;
    opacity: 0;
  }
  to {
    max-height: 1000rpx;
    opacity: 1;
  }
}

@keyframes expandLeave {
  from {
    max-height: 1000rpx;
    opacity: 1;
  }
  to {
    max-height: 0;
    opacity: 0;
  }
}

/* 翻转效果 */
.flip {
  animation: flip 0.4s ease-in-out;
}

@keyframes flip {
  0% {
    transform: perspective(400px) rotateY(0);
  }
  100% {
    transform: perspective(400px) rotateY(180deg);
  }
}

/* ========== 提示动画 ========== */

/* 摇晃提示 */
.shake {
  animation: shake 0.5s ease-in-out;
}

@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  10%, 30%, 50%, 70%, 90% {
    transform: translateX(-8rpx);
  }
  20%, 40%, 60%, 80% {
    transform: translateX(8rpx);
  }
}

/* 心跳效果 */
.heartbeat {
  animation: heartbeat 1.5s ease-in-out infinite;
}

@keyframes heartbeat {
  0%, 100% {
    transform: scale(1);
  }
  14% {
    transform: scale(1.1);
  }
  28% {
    transform: scale(1);
  }
  42% {
    transform: scale(1.1);
  }
  70% {
    transform: scale(1);
  }
}

/* ========== 数字变化动画 ========== */
.number-change {
  animation: numberChange 0.3s ease-out;
}

@keyframes numberChange {
  0% {
    transform: scale(1.2);
    color: #1989fa;
  }
  100% {
    transform: scale(1);
  }
}

/* ========== 成功/失败动画 ========== */
.success-bounce {
  animation: successBounce 0.5s ease-out;
}

@keyframes successBounce {
  0% {
    transform: scale(0);
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}

.error-shake {
  animation: errorShake 0.4s ease-in-out;
}

@keyframes errorShake {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-10rpx);
  }
  75% {
    transform: translateX(10rpx);
  }
}