/* 骨架屏组件样式 - 教育杂志风配色 */
.skeleton-container {
  padding: 20rpx;
}

/* 动画效果 - 使用教育杂志风配色 */
.skeleton-animate .skeleton-avatar,
.skeleton-animate .skeleton-title,
.skeleton-animate .skeleton-subtitle,
.skeleton-animate .skeleton-row,
.skeleton-animate .skeleton-action,
.skeleton-animate .skeleton-stat-value,
.skeleton-animate .skeleton-stat-label,
.skeleton-animate .skeleton-avatar-large,
.skeleton-animate .skeleton-name,
.skeleton-animate .skeleton-tag,
.skeleton-animate .skeleton-info-row,
.skeleton-animate .skeleton-date,
.skeleton-animate .skeleton-time,
.skeleton-animate .skeleton-stat-inline {
  background: linear-gradient(90deg, #edf2f7 25%, #e2e8f0 50%, #edf2f7 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* 基础占位元素 - 教育杂志风配色 */
.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  background-color: #edf2f7;
  flex-shrink: 0;
}

.skeleton-avatar.round {
  border-radius: 50%;
}

.skeleton-avatar.square {
  border-radius: 12rpx;
}

.skeleton-title {
  height: 32rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  width: 60%;
}

.skeleton-subtitle {
  height: 24rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  width: 40%;
  margin-top: 12rpx;
}

.skeleton-row {
  height: 24rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  margin-top: 16rpx;
}

/* 卡片骨架 - 教育杂志风 */
.skeleton-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04);
}

.skeleton-card-header {
  display: flex;
  align-items: center;
}

.skeleton-header-content {
  flex: 1;
  margin-left: 20rpx;
}

.skeleton-card-body {
  margin-top: 20rpx;
}

/* 列表骨架 - 教育杂志风 */
.skeleton-list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #edf2f7;
}

.skeleton-list-content {
  flex: 1;
  margin-left: 20rpx;
}

.skeleton-action {
  width: 80rpx;
  height: 48rpx;
  background-color: #edf2f7;
  border-radius: 8rpx;
}

/* 统计骨架 - 教育杂志风 */
.skeleton-stats-grid {
  display: flex;
  flex-wrap: wrap;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04);
}

.skeleton-stat-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.skeleton-stat-value {
  width: 60rpx;
  height: 48rpx;
  background-color: #edf2f7;
  border-radius: 8rpx;
}

.skeleton-stat-label {
  width: 80rpx;
  height: 24rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  margin-top: 12rpx;
}

/* 点名卡片骨架 - 教育杂志风 */
.skeleton-attendance-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(26, 54, 93, 0.08);
  margin: 40rpx 30rpx;
}

.skeleton-avatar-large {
  width: 160rpx;
  height: 160rpx;
  background-color: #edf2f7;
}

.skeleton-avatar-large.round {
  border-radius: 50%;
}

.skeleton-name {
  width: 150rpx;
  height: 40rpx;
  background-color: #edf2f7;
  border-radius: 8rpx;
  margin-top: 30rpx;
}

.skeleton-tag {
  width: 80rpx;
  height: 36rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  margin-top: 20rpx;
}

.skeleton-info-rows {
  width: 100%;
  margin-top: 40rpx;
}

.skeleton-info-row {
  width: 70%;
  height: 28rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  margin: 16rpx auto;
}

/* 历史记录卡片骨架 - 教育杂志风 */
.skeleton-history-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04);
}

.skeleton-history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.skeleton-date {
  width: 180rpx;
  height: 32rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
}

.skeleton-time {
  width: 100rpx;
  height: 28rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
}

.skeleton-history-stats {
  display: flex;
  gap: 40rpx;
}

.skeleton-stat-inline {
  width: 120rpx;
  height: 28rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
}

/* ========== 概览页骨架 - 教育杂志风 ========== */
.skeleton-overview {
  padding: 0;
}

.skeleton-overview-stats {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04);
}

.skeleton-overview-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.skeleton-stat-value-lg {
  width: 80rpx;
  height: 56rpx;
  background-color: #edf2f7;
  border-radius: 8rpx;
}

.skeleton-chart-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04);
}

.skeleton-chart-title {
  width: 120rpx;
  height: 32rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  margin-bottom: 20rpx;
}

.skeleton-chart-area {
  width: 100%;
  height: 300rpx;
  background-color: #edf2f7;
  border-radius: 8rpx;
}

.skeleton-section-title {
  width: 150rpx;
  height: 36rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  margin: 24rpx 0 16rpx 0;
}

.skeleton-warning-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04);
}

.skeleton-warning-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.skeleton-warning-item:last-child {
  border-bottom: none;
}

.skeleton-warning-content {
  flex: 1;
  margin-left: 20rpx;
}

.skeleton-warning-badge {
  width: 48rpx;
  height: 48rpx;
  background-color: #edf2f7;
  border-radius: 50%;
}

/* ========== 审批卡片骨架 - 教育杂志风 ========== */
.skeleton-approval-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04);
}

.skeleton-approval-header {
  display: flex;
  align-items: center;
}

.skeleton-approval-info {
  flex: 1;
  margin-left: 20rpx;
}

.skeleton-approval-status {
  width: 80rpx;
  height: 40rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
}

.skeleton-approval-body {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf2f7;
}

.skeleton-approval-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf2f7;
}

.skeleton-btn {
  width: 140rpx;
  height: 64rpx;
  background-color: #edf2f7;
  border-radius: 8rpx;
}

/* ========== 表单骨架 - 教育杂志风 ========== */
.skeleton-form {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.04);
}

.skeleton-form-item {
  margin-bottom: 32rpx;
}

.skeleton-form-label {
  width: 120rpx;
  height: 28rpx;
  background-color: #edf2f7;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}

.skeleton-form-input {
  width: 100%;
  height: 80rpx;
  background-color: #edf2f7;
  border-radius: 8rpx;
}

.skeleton-form-btn {
  width: 100%;
  height: 88rpx;
  background-color: #edf2f7;
  border-radius: 12rpx;
  margin-top: 48rpx;
}

/* 动画效果扩展 - 教育杂志风配色 */
.skeleton-animate .skeleton-stat-value-lg,
.skeleton-animate .skeleton-chart-title,
.skeleton-animate .skeleton-chart-area,
.skeleton-animate .skeleton-section-title,
.skeleton-animate .skeleton-warning-badge,
.skeleton-animate .skeleton-approval-status,
.skeleton-animate .skeleton-btn,
.skeleton-animate .skeleton-form-label,
.skeleton-animate .skeleton-form-input,
.skeleton-animate .skeleton-form-btn {
  background: linear-gradient(90deg, #edf2f7 25%, #e2e8f0 50%, #edf2f7 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}
