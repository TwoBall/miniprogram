<!-- 自定义底部导航栏 - Editorial 风格 -->
<van-tabbar
  active="{{ active }}"
  bind:change="onChange"
  fixed="{{ true }}"
  placeholder="{{ true }}"
  border="{{ false }}"
  active-color="{{ activeColor }}"
  inactive-color="#718096"
  custom-class="ed-tabbar ed-tabbar-{{ role }}"
>
  <van-tabbar-item
    wx:for="{{ tabs[role] }}"
    wx:key="text"
    icon="{{ item.icon }}"
  >
    {{ item.text }}
  </van-tabbar-item>
</van-tabbar>
