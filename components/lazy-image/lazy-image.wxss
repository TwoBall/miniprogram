/* 懒加载图片组件样式 */
.lazy-image-wrapper {
  position: relative;
  display: inline-block;
  overflow: hidden;
  background-color: #f5f5f5;
}

.lazy-image-wrapper.round {
  border-radius: 50%;
}

.lazy-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 占位图 */
.lazy-image.placeholder {
  opacity: 0.6;
}

/* 隐藏状态 */
.lazy-image.hidden-opacity {
  opacity: 0;
  transition: opacity 0.3s ease-out;
}

/* 显示状态 */
.lazy-image.visible-opacity {
  opacity: 1;
  transition: opacity 0.3s ease-out;
}

/* 加载中指示器 */
.loading-indicator {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e0e0e0;
  border-top-color: #1989fa;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 错误指示器 */
.error-indicator {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 48rpx;
  background-color: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-icon {
  font-size: 28rpx;
  color: #999;
  font-weight: bold;
}