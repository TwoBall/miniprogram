<view
  class="lazy-image-wrapper {{round ? 'round' : ''}}"
  style="width: {{width}}; height: {{height}};"
  bind:tap="onClick"
>
  <!-- 占位图（加载前显示） -->
  <image
    class="lazy-image placeholder {{status === 'loaded' ? 'hidden-opacity' : ''}}"
    src="{{placeholder}}"
    mode="{{mode}}"
  />

  <!-- 加载中动画 -->
  <view wx:if="{{status === 'loading' && showLoading}}" class="loading-indicator">
    <view class="loading-spinner"></view>
  </view>

  <!-- 实际图片 -->
  <image
    wx:if="{{currentSrc}}"
    class="lazy-image main-image {{status === 'loaded' ? 'visible-opacity' : 'hidden-opacity'}}"
    src="{{currentSrc}}"
    mode="{{mode}}"
    bind:load="onLoad"
    bind:error="onError"
  />

  <!-- 错误状态（仅当没有 errorImage 时显示图标） -->
  <view wx:if="{{status === 'error' && !errorImage}}" class="error-indicator">
    <text class="error-icon">!</text>
  </view>
</view>