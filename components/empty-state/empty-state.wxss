/* 空状态组件样式 - 教育杂志风 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-state-image {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  background: #f7fafc;
  border-radius: 50%;
  margin-bottom: 32rpx;
}

.empty-state-image .custom-image {
  width: 100%;
  height: 100%;
}

.empty-state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4a5568;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.empty-state-description {
  font-size: 26rpx;
  color: #a0aec0;
  line-height: 1.5;
  max-width: 80%;
}

.empty-state-action {
  margin-top: 32rpx;
}

/* 动画效果 */
.empty-state-image {
  animation: emptyBounce 0.5s ease-out;
}

@keyframes emptyBounce {
  0% {
    opacity: 0;
    transform: scale(0.8);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.empty-state-title,
.empty-state-description {
  animation: emptyFadeIn 0.4s ease-out 0.1s both;
}

.empty-state-action {
  animation: emptyFadeIn 0.4s ease-out 0.2s both;
}

@keyframes emptyFadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
