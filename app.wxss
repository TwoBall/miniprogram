/* 引入公共样式 */
@import './styles/common.wxss';
/* 引入动画样式库 */
@import './styles/animations.wxss';

/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

/* 修复 style:v2 导致 Vant Dialog 按钮不对齐的问题 */
button {
  width: auto !important;
  min-width: auto !important;
  text-align: center !important;
}

/* ========== Vant 组件全局样式覆盖 ========== */

/* Button - 统一小按钮样式 */
.van-button--small {
  min-width: 120rpx !important;
  padding: 0 24rpx !important;
  font-size: 26rpx !important;
  height: 60rpx !important;
  line-height: 58rpx !important;
}

/* Dialog - 统一弹窗按钮样式，增大点击区域 */
.van-dialog__footer {
  display: flex !important;
  min-height: 100rpx !important;
}

.van-dialog__button {
  flex: 1 !important;
  height: 100rpx !important;
  min-height: 100rpx !important;
  line-height: 100rpx !important;
  text-align: center !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* 确保按钮内部元素也有足够的点击区域 */
.van-dialog__button--bold,
.van-dialog__button .van-button {
  width: 100% !important;
  height: 100% !important;
  min-height: 100rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.van-dialog__cancel,
.van-dialog__confirm {
  font-size: 32rpx !important;
  width: 100% !important;
  height: 100% !important;
  min-height: 100rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.van-dialog__cancel {
  color: #333 !important;
}

.van-dialog__confirm {
  color: #1F6FAD !important;
}
