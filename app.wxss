/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

/* 修复 style:v2 导致 Vant Dialog 按钮不对齐的问题 */
button {
  width: auto !important;
  min-width: auto !important;
  text-align: center !important;
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 按钮样式 */
.btn-primary {
  background-color: #1890ff;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-success {
  background-color: #52c41a;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-danger {
  background-color: #ff4d4f;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}

/* 文本样式 */
.text-primary {
  color: #1890ff;
}

.text-success {
  color: #52c41a;
}

.text-danger {
  color: #ff4d4f;
}

.text-gray {
  color: #999999;
}

/* 布局 */
.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* ========== Vant 组件全局样式覆盖 ========== */

/* Button - 统一小按钮样式 */
.van-button--small {
  min-width: 120rpx !important;
  padding: 0 24rpx !important;
  font-size: 26rpx !important;
  height: 60rpx !important;
  line-height: 58rpx !important;
}

/* Dialog - 统一弹窗按钮样式 */
.van-dialog__footer {
  display: flex !important;
}

.van-dialog__button {
  flex: 1 !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  text-align: center !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.van-dialog__cancel,
.van-dialog__confirm {
  font-size: 32rpx !important;
}

.van-dialog__cancel {
  color: #333 !important;
}

.van-dialog__confirm {
  color: #1890ff !important;
}
