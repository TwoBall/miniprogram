<!-- 注册页 - 教育杂志风 -->
<view class="ed-page ed-register-page">
  <!-- Hero 头部 -->
  <view class="ed-hero ed-hero-register fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="user-o" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>账号注册</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">智慧社团</text>
      </view>
      <view class="ed-hero-subtitle">
        <text>填写信息申请加入系统</text>
      </view>
    </view>
  </view>

  <!-- 注册表单 -->
  <view class="ed-form-section card-pop-in">
    <!-- 基本信息 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">01</text>
          <text class="ed-section-text">基本信息</text>
        </view>
      </view>

      <view class="ed-form-card">
        <view class="ed-form-item">
          <view class="ed-form-label">
            <text class="ed-label-required">*</text>
            <text>姓名</text>
          </view>
          <view class="ed-form-input">
            <van-icon name="user-o" size="28rpx" color="#718096" />
            <input
              class="ed-input"
              value="{{ name }}"
              placeholder="请输入姓名"
              bindinput="onNameInput"
            />
          </view>
        </view>
      </view>
    </view>

    <!-- 角色信息 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">02</text>
          <text class="ed-section-text">角色信息</text>
        </view>
      </view>

      <view class="ed-form-card">
        <!-- 角色选择 -->
        <view class="ed-form-item" bindtap="showRolePickerPopup">
          <view class="ed-form-label">
            <text class="ed-label-required">*</text>
            <text>角色</text>
          </view>
          <view class="ed-form-value">
            <text class="{{ roleArray[roleIndex] ? '' : 'placeholder' }}">{{ roleArray[roleIndex] || '请选择角色' }}</text>
            <van-icon name="arrow" size="24rpx" color="#a0aec0" />
          </view>
        </view>

        <!-- 社团名称（教师） -->
        <view
          wx:if="{{ roleValues[roleIndex] === 'teacher' }}"
          class="ed-form-item"
          bindtap="showClubPickerPopup"
        >
          <view class="ed-form-label">
            <text class="ed-label-required">*</text>
            <text>社团名称</text>
          </view>
          <view class="ed-form-value">
            <text class="{{ clubName ? '' : 'placeholder' }}">{{ clubName || '请选择社团' }}</text>
            <van-icon name="arrow" size="24rpx" color="#a0aec0" />
          </view>
        </view>

        <!-- 班主任：先选学部，再选班级 -->
        <view
          wx:if="{{ roleValues[roleIndex] === 'classTeacher' }}"
          class="ed-form-item"
          bindtap="showClassTeacherDeptPickerPopup"
        >
          <view class="ed-form-label">
            <text class="ed-label-required">*</text>
            <text>学部</text>
          </view>
          <view class="ed-form-value">
            <text class="{{ classTeacherDept ? '' : 'placeholder' }}">{{ classTeacherDept || '请先选择学部' }}</text>
            <van-icon name="arrow" size="24rpx" color="#a0aec0" />
          </view>
        </view>
        <view
          wx:if="{{ roleValues[roleIndex] === 'classTeacher' }}"
          class="ed-form-item {{ !classTeacherDept ? 'disabled' : '' }}"
          bindtap="showClassPickerPopup"
        >
          <view class="ed-form-label">
            <text class="ed-label-required">*</text>
            <text>班级</text>
          </view>
          <view class="ed-form-value">
            <text class="{{ className ? '' : 'placeholder' }}">{{ className || (classTeacherDept ? '请选择班级' : '请先选择学部') }}</text>
            <van-icon name="arrow" size="24rpx" color="#a0aec0" />
          </view>
        </view>

        <!-- 领导：选择学部 -->
        <view
          wx:if="{{ roleValues[roleIndex] === 'leader' }}"
          class="ed-form-item"
          bindtap="showDeptPickerPopup"
        >
          <view class="ed-form-label">
            <text class="ed-label-required">*</text>
            <text>学部</text>
          </view>
          <view class="ed-form-value">
            <text class="{{ department ? '' : 'placeholder' }}">{{ department || '请选择学部' }}</text>
            <van-icon name="arrow" size="24rpx" color="#a0aec0" />
          </view>
        </view>
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="ed-tips-card">
      <view class="ed-tips-icon">
        <van-icon name="info-o" size="32rpx" color="#ed8936" />
      </view>
      <text class="ed-tips-text">提交后需要等待管理员审核通过才能使用</text>
    </view>

    <!-- 提交按钮 -->
    <view class="ed-submit-section">
      <van-button
        type="primary"
        block
        round
        loading="{{ loading }}"
        disabled="{{ loading }}"
        loading-text="提交中..."
        bind:click="handleRegister"
        custom-class="ed-btn-primary btn-active"
      >
        提交注册申请
      </van-button>
    </view>
  </view>

  <!-- 角色选择 -->
  <van-popup show="{{ showRolePicker }}" position="bottom" bind:close="onRolePickerClose">
    <van-picker
      show-toolbar
      title="选择角色"
      columns="{{ roleArray }}"
      default-index="{{ roleIndex }}"
      bind:confirm="onRolePickerConfirm"
      bind:cancel="onRolePickerClose"
    />
  </van-popup>

  <!-- 学部选择 -->
  <van-popup show="{{ showDeptPicker }}" position="bottom" bind:close="onDeptPickerClose">
    <van-picker
      show-toolbar
      title="选择学部"
      columns="{{ departments }}"
      bind:confirm="onDeptPickerConfirm"
      bind:cancel="onDeptPickerClose"
    />
  </van-popup>

  <!-- 班主任学部选择（级联） -->
  <van-popup show="{{ showClassTeacherDeptPicker }}" position="bottom" bind:close="onClassTeacherDeptPickerClose">
    <van-picker
      show-toolbar
      title="选择学部"
      columns="{{ allDepartments }}"
      bind:confirm="onClassTeacherDeptPickerConfirm"
      bind:cancel="onClassTeacherDeptPickerClose"
    />
  </van-popup>

  <!-- 班级选择 -->
  <van-popup show="{{ showClassPicker }}" position="bottom" bind:close="onClassPickerClose">
    <van-picker
      show-toolbar
      title="选择班级"
      columns="{{ filteredClasses.length > 0 ? filteredClasses : classes }}"
      bind:confirm="onClassPickerConfirm"
      bind:cancel="onClassPickerClose"
    />
  </van-popup>

  <!-- 社团选择 -->
  <van-popup show="{{ showClubPicker }}" position="bottom" bind:close="onClubPickerClose">
    <van-picker
      show-toolbar
      title="选择社团"
      columns="{{ clubs }}"
      bind:confirm="onClubPickerConfirm"
      bind:cancel="onClubPickerClose"
    />
  </van-popup>

  <van-toast id="van-toast" />
</view>
