.register-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1F6FAD 0%, #2E8B9A 100%);
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.form-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #1F6FAD;
}

.tips-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  margin-top: 30rpx;
  background-color: #fff7e6;
  border-radius: 12rpx;
  border: 1rpx solid #ffd591;
}

.tips-text {
  flex: 1;
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.6;
}

.button-group {
  margin-top: 40rpx;
}
