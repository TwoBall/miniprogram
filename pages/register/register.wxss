/* 注册页样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-register-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: 60rpx;
}

/* ========== Hero 头部 ========== */
/* 使用全局 ed-hero 标准高度: padding: 40rpx 32rpx 56rpx */

.ed-hero-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
}

/* ========== 表单区域 ========== */
.ed-form-section {
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  padding: 32rpx;
  position: relative;
  z-index: 10;
}

/* ========== 区域容器 ========== */
.ed-section {
  margin-bottom: 32rpx;
}

.ed-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ed-section-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ed-section-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-accent, #ed8936);
  font-family: 'Georgia', serif;
}

.ed-section-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gray-800, #2d3748);
  letter-spacing: 1rpx;
}

/* ========== 表单卡片 ========== */
.ed-form-card {
  background: var(--gray-50, #f7fafc);
  border-radius: 16rpx;
  overflow: hidden;
}

.ed-form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--gray-100, #f7fafc);
}

.ed-form-item:last-child {
  border-bottom: none;
}

.ed-form-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.ed-form-label {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  color: var(--gray-700, #4a5568);
  font-weight: 500;
  min-width: 140rpx;
}

.ed-label-required {
  color: var(--color-error, #c53030);
  font-weight: 600;
}

.ed-form-input {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: var(--gray-50, #f7fafc);
  border-radius: 12rpx;
  margin-left: 24rpx;
}

.ed-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--gray-800, #2d3748);
}

.ed-input::placeholder {
  color: var(--gray-400, #a0aec0);
}

.ed-form-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--gray-800, #2d3748);
}

.ed-form-value .placeholder {
  color: var(--gray-400, #a0aec0);
}

/* ========== 提示卡片 ========== */
.ed-tips-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: rgba(237, 137, 54, 0.08);
  border-radius: 16rpx;
  border-left: 6rpx solid var(--color-accent, #ed8936);
  margin-bottom: 32rpx;
}

.ed-tips-icon {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(237, 137, 54, 0.15);
  border-radius: 50%;
}

.ed-tips-text {
  flex: 1;
  font-size: 26rpx;
  color: #c05621;
  line-height: 1.6;
}

/* ========== 提交按钮 ========== */
.ed-submit-section {
  margin-top: 16rpx;
}

.ed-btn-primary {
  background: linear-gradient(135deg, #1a365d 0%, #2c5282 100%) !important;
  border: none !important;
}
