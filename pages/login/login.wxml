<!-- 登录页 - 教育杂志风 -->
<view class="ed-login-page">
  <!-- 背景装饰 -->
  <view class="ed-login-bg">
    <view class="ed-login-circle ed-circle-1"></view>
    <view class="ed-login-circle ed-circle-2"></view>
    <view class="ed-login-circle ed-circle-3"></view>
  </view>

  <!-- 品牌区域 -->
  <view class="ed-login-brand">
    <view class="ed-login-logo-wrap">
      <image class="ed-login-logo" src="/images/logo.png" mode="aspectFit"></image>
    </view>
    <view class="ed-login-title">
      <text class="ed-title-line">智慧</text>
      <text class="ed-title-line ed-title-accent">社团</text>
    </view>
    <view class="ed-login-divider"></view>
    <text class="ed-login-subtitle">Smart Club Management System</text>
  </view>

  <!-- 内部使用说明 -->
  <view class="ed-login-notice">
    <view class="ed-notice-badge">
      <van-icon name="warning-o" size="32rpx" color="#ed8936" />
      <text>内部系统</text>
    </view>
    <text class="ed-notice-text">本系统仅限学校内部教职工使用</text>
    <text class="ed-notice-desc">登录后需管理员审核批准方可使用</text>
  </view>

  <!-- 登录按钮区域 -->
  <view class="ed-login-action">
    <view class="ed-login-card">
      <view class="ed-login-card-inner">
        <van-button
          type="primary"
          block
          size="large"
          loading="{{ loading }}"
          loading-text="登录中..."
          bind:click="handleWxLogin"
          custom-class="ed-login-btn btn-active"
        >
          <view class="ed-btn-content">
            <van-icon name="wechat" size="40rpx" />
            <text>微信一键登录</text>
          </view>
        </van-button>
      </view>
    </view>
  </view>

  <!-- 提示区域 -->
  <view class="ed-login-tips">
    <view class="ed-tips-item">
      <van-icon name="passed" size="28rpx" color="#38a169" />
      <text>首次登录需提交注册信息</text>
    </view>
    <view class="ed-tips-item">
      <van-icon name="info-o" size="28rpx" color="#a0aec0" />
      <text>管理员审核通过后方可正常使用</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="ed-login-footer">
    <text class="ed-footer-text">安全 · 高效 · 智能</text>
  </view>

  <van-toast id="van-toast" />
</view>
