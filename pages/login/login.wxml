<view class="login-container">
  <view class="logo-section">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="title">智慧社团管理系统</text>
    <text class="subtitle">Smart Club Management System</text>
  </view>

  <view class="welcome-section">
    <text class="welcome-text">欢迎使用智慧社团管理系统</text>
    <text class="welcome-desc">请使用微信授权登录</text>
  </view>

  <view class="button-section">
    <van-button
      type="primary"
      block
      round
      size="large"
      loading="{{ loading }}"
      loading-text="登录中..."
      bind:click="handleWxLogin"
      icon="wechat"
      custom-class="btn-active"
    >
      微信一键登录
    </van-button>
  </view>

  <view class="tips-section">
    <van-icon name="info-o" size="32rpx" color="#999" />
    <text class="tips-text">首次使用需要完成注册信息</text>
  </view>

  <van-toast id="van-toast" />
</view>
