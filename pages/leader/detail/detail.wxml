<!-- 领导班级详情页 - 教育杂志风 -->
<view class="ed-page ed-detail-page">
  <!-- Hero 头部 -->
  <view class="ed-hero ed-hero-leader fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="home-o" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>班级详情</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">{{ className }}</text>
      </view>
      <view class="ed-hero-meta">
        <van-icon name="clock-o" size="24rpx" color="rgba(255,255,255,0.9)" />
        <text>{{ date }}</text>
      </view>
    </view>
  </view>

  <!-- 学生列表 -->
  <view class="ed-student-list">
    <block wx:if="{{ students.length > 0 }}">
      <view
        wx:for="{{ students }}"
        wx:key="_id"
        class="ed-student-card card-pop-in"
      >
        <!-- 左侧状态指示条 -->
        <view class="ed-card-indicator {{ item.todayStatus === 'present' ? 'success' : item.todayStatus === 'absent' ? 'error' : 'pending' }}"></view>

        <view class="ed-card-body">
          <!-- 头部：学生姓名 + 状态 -->
          <view class="ed-student-header">
            <view class="ed-student-name">
              <text>{{ item.studentName }}</text>
              <view wx:if="{{ item.gender }}" class="ed-gender-tag {{ item.gender === '男' ? 'male' : 'female' }}">
                {{ item.gender }}
              </view>
            </view>
            <view class="ed-status-badge {{ item.todayStatus === 'present' ? 'success' : item.todayStatus === 'absent' ? 'error' : 'pending' }}">
              {{ item.todayStatus === 'present' ? '到课' : item.todayStatus === 'absent' ? '缺课' : '未点名' }}
            </view>
          </view>

          <!-- 详情信息 -->
          <view class="ed-student-info">
            <view class="ed-info-row">
              <van-icon name="cluster-o" size="24rpx" color="#718096" />
              <text class="ed-info-label">社团</text>
              <text class="ed-info-value">{{ item.clubName || '未加入' }}</text>
            </view>
            <view wx:if="{{ item.classTeacher }}" class="ed-info-row">
              <van-icon name="manager-o" size="24rpx" color="#718096" />
              <text class="ed-info-label">班主任</text>
              <text class="ed-info-value">{{ item.classTeacher }}</text>
            </view>
            <view wx:if="{{ item.classTeacherPhone }}" class="ed-info-row">
              <van-icon name="phone-o" size="24rpx" color="#718096" />
              <text class="ed-info-label">联系方式</text>
              <text class="ed-info-value">{{ item.classTeacherPhone }}</text>
            </view>
            <view wx:if="{{ item.todayStatus }}" class="ed-info-row">
              <van-icon name="clock-o" size="24rpx" color="#718096" />
              <text class="ed-info-label">点名时间</text>
              <text class="ed-info-value">{{ item.attendanceTime }}</text>
            </view>
          </view>

          <!-- 班主任反馈 -->
          <view wx:if="{{ item.feedback }}" class="ed-feedback-info">
            <van-icon name="comment-o" size="24rpx" color="#d69e2e" />
            <text>班主任反馈: {{ item.feedback }}</text>
          </view>
        </view>
      </view>
    </block>

    <empty-state wx:else type="default" />
  </view>
</view>

<van-toast id="van-toast" />
