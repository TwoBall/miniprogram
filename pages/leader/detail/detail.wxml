<view class="detail-container">
  <!-- 顶部信息栏 -->
  <view class="header-section">
    <view class="header-top">
      <view class="class-info">
        <van-icon name="home-o" size="40rpx" color="#ffffff" />
        <text class="class-name">{{className}}</text>
      </view>
    </view>
    <view class="date-info">
      <van-icon name="clock-o" size="28rpx" color="rgba(255,255,255,0.9)" />
      <text>{{date}}</text>
    </view>
  </view>

  <view class="student-list">
    <block wx:if="{{students.length > 0}}">
      <view class="card student-card" wx:for="{{students}}" wx:key="_id">
        <view class="student-header">
          <view class="student-name">
            <text>{{item.studentName}}</text>
            <van-tag wx:if="{{item.gender}}" plain type="{{item.gender === '男' ? 'primary' : 'danger'}}" size="mini">{{item.gender}}</van-tag>
          </view>
          <view class="status-badge {{item.todayStatus}}">
            {{item.todayStatus === 'present' ? '到课' : item.todayStatus === 'absent' ? '缺课' : '未点名'}}
          </view>
        </view>

        <view class="student-detail">
          <view class="detail-item">
            <text class="label">社团：</text>
            <text class="value">{{item.clubName || '未加入'}}</text>
          </view>
          <view class="detail-item" wx:if="{{item.classTeacher}}">
            <text class="label">班主任：</text>
            <text class="value">{{item.classTeacher}}</text>
          </view>
          <view class="detail-item" wx:if="{{item.classTeacherPhone}}">
            <text class="label">联系方式：</text>
            <text class="value">{{item.classTeacherPhone}}</text>
          </view>
          <view class="detail-item" wx:if="{{item.todayStatus}}">
            <text class="label">点名时间：</text>
            <text class="value">{{item.attendanceTime}}</text>
          </view>
          <view class="feedback-info" wx:if="{{item.feedback}}">
             <van-icon name="comment-o" size="24rpx" color="#faad14" />
             <text>班主任反馈: {{item.feedback}}</text>
          </view>
        </view>
      </view>
    </block>

    <empty-state wx:else type="default" />
  </view>
</view>

<van-toast id="van-toast" />
