.detail-container {
  padding: 20rpx;
}

.header-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  color: #ffffff;
}

.class-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.date {
  font-size: 28rpx;
  opacity: 0.9;
}

.student-list {
  padding: 0 10rpx;
}

.student-card {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.student-info {
  flex: 1;
}

.student-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
}

.gender-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #999;
  margin-left: 10rpx;
}

.student-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.label {
  color: #999;
  margin-right: 8rpx;
}

.value {
  color: #333;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 20rpx;
  white-space: nowrap;
}

.status-badge.present {
  background: #f6ffed;
  color: #52c41a;
}

.status-badge.absent {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-badge.null {
  background: #f5f5f5;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.feedback-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #faad14;
  background: #fffbe6;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  width: fit-content;
}
