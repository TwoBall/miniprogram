/* 领导班级详情页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */

.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 班级信息 */
.class-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.class-name {
  font-size: 40rpx;
  font-weight: bold;
}

.date-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
}

/* 学生列表 */
.student-list {
  padding: 20rpx;
}

/* 学生卡片 - 继承公共 .card，仅覆盖特有样式 */
.student-card {
  padding: 24rpx;
}

.student-info {
  flex: 1;
}

.student-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  align-items: center;
}

.gender-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #999;
  margin-left: 10rpx;
}

.student-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.label {
  color: #999;
  margin-right: 8rpx;
}

.value {
  color: #333;
}

/* 状态标签 */
.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.status-badge.present {
  background: #f6ffed;
  color: #52c41a;
}

.status-badge.absent {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-badge.null {
  background: #f5f5f5;
  color: #999;
}

.feedback-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #faad14;
  background: #fffbe6;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  width: fit-content;
}
