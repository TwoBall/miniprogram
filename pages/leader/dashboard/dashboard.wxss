.debug-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(90deg, #ff4d4f 0%, #ff7875 100%);
  color: #fff;
  padding: 16rpx;
  font-size: 24rpx;
}

.dashboard-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: #ffffff;
}

.department-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.department-name {
  font-size: 40rpx;
  font-weight: bold;
}

.date-selector {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  width: fit-content;
}

.stats-section {
  margin: -40rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.stat-content {
  padding: 30rpx 0;
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #333333;
}

.stat-number.present {
  color: #07c160;
}

.stat-number.absent {
  color: #ee0a24;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.class-list {
  margin: 0 30rpx;
}

.class-card {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.class-info {
  flex: 1;
}

.class-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.class-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.class-stats {
  display: flex;
  gap: 32rpx;
}

.stat-item {
  font-size: 24rpx;
}

.label {
  color: #999999;
}

.value {
  color: #333333;
  font-weight: 500;
}

.value.present {
  color: #07c160;
}

.value.absent {
  color: #ee0a24;
}
