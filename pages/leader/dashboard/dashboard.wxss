/* 领导看板页面样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-dashboard-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== 骨架屏包装器 ========== */
.ed-skeleton-wrapper {
  padding: 24rpx;
}

/* ========== Hero 头部 - Leader 橙棕主题 ========== */
.ed-hero-leader {
  background: linear-gradient(165deg, #744210 0%, #dd6b20 100%);
}

/* ========== 统计卡片网格 ========== */
.ed-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
}

.ed-stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.ed-stat-card.ed-stat-full {
  grid-column: 1 / -1;
}

.ed-stat-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gray-100, #f7fafc);
  border-radius: 12rpx;
  flex-shrink: 0;
}

.ed-stat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ed-stat-number {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--gray-900, #1a202c);
  line-height: 1.2;
}

.ed-stat-label {
  font-size: 24rpx;
  color: var(--gray-500, #a0aec0);
}

/* 统计卡片状态变体 */
.ed-stat-card.ed-stat-success .ed-stat-icon {
  background: var(--color-success-bg, #c6f6d5);
}

.ed-stat-card.ed-stat-success .ed-stat-number {
  color: var(--color-success, #38a169);
}

.ed-stat-card.ed-stat-error .ed-stat-icon {
  background: var(--color-error-bg, #fed7d7);
}

.ed-stat-card.ed-stat-error .ed-stat-number {
  color: var(--color-error, #c53030);
}

.ed-stat-card.ed-stat-warning .ed-stat-icon {
  background: var(--color-warning-bg, #feebc8);
}

.ed-stat-card.ed-stat-warning .ed-stat-number {
  color: var(--color-warning, #dd6b20);
}

/* ========== 区域容器 ========== */
.ed-section {
  margin-top: 32rpx;
  padding: 0 24rpx;
}

.ed-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ed-section-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ed-section-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-accent, #dd6b20);
  font-family: 'Georgia', serif;
}

.ed-section-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gray-800, #2d3748);
  letter-spacing: 1rpx;
}

.ed-section-badge {
  font-size: 22rpx;
  color: var(--color-accent, #dd6b20);
  background: rgba(221, 107, 32, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* ========== 排名切换按钮 ========== */
.ed-ranking-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}

.ed-ranking-toggle:active {
  background: var(--gray-50, #f8fafc);
  transform: scale(0.98);
}

.ed-toggle-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gray-700, #4a5568);
}

/* ========== 排名区域 ========== */
.ed-ranking-section {
  margin-bottom: 24rpx;
}

.ed-ranking-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ed-ranking-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  transition: all 0.2s ease;
}

.ed-ranking-item:active {
  transform: scale(0.98);
  background: var(--gray-50, #f8fafc);
}

.ed-ranking-item.top-rank {
  background: linear-gradient(135deg, #fffbf0 0%, #fff 100%);
  border-color: var(--color-accent, #dd6b20);
}

/* 排名徽章 */
.ed-rank-badge {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gray-100, #f7fafc);
  border-radius: 10rpx;
}

.ed-rank-number {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--gray-500, #a0aec0);
}

.ed-rank-number.first {
  color: #d69e2e;
  background: linear-gradient(180deg, #f6e05e 0%, #d69e2e 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.ed-rank-number.second {
  color: #718096;
}

.ed-rank-number.third {
  color: #c05621;
}

/* 排名信息 */
.ed-rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.ed-rank-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ed-rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-900, #1a202c);
}

.ed-rank-stats {
  font-size: 24rpx;
  color: var(--gray-500, #a0aec0);
}

/* 出勤率徽章 */
.ed-rate-badge {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.ed-rate-badge.excellent {
  background: var(--color-success-bg, #c6f6d5);
  color: var(--color-success, #38a169);
}

.ed-rate-badge.good {
  background: rgba(43, 108, 176, 0.1);
  color: var(--color-info, #2b6cb0);
}

.ed-rate-badge.normal {
  background: var(--color-warning-bg, #feebc8);
  color: var(--color-warning, #dd6b20);
}

.ed-rate-badge.poor {
  background: var(--color-error-bg, #fed7d7);
  color: var(--color-error, #c53030);
}

.ed-rate-value {
  font-size: 28rpx;
}

/* ========== 班级列表 ========== */
.ed-class-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ed-class-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  overflow: hidden;
  transition: all 0.2s ease;
}

.ed-class-card:active {
  transform: scale(0.98);
  background: var(--gray-50, #f8fafc);
  border-color: var(--gray-300, #e2e8f0);
}

/* 左侧状态指示条 */
.ed-card-indicator {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--gray-300, #e2e8f0);
}

.ed-card-indicator.excellent {
  background: var(--color-success, #38a169);
}

.ed-card-indicator.good {
  background: var(--color-info, #2b6cb0);
}

.ed-card-indicator.normal {
  background: var(--color-warning, #dd6b20);
}

.ed-card-indicator.poor {
  background: var(--color-error, #c53030);
}

/* 卡片主体 */
.ed-card-body {
  flex: 1;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ed-class-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ed-class-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ed-class-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-900, #1a202c);
}

.ed-class-rate {
  font-size: 24rpx;
  font-weight: 500;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.ed-class-rate.excellent {
  background: var(--color-success-bg, #c6f6d5);
  color: var(--color-success, #38a169);
}

.ed-class-rate.good {
  background: rgba(43, 108, 176, 0.1);
  color: var(--color-info, #2b6cb0);
}

.ed-class-rate.normal {
  background: var(--color-warning-bg, #feebc8);
  color: var(--color-warning, #dd6b20);
}

.ed-class-rate.poor {
  background: var(--color-error-bg, #fed7d7);
  color: var(--color-error, #c53030);
}

/* 班级统计 */
.ed-class-stats {
  display: flex;
  gap: 24rpx;
}

.ed-class-stat {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.ed-class-stat .ed-stat-label {
  font-size: 22rpx;
  color: var(--gray-500, #a0aec0);
}

.ed-class-stat .ed-stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gray-700, #4a5568);
}

.ed-class-stat.ed-stat-success .ed-stat-value {
  color: var(--color-success, #38a169);
}

.ed-class-stat.ed-stat-error .ed-stat-value {
  color: var(--color-error, #c53030);
}

/* 右侧箭头 */
.ed-card-arrow {
  display: flex;
  align-items: center;
  padding-right: 16rpx;
}
