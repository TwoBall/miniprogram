/* 学部领导仪表盘页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */
/* 使用公共类: .page-container, .stat-item, .ranking-item, .rank-badge, .rate-badge */

.dashboard-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 学部信息 */
.department-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.department-name {
  font-size: 40rpx;
  font-weight: bold;
}

/* 班级列表 */
.class-list {
  margin: 0 30rpx;
}

.class-card {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.class-info {
  flex: 1;
}

.class-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.class-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.class-stats {
  display: flex;
  gap: 32rpx;
}

.stat-item {
  font-size: 24rpx;
}

.label {
  color: #999999;
}

.value {
  color: #333333;
  font-weight: 500;
}

.value.present {
  color: #52c41a;
}

.value.absent {
  color: #ff4d4f;
}

.stat-number.warning {
  color: #ff9800;
}

/* 社团排名 */
.ranking-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
  cursor: pointer;
}

.club-ranking-section {
  margin-bottom: 32rpx;
}

/* 使用公共 .ranking-item 样式，仅覆盖特定样式 */
.ranking-item {
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s ease;
}

.ranking-item:active {
  transform: scale(0.98);
  background-color: #fafafa;
  border-color: #d0d0d0;
}

.ranking-item.top-rank {
  background: linear-gradient(135deg, #fff9e6 0%, #fff 100%);
  border: 2rpx solid #ffd700;
}

/* 使用公共 .rank-badge 样式 */
.rank-badge {
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.rank-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #999;
}

.rank-number.first {
  color: #ffd700;
}

.rank-number.second {
  color: #c0c0c0;
}

.rank-number.third {
  color: #cd7f32;
}

.club-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.club-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.club-stats {
  font-size: 24rpx;
  color: #999;
}

/* 使用公共 .rate-badge 样式，仅覆盖特定样式 */
.rate-badge {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  font-weight: 600;
}

.rate-value {
  font-size: 32rpx;
}

/* 日期选择器样式 */
.date-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.date-picker-cancel {
  color: #999;
  font-size: 28rpx;
}

.date-picker-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.date-picker-confirm {
  color: #1890ff;
  font-size: 28rpx;
}
