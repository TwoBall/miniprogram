/* 学部领导仪表盘页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */

.dashboard-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 学部信息 */
.department-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.department-name {
  font-size: 40rpx;
  font-weight: bold;
}

/* 班级列表 */
.class-list {
  margin: 0 30rpx;
}

.class-card {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.class-info {
  flex: 1;
}

.class-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.class-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.class-stats {
  display: flex;
  gap: 32rpx;
}

.stat-item {
  font-size: 24rpx;
}

.label {
  color: #999999;
}

.value {
  color: #333333;
  font-weight: 500;
}

.value.present {
  color: #07c160;
}

.value.absent {
  color: #ee0a24;
}
