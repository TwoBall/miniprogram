<!-- 领导看板页 - 教育杂志风 -->
<view class="ed-page ed-dashboard-page">
  <!-- 加载骨架屏 -->
  <view wx:if="{{pageLoading}}" class="ed-skeleton-wrapper">
    <skeleton type="dashboard" count="{{1}}" />
  </view>

  <block wx:else>
    <!-- 顶部信息栏 - Editorial Hero -->
    <view class="ed-hero ed-hero-leader fade-in-up">
      <view class="ed-hero-content">
        <view class="ed-hero-eyebrow">
          <van-icon name="cluster-o" size="28rpx" color="rgba(255,255,255,0.9)" />
          <text>学部看板</text>
        </view>
        <view class="ed-hero-title">
          <text class="ed-hero-title-line">{{department}}</text>
        </view>
        <view class="ed-hero-divider"></view>
        <view class="ed-hero-meta">
          <view class="ed-meta-item ed-date-selector icon-tap" bindtap="showDatePickerPopup">
            <van-icon name="calendar-o" size="26rpx" />
            <text>{{selectedDate}}</text>
            <van-icon name="arrow-down" size="22rpx" />
          </view>
        </view>
      </view>
    </view>

    <!-- 统计卡片 - Editorial Style -->
    <view class="ed-stats-grid">
      <view class="ed-stat-card">
        <view class="ed-stat-icon">
          <van-icon name="home-o" size="40rpx" color="#744210" />
        </view>
        <view class="ed-stat-info">
          <view class="ed-stat-number">{{totalClasses}}</view>
          <view class="ed-stat-label">班级总数</view>
        </view>
      </view>
      <view class="ed-stat-card">
        <view class="ed-stat-icon">
          <van-icon name="friends-o" size="40rpx" color="#dd6b20" />
        </view>
        <view class="ed-stat-info">
          <view class="ed-stat-number">{{totalStudents}}</view>
          <view class="ed-stat-label">学生总数</view>
        </view>
      </view>
      <view class="ed-stat-card ed-stat-success">
        <view class="ed-stat-icon">
          <van-icon name="passed" size="40rpx" color="#38a169" />
        </view>
        <view class="ed-stat-info">
          <view class="ed-stat-number">{{presentToday}}</view>
          <view class="ed-stat-label">今日到课</view>
        </view>
      </view>
      <view class="ed-stat-card ed-stat-error">
        <view class="ed-stat-icon">
          <van-icon name="cross" size="40rpx" color="#c53030" />
        </view>
        <view class="ed-stat-info">
          <view class="ed-stat-number">{{absentToday}}</view>
          <view class="ed-stat-label">今日缺课</view>
        </view>
      </view>
      <!-- 预警卡片（有预警时显示） -->
      <view class="ed-stat-card ed-stat-warning ed-stat-full" wx:if="{{warningCount > 0}}">
        <view class="ed-stat-icon">
          <van-icon name="warning-o" size="40rpx" color="#dd6b20" />
        </view>
        <view class="ed-stat-info">
          <view class="ed-stat-number">{{warningCount}}</view>
          <view class="ed-stat-label">缺勤预警学生</view>
        </view>
      </view>
    </view>

    <!-- 班级排名区域 -->
    <view class="ed-section">
      <!-- 排名切换按钮 -->
      <view class="ed-ranking-toggle icon-tap" bindtap="onToggleRanking">
        <view class="ed-toggle-content">
          <van-icon name="{{ showRanking ? 'arrow-up' : 'bar-chart-o' }}" size="36rpx" color="#dd6b20" />
          <text>{{ showRanking ? '收起班级排名' : '查看班级排名（本月）' }}</text>
        </view>
        <van-icon name="{{ showRanking ? 'arrow-up' : 'arrow-down' }}" size="28rpx" color="#a0aec0" />
      </view>

      <!-- 班级排名列表 -->
      <view wx:if="{{ showRanking }}" class="ed-ranking-section">
        <view class="ed-section-header">
          <view class="ed-section-title">
            <text class="ed-section-num">01</text>
            <text class="ed-section-text">班级出勤率排名</text>
          </view>
          <view class="ed-section-badge">本月</view>
        </view>

        <view wx:if="{{classRanking.length > 0}}" class="ed-ranking-list">
          <view
            wx:for="{{classRanking}}"
            wx:key="className"
            class="ed-ranking-item {{ index < 3 ? 'top-rank' : '' }}"
          >
            <view class="ed-rank-badge">
              <text class="ed-rank-number {{ index === 0 ? 'first' : index === 1 ? 'second' : index === 2 ? 'third' : '' }}">{{ index + 1 }}</text>
            </view>
            <view class="ed-rank-info">
              <view class="ed-rank-header">
                <van-icon name="home-o" size="28rpx" color="#dd6b20" />
                <text class="ed-rank-name">{{item.className}}</text>
              </view>
              <view class="ed-rank-stats">
                <text>到课 {{item.present}} / 总计 {{item.total}} 次</text>
              </view>
            </view>
            <view class="ed-rate-badge {{ item.rate >= 90 ? 'excellent' : item.rate >= 80 ? 'good' : item.rate >= 60 ? 'normal' : 'poor' }}">
              <text class="ed-rate-value">{{item.rate}}%</text>
            </view>
          </view>
        </view>

        <empty-state
          wx:else
          type="attendance"
          description="暂无班级排名数据"
        />
      </view>
    </view>

    <!-- 班级考勤详情区域 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">{{ showRanking ? '02' : '01' }}</text>
          <text class="ed-section-text">班级考勤详情</text>
        </view>
      </view>

      <view wx:if="{{classes.length > 0}}" class="ed-class-list">
        <view
          wx:for="{{classes}}"
          wx:key="className"
          class="ed-class-card list-item-enter card-tap"
          bindtap="viewClassDetail"
          data-class="{{item}}"
        >
          <!-- 左侧状态指示条 -->
          <view class="ed-card-indicator {{ item.attendanceRate >= 90 ? 'excellent' : item.attendanceRate >= 80 ? 'good' : item.attendanceRate >= 60 ? 'normal' : 'poor' }}"></view>

          <view class="ed-card-body">
            <view class="ed-class-header">
              <view class="ed-class-main">
                <van-icon name="home-o" size="36rpx" color="#dd6b20" />
                <text class="ed-class-name">{{item.className}}</text>
              </view>
              <view class="ed-class-rate {{ item.attendanceRate >= 90 ? 'excellent' : item.attendanceRate >= 80 ? 'good' : item.attendanceRate >= 60 ? 'normal' : 'poor' }}">
                出勤率 {{item.attendanceRate}}%
              </view>
            </view>
            <view class="ed-class-stats">
              <view class="ed-class-stat">
                <text class="ed-stat-label">总人数</text>
                <text class="ed-stat-value">{{item.totalStudents}}</text>
              </view>
              <view class="ed-class-stat ed-stat-success">
                <text class="ed-stat-label">到课</text>
                <text class="ed-stat-value">{{item.present}}</text>
              </view>
              <view class="ed-class-stat ed-stat-error">
                <text class="ed-stat-label">缺课</text>
                <text class="ed-stat-value">{{item.absent}}</text>
              </view>
            </view>
          </view>

          <view class="ed-card-arrow">
            <van-icon name="arrow" size="28rpx" color="#a0aec0" />
          </view>
        </view>
      </view>

      <empty-state
        wx:else
        type="default"
      />
    </view>
  </block>

  <!-- 日历选择器 -->
  <van-calendar
    wx:if="{{ showCalendar }}"
    show="{{ showCalendar }}"
    type="single"
    min-date="{{ calendarMinDate }}"
    max-date="{{ calendarMaxDate }}"
    default-date="{{ calendarDefaultDate }}"
    bind:close="onCalendarClose"
    bind:confirm="onCalendarConfirm"
    color="#dd6b20"
  />

  <!-- 底部 TabBar -->
  <custom-tabbar role="leader" active="0" />

  <van-toast id="van-toast" />
</view>
