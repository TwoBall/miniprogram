<!-- 班主任学生列表页 - 教育杂志风 -->
<view class="ed-page ed-students-page">
  <!-- 初始加载骨架屏 -->
  <view wx:if="{{ pageLoading }}" class="ed-skeleton-wrapper">
    <skeleton type="list" count="{{6}}" avatar="{{true}}" />
  </view>

  <!-- 实际内容 -->
  <block wx:else>
    <!-- 顶部信息栏 - Editorial Hero -->
    <view class="ed-hero ed-hero-class-teacher fade-in-up">
      <view class="ed-hero-content">
        <view class="ed-hero-eyebrow">
          <van-icon name="friends-o" size="28rpx" color="rgba(255,255,255,0.9)" />
          <text>学生管理</text>
        </view>
        <view class="ed-hero-title">
          <text class="ed-hero-title-line">{{ className }}</text>
        </view>
        <view class="ed-hero-divider"></view>
        <view class="ed-hero-meta">
          <view class="ed-meta-item">
            <van-icon name="manager-o" size="26rpx" />
            <text>{{ userInfo.userName }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 统计卡片 -->
    <view class="ed-stats-grid">
      <view class="ed-stat-card">
        <view class="ed-stat-icon">
          <van-icon name="friends-o" size="40rpx" color="#276749" />
        </view>
        <view class="ed-stat-info">
          <view class="ed-stat-number">{{ stats.totalCount }}</view>
          <view class="ed-stat-label">学生数</view>
        </view>
      </view>
      <view class="ed-stat-card ed-stat-success" wx:if="{{ activeTab === 'rank' }}">
        <view class="ed-stat-icon">
          <van-icon name="chart-trending-o" size="40rpx" color="#38a169" />
        </view>
        <view class="ed-stat-info">
          <view class="ed-stat-number">{{ stats.avgAttendanceRate }}%</view>
          <view class="ed-stat-label">平均出勤率</view>
        </view>
      </view>
      <view class="ed-stat-card ed-stat-warning" wx:if="{{ activeTab === 'students' && stats.warningCount > 0 }}">
        <view class="ed-stat-icon">
          <van-icon name="warning-o" size="40rpx" color="#dd6b20" />
        </view>
        <view class="ed-stat-info">
          <view class="ed-stat-number">{{ stats.warningCount }}</view>
          <view class="ed-stat-label">缺勤预警</view>
        </view>
      </view>
    </view>

    <!-- 社团分布 -->
    <view class="ed-section" wx:if="{{ clubDistribution.length > 0 }}">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">01</text>
          <text class="ed-section-text">社团分布</text>
        </view>
      </view>
      <view class="ed-distribution-tags">
        <view
          class="ed-distribution-tag {{ selectedDistribution === '全部' || !selectedDistribution ? 'active' : '' }}"
          bindtap="onDistributionFilter"
          data-value="全部"
        >
          <text class="ed-tag-name">全部</text>
          <text class="ed-tag-count">{{ stats.totalCount }}</text>
        </view>
        <view
          wx:for="{{ clubDistribution }}"
          wx:key="name"
          class="ed-distribution-tag {{ selectedDistribution === item.name ? 'active' : '' }}"
          bindtap="onDistributionFilter"
          data-value="{{ item.name }}"
        >
          <text class="ed-tag-name">{{ item.name }}</text>
          <text class="ed-tag-count">{{ item.count }}</text>
        </view>
      </view>
    </view>

    <!-- Tab 切换 -->
    <view class="ed-tabs-wrapper">
      <view class="ed-tabs">
        <view
          class="ed-tab-item {{ activeTab === 'students' ? 'active' : '' }}"
          data-tab="students"
          bindtap="onTabChange"
        >
          <van-icon name="friends-o" size="32rpx" />
          <text>学生名单</text>
        </view>
        <view
          class="ed-tab-item {{ activeTab === 'rank' ? 'active' : '' }}"
          data-tab="rank"
          bindtap="onTabChange"
        >
          <van-icon name="bar-chart-o" size="32rpx" />
          <text>出勤排行</text>
        </view>
      </view>
    </view>

    <!-- 搜索框 -->
    <view class="ed-search-wrapper" wx:if="{{ activeTab === 'students' }}">
      <van-search
        value="{{ searchValue }}"
        placeholder="搜索学生姓名或社团"
        bind:search="onSearch"
        bind:clear="onSearchClear"
        bind:change="onSearch"
        custom-class="ed-search"
      />
    </view>

    <!-- 学生名单 -->
    <view wx:if="{{ activeTab === 'students' }}" class="ed-tab-content">
      <view wx:if="{{ loading }}" class="ed-loading-center">
        <van-loading type="spinner" size="48rpx">加载中...</van-loading>
      </view>

      <scroll-view
        wx:elif="{{ filteredStudents.length > 0 }}"
        class="ed-student-scroll"
        scroll-y
        bindscroll="onVirtualScroll"
        style="height: calc(100vh - 520rpx);"
      >
        <view class="ed-student-list" style="height: {{totalHeight}}px; position: relative;">
          <view style="transform: translateY({{offsetY}}px);">
            <view
              wx:for="{{ virtualList }}"
              wx:key="_id"
              class="ed-student-card card-tap"
              bindtap="onStudentTap"
              data-id="{{ item._id }}"
            >
              <!-- 左侧状态指示条 -->
              <view class="ed-card-indicator {{ warningStudentIds.includes(item._id) ? 'warning' : 'success' }}"></view>

              <view class="ed-card-body">
                <view class="ed-student-header">
                  <view class="ed-student-main">
                    <view class="ed-student-avatar">
                      <van-icon name="user-o" size="36rpx" color="#fff" />
                    </view>
                    <view class="ed-student-info">
                      <view class="ed-student-name-row">
                        <text class="ed-student-name">{{ item.studentName }}</text>
                        <view wx:if="{{ warningStudentIds.includes(item._id) }}" class="ed-warning-tag">
                          <van-icon name="warning-o" size="20rpx" />
                          <text>预警</text>
                        </view>
                        <view wx:if="{{ item.gender }}" class="ed-gender-tag {{ item.gender === '男' ? 'male' : 'female' }}">
                          {{ item.gender }}
                        </view>
                      </view>
                      <view class="ed-student-club">
                        <van-icon name="apps-o" size="24rpx" color="#718096" />
                        <text>{{ item.clubName || '未分配社团' }}</text>
                      </view>
                    </view>
                  </view>
                </view>
              </view>

              <view class="ed-card-arrow">
                <van-icon name="arrow" size="28rpx" color="#a0aec0" />
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <empty-state
        wx:else
        type="students"
      />
    </view>

    <!-- 出勤率排行 -->
    <view wx:if="{{ activeTab === 'rank' }}" class="ed-tab-content">
      <view wx:if="{{ loading }}" class="ed-loading-center">
        <van-loading type="spinner" size="48rpx">加载中...</van-loading>
      </view>

      <view wx:elif="{{ attendanceRank.length > 0 }}" class="ed-ranking-list">
        <view
          wx:for="{{ attendanceRank }}"
          wx:key="_id"
          class="ed-ranking-item {{ index < 3 ? 'top-rank' : '' }}"
        >
          <view class="ed-rank-badge">
            <text class="ed-rank-number {{ index === 0 ? 'first' : index === 1 ? 'second' : index === 2 ? 'third' : '' }}">{{ index + 1 }}</text>
          </view>
          <view class="ed-rank-info">
            <view class="ed-rank-header">
              <text class="ed-rank-name">{{ item.studentName }}</text>
              <text class="ed-rank-club">{{ item.clubName || '未分配' }}</text>
            </view>
            <view class="ed-rank-stats">
              <text>到课 {{ item.present }} / 总计 {{ item.total }} 次</text>
            </view>
          </view>
          <view class="ed-rate-badge {{ item.rate >= 90 ? 'excellent' : item.rate >= 80 ? 'good' : item.rate >= 60 ? 'normal' : 'poor' }}">
            <text class="ed-rate-value">{{ item.rate }}%</text>
          </view>
        </view>
      </view>

      <empty-state
        wx:else
        type="attendance"
      />
    </view>
  </block>

  <van-toast id="van-toast" />
</view>
