<view class="student-list-container">
  <!-- 初始加载骨架屏 -->
  <block wx:if="{{ pageLoading }}">
    <skeleton type="list" count="{{6}}" avatar="{{true}}" />
  </block>

  <!-- 实际内容 -->
  <block wx:else>
  <!-- 班级信息卡片 -->
  <view class="list-header class-teacher-header">
    <view class="header-info">
      <view class="header-title-wrapper">
        <van-icon name="friends-o" size="40rpx" color="#fff" />
        <text class="header-title">{{ className }}</text>
      </view>
      <view class="header-meta">
        <text class="header-meta-item">班主任：{{ userInfo.userName }}</text>
      </view>
    </view>
    <view class="header-stats">
      <view class="header-stat-item">
        <text class="header-stat-value">{{ stats.totalCount }}</text>
        <text class="header-stat-label">学生数</text>
      </view>
      <view class="header-stat-item" wx:if="{{ activeTab === 'rank' }}">
        <text class="header-stat-value">{{ stats.avgAttendanceRate }}%</text>
        <text class="header-stat-label">平均出勤率</text>
      </view>
      <view class="header-stat-item warning" wx:if="{{ activeTab === 'students' && stats.warningCount > 0 }}">
        <text class="header-stat-value">{{ stats.warningCount }}</text>
        <text class="header-stat-label">缺勤预警</text>
      </view>
    </view>
  </view>

  <!-- 社团分布 -->
  <view class="distribution-section" wx:if="{{ clubDistribution.length > 0 }}">
    <view class="distribution-title">社团分布</view>
    <view class="distribution-tags">
      <view
        class="distribution-tag {{ selectedDistribution === '全部' || !selectedDistribution ? 'active' : '' }}"
        bindtap="onDistributionFilter"
        data-value="全部"
      >
        <text class="distribution-tag-name">全部</text>
        <text class="distribution-tag-count">{{ stats.totalCount }}</text>
      </view>
      <view
        wx:for="{{ clubDistribution }}"
        wx:key="name"
        class="distribution-tag {{ selectedDistribution === item.name ? 'active' : '' }}"
        bindtap="onDistributionFilter"
        data-value="{{ item.name }}"
      >
        <text class="distribution-tag-name">{{ item.name }}</text>
        <text class="distribution-tag-count">{{ item.count }}</text>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="student-list-tabs">
    <view
      class="student-list-tab-item {{ activeTab === 'students' ? 'active' : '' }}"
      data-tab="students"
      bindtap="onTabChange"
    >
      <van-icon name="friends-o" size="36rpx" />
      <text>学生名单</text>
    </view>
    <view
      class="student-list-tab-item {{ activeTab === 'rank' ? 'active' : '' }}"
      data-tab="rank"
      bindtap="onTabChange"
    >
      <van-icon name="bar-chart-o" size="36rpx" />
      <text>出勤排行</text>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="student-list-search" wx:if="{{ activeTab === 'students' }}">
    <van-search
      value="{{ searchValue }}"
      placeholder="搜索学生姓名或社团"
      bind:search="onSearch"
      bind:clear="onSearchClear"
      bind:change="onSearch"
    />
  </view>

  <!-- 学生名单 -->
  <view wx:if="{{ activeTab === 'students' }}" class="student-list-content">
    <view wx:if="{{ loading }}" class="student-list-loading">
      <van-loading type="spinner" size="48rpx">加载中...</van-loading>
    </view>

    <view wx:elif="{{ filteredStudents.length > 0 }}" class="student-list-wrapper">
      <view
        wx:for="{{ filteredStudents }}"
        wx:key="_id"
        class="student-card"
        bindtap="onStudentTap"
        data-id="{{ item._id }}"
      >
        <view class="student-card-avatar">
          <van-icon name="user-circle-o" size="40px" color="#1890ff" />
        </view>
        <view class="student-card-info">
          <view class="student-card-header">
            <view class="student-card-name-wrapper">
              <text class="student-card-name">{{ item.studentName }}</text>
              <van-tag
                wx:if="{{ warningStudentIds.includes(item._id) }}"
                type="danger"
                plain
                size="medium"
              >
                <van-icon name="warning-o" size="12px" />
                预警
              </van-tag>
            </view>
            <van-tag wx:if="{{ item.gender }}" plain type="{{ item.gender === '男' ? 'primary' : 'danger' }}" size="medium">
              {{ item.gender }}
            </van-tag>
          </view>
          <view class="student-card-meta">
            <view class="student-card-meta-item">
              <van-icon name="apps-o" size="28rpx" color="#999" />
              <text>{{ item.clubName || '未分配社团' }}</text>
            </view>
          </view>
        </view>
        <van-icon name="arrow" size="16px" color="#ccc" />
      </view>
    </view>

    <van-empty
      wx:else
      description="暂无学生数据"
      image="search"
    />
  </view>

  <!-- 出勤率排行 -->
  <view wx:if="{{ activeTab === 'rank' }}" class="student-list-content">
    <view wx:if="{{ loading }}" class="student-list-loading">
      <van-loading type="spinner" size="48rpx">加载中...</van-loading>
    </view>

    <view wx:elif="{{ attendanceRank.length > 0 }}" class="student-rank-list">
      <view
        wx:for="{{ attendanceRank }}"
        wx:key="studentName"
        class="student-rank-item {{ index < 3 ? 'top-rank' : '' }}"
      >
        <view class="student-rank-badge">
          <text class="student-rank-number {{ index === 0 ? 'first' : index === 1 ? 'second' : index === 2 ? 'third' : '' }}">{{ index + 1 }}</text>
        </view>
        <view class="student-rank-info">
          <view class="student-rank-header">
            <text class="student-rank-name">{{ item.studentName }}</text>
            <text class="student-rank-class">{{ item.clubName || '未分配' }}</text>
          </view>
          <view class="student-rank-stats">
            <text>到课 {{ item.present }} / 总计 {{ item.total }} 次</text>
          </view>
        </view>
        <view class="student-rank-rate {{ item.rate >= 90 ? 'excellent' : item.rate >= 80 ? 'good' : item.rate >= 60 ? 'normal' : 'poor' }}">
          <text class="student-rank-rate-value">{{ item.rate }}%</text>
        </view>
      </view>
    </view>

    <van-empty
      wx:else
      description="暂无考勤数据"
      image="search"
    />
  </view>
  </block>

  <van-toast id="van-toast" />
</view>
