/* 班主任学生管理页面样式 */

.students-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 班级信息卡片 */
.class-info {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 32rpx 30rpx;
}

.class-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.class-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.student-count {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
  background-color: #f0f9ff;
  border-radius: 20rpx;
}

/* 社团分布 */
.club-distribution {
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.club-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.club-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.club-tag:active {
  background-color: #e6f7ff;
  transform: scale(0.95);
}

.club-name {
  font-size: 26rpx;
  color: #666;
}

.club-count {
  font-size: 22rpx;
  color: #1890ff;
  font-weight: 500;
}

/* 搜索框 */
.search-wrapper {
  background-color: #fff;
  margin-bottom: 20rpx;
}

/* 学生列表 */
.students-list {
  padding: 0 30rpx;
}

.student-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.student-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.student-avatar {
  flex-shrink: 0;
}

.student-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.student-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.student-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.student-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}
