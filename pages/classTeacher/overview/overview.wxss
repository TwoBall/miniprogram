/* 班主任概览页面 - Editorial 教育杂志风 */

/* 页面容器 */
.ed-overview-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 班主任角色 Hero - 绿色主题 */
/* 使用全局 ed-hero 标准高度: padding: 40rpx 32rpx 56rpx */
.ed-hero-classTeacher {
  background: linear-gradient(165deg, #276749 0%, #38a169 100%);
  position: relative;
  overflow: hidden;
}

.ed-hero-classTeacher::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.ed-hero-classTeacher::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: 15%;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.ed-hero-content {
  position: relative;
  z-index: 1;
}

.ed-hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.ed-hero-title {
  margin-bottom: 16rpx;
}

.ed-hero-title-line {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.ed-hero-divider {
  width: 60rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 3rpx;
  margin-bottom: 16rpx;
}

.ed-hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.ed-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.ed-date-selector {
  background: rgba(255, 255, 255, 0.15);
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
  transition: all 0.2s ease;
}

.ed-date-selector:active {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(0.98);
}

/* 统计卡片网格 - 2x2 布局 */
.ed-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
}

.ed-stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid var(--gray-200, #edf2f7);
  transition: all 0.2s ease;
}

.ed-stat-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.ed-stat-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gray-100, #f7fafc);
  border-radius: 16rpx;
}

.ed-stat-success .ed-stat-icon {
  background: var(--color-success-bg, #c6f6d5);
}

.ed-stat-error .ed-stat-icon {
  background: var(--color-error-bg, #fed7d7);
}

.ed-stat-info {
  flex: 1;
}

.ed-stat-number {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--gray-900, #1a202c);
  line-height: 1.2;
}

.ed-stat-label {
  font-size: 24rpx;
  color: var(--gray-500, #a0aec0);
  margin-top: 4rpx;
}

.ed-stat-success .ed-stat-number {
  color: var(--color-success, #38a169);
}

.ed-stat-error .ed-stat-number {
  color: var(--color-error, #c53030);
}

/* 区块样式 */
.ed-section {
  margin-top: 32rpx;
  padding: 0 24rpx;
}

.ed-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ed-section-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ed-section-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-accent, #ed8936);
  font-style: italic;
}

.ed-section-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-900, #1a202c);
}

/* 学生列表 */
.ed-student-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ed-student-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  border: 2rpx solid var(--gray-200, #edf2f7);
  transition: all 0.2s ease;
}

.ed-student-card:active {
  transform: scale(0.98);
  background: var(--gray-50, #f8fafc);
}

/* 左侧状态指示条 */
.ed-card-indicator {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--gray-300, #e2e8f0);
}

.ed-card-indicator.success {
  background: var(--color-success, #38a169);
}

.ed-card-indicator.error {
  background: var(--color-error, #c53030);
}

.ed-card-indicator.default {
  background: var(--gray-400, #cbd5e0);
}

.ed-card-body {
  flex: 1;
  padding: 20rpx 24rpx;
}

.ed-student-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.ed-student-main {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.ed-student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ed-student-avatar.male {
  background: linear-gradient(135deg, #1a365d 0%, #2c5282 100%);
}

.ed-student-avatar.female {
  background: linear-gradient(135deg, #ed64a6 0%, #d53f8c 100%);
}

.ed-student-info {
  flex: 1;
  min-width: 0;
}

.ed-student-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.ed-student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-900, #1a202c);
}

.ed-gender-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.ed-gender-tag.male {
  background: rgba(26, 54, 93, 0.1);
  color: var(--color-primary, #1a365d);
}

.ed-gender-tag.female {
  background: rgba(237, 100, 166, 0.1);
  color: #d53f8c;
}

.ed-student-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ed-student-meta .ed-meta-item {
  color: var(--gray-600, #718096);
  font-size: 24rpx;
}

.ed-student-status {
  flex-shrink: 0;
}

.ed-status-tag {
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.ed-status-tag.success {
  background: var(--color-success-bg, #c6f6d5);
  color: var(--color-success, #38a169);
}

.ed-status-tag.error {
  background: var(--color-error-bg, #fed7d7);
  color: var(--color-error, #c53030);
}

.ed-status-tag.default {
  background: var(--gray-100, #f7fafc);
  color: var(--gray-500, #a0aec0);
}

/* 卡片操作区 */
.ed-card-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--gray-200, #edf2f7);
  display: flex;
  justify-content: flex-end;
}

.ed-btn-outline {
  border-color: var(--color-primary, #1a365d) !important;
  color: var(--color-primary, #1a365d) !important;
  display: flex !important;
  align-items: center !important;
  gap: 8rpx !important;
}

/* 骨架屏包装 */
.ed-skeleton-wrapper {
  padding: 0;
}

.ed-stats-section {
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
}
