/* 班主任概览页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */
/* 使用公共类: .page-container, .card, .status-badge */

.overview-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 班级信息 */
.class-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.class-name {
  font-size: 40rpx;
  font-weight: bold;
}

/* 学生列表 */
.student-list {
  padding: 0 30rpx;
}

.student-card {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s ease;
}

.student-card:active {
  transform: scale(0.98);
  background-color: #fafafa;
  border-color: #d0d0d0;
}

.student-info {
  flex: 1;
}

.student-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.gender-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #999;
}

.student-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.detail-item van-icon {
  margin-right: 8rpx;
}

/* 出勤状态标签 - 扩展公共 .status-badge */
.status-badge {
  border-radius: 30rpx;
}

.status-badge.default {
  background: #f5f5f5;
  color: #999;
}
