/* 班主任概览页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */

.overview-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 班级信息 */
.class-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.class-name {
  font-size: 40rpx;
  font-weight: bold;
}

/* 学生列表 */
.student-list {
  padding: 0 30rpx;
}

.student-card {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.student-info {
  flex: 1;
}

.student-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.gender-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #999;
}

.student-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.detail-item van-icon {
  margin-right: 8rpx;
}

/* 出勤状态标签 */
.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.present {
  background: #f6ffed;
  color: #52c41a;
}

.status-badge.absent {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-badge.default {
  background: #f5f5f5;
  color: #999;
}
