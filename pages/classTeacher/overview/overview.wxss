.debug-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(90deg, #ff4d4f 0%, #ff7875 100%);
  color: #fff;
  padding: 16rpx;
  font-size: 24rpx;
}

.overview-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: #ffffff;
}

.class-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.class-name {
  font-size: 40rpx;
  font-weight: bold;
}

.date-selector {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  width: fit-content;
}

.stats-section {
  margin: -40rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.stat-content {
  padding: 30rpx 0;
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #333333;
}

.stat-number.present {
  color: #07c160;
}

.stat-number.absent {
  color: #ee0a24;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}


.student-list {
  padding: 0 30rpx;
}

.student-card {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.student-info {
  flex: 1;
}

.student-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.gender-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #f5f5f5;
  color: #999;
}

.student-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.detail-item van-icon {
  margin-right: 8rpx;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.present {
  background: #f6ffed;
  color: #52c41a;
}

.status-badge.absent {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-badge.default {
  background: #f5f5f5;
  color: #999;
}
