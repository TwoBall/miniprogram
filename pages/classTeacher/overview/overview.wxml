<view class="overview-container">
  <view class="header-section fade-in-up">
    <view class="header-top">
      <view class="class-info">
        <van-icon name="home-o" size="40rpx" color="#ffffff" />
        <text class="class-name">{{className}}</text>
      </view>
    </view>
    <view class="date-selector icon-tap" bindtap="showDatePickerPopup">
      <van-icon name="calendar-o" size="28rpx" color="rgba(255,255,255,0.9)" />
      <text>{{selectedDate}}</text>
      <van-icon name="arrow-down" size="24rpx" color="rgba(255,255,255,0.9)" />
    </view>
  </view>

  <!-- 统计区域骨架屏 -->
  <view class="stats-section" wx:if="{{pageLoading}}">
    <skeleton type="stats" count="{{4}}" />
  </view>

  <view class="stats-section" wx:else>
    <van-grid column-num="4" border="{{ false }}">
      <van-grid-item use-slot>
        <view class="stat-content">
          <view class="stat-number">{{totalStudents}}</view>
          <view class="stat-label">总人数</view>
        </view>
      </van-grid-item>
      <van-grid-item use-slot>
        <view class="stat-content">
          <view class="stat-number">{{joinedClubs}}</view>
          <view class="stat-label">参加社团</view>
        </view>
      </van-grid-item>
      <van-grid-item use-slot>
        <view class="stat-content">
          <view class="stat-number present">{{presentToday}}</view>
          <view class="stat-label">今日到课</view>
        </view>
      </van-grid-item>
      <van-grid-item use-slot>
        <view class="stat-content">
          <view class="stat-number absent">{{absentToday}}</view>
          <view class="stat-label">今日缺课</view>
        </view>
      </van-grid-item>
    </van-grid>
  </view>

  <view class="student-list">
    <!-- 学生列表骨架屏 -->
    <view wx:if="{{pageLoading}}" class="skeleton-wrapper">
      <skeleton type="list" count="{{5}}" avatar="{{true}}" avatarShape="round" />
    </view>

    <van-cell-group title="学生考勤详情" wx:elif="{{students.length > 0}}">
      <van-cell wx:for="{{students}}" wx:key="_id" border="{{ false }}" custom-class="student-card list-item-enter">
        <view slot="title" class="student-info">
          <view class="student-header">
            <view class="student-name">
              <van-icon name="user-o" size="32rpx" color="#1890ff" />
              <text>{{item.studentName}}</text>
              <van-tag plain type="{{item.gender === '男' ? 'primary' : 'danger'}}" size="mini">{{item.gender}}</van-tag>
            </view>
            <van-tag
              type="{{ item.todayStatus === 'present' ? 'success' : item.todayStatus === 'absent' ? 'danger' : 'default' }}"
              size="medium"
            >
              {{item.todayStatus === 'present' ? '到课' : item.todayStatus === 'absent' ? '缺课' : '未点名'}}
            </van-tag>
          </view>
          <view class="student-detail">
            <view class="detail-item">
              <van-icon name="friends-o" size="24rpx" color="#999" />
              <text>{{item.clubName || '未加入社团'}}</text>
            </view>
            <view class="detail-item" wx:if="{{item.todayStatus}}">
              <van-icon name="clock-o" size="24rpx" color="#999" />
              <text>{{item.attendanceTime}}</text>
            </view>
          </view>
        </view>
        <view slot="right-icon" wx:if="{{item.todayStatus === 'absent'}}">
          <van-button
            type="primary"
            size="small"
            plain
            bind:click="sendFeedback"
            data-student="{{item}}"
            custom-class="btn-active"
          >
            发送反馈
          </van-button>
        </view>
      </van-cell>
    </van-cell-group>

    <empty-state
      wx:else
      type="attendance"
      description="该班级暂无学生考勤数据"
    />
  </view>

  <van-calendar
    show="{{ showCalendar }}"
    type="single"
    min-date="{{ calendarMinDate }}"
    max-date="{{ calendarMaxDate }}"
    default-date="{{ calendarDefaultDate }}"
    formatter="{{ formatCalendarDay }}"
    bind:close="onCalendarClose"
    bind:confirm="onCalendarConfirm"
    color="#1F6FAD"
  />

  <!-- 底部 TabBar -->
  <custom-tabbar role="classTeacher" active="0" />
</view>
