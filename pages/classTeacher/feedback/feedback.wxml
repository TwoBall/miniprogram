<!-- 班主任反馈页 - 教育杂志风 -->
<view class="ed-page ed-feedback-page">
  <!-- Hero 头部 -->
  <view class="ed-hero ed-hero-classTeacher fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="chat-o" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>学生反馈</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">发送反馈</text>
      </view>
      <view class="ed-hero-subtitle">
        <text>向社团教师反馈学生情况</text>
      </view>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="ed-form-section card-pop-in">
    <!-- 学生信息 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">01</text>
          <text class="ed-section-text">学生信息</text>
        </view>
      </view>

      <view class="ed-info-card">
        <view class="ed-info-item">
          <view class="ed-info-icon">
            <van-icon name="user-o" size="32rpx" color="#276749" />
          </view>
          <view class="ed-info-content">
            <text class="ed-info-label">学生姓名</text>
            <text class="ed-info-value">{{ studentName }}</text>
          </view>
        </view>
        <view class="ed-info-item">
          <view class="ed-info-icon">
            <van-icon name="apps-o" size="32rpx" color="#276749" />
          </view>
          <view class="ed-info-content">
            <text class="ed-info-label">所属社团</text>
            <text class="ed-info-value">{{ clubName }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 反馈内容 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">02</text>
          <text class="ed-section-text">反馈内容</text>
        </view>
        <view class="ed-char-count">
          <text class="{{ feedback.length > 450 ? 'warning' : '' }}">{{ feedback.length }}</text>
          <text class="ed-char-total">/500</text>
        </view>
      </view>

      <view class="ed-textarea-card">
        <textarea
          class="ed-textarea"
          placeholder="请输入反馈内容，如缺课原因、需要关注的问题等..."
          placeholder-class="ed-textarea-placeholder"
          value="{{ feedback }}"
          bindinput="onFeedbackInput"
          maxlength="500"
          auto-height
        />
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="ed-tips-card">
      <view class="ed-tips-icon">
        <van-icon name="info-o" size="32rpx" color="#276749" />
      </view>
      <text class="ed-tips-text">反馈内容将发送给该学生所在社团的任课教师，请确保信息准确</text>
    </view>

    <!-- 提交按钮 -->
    <view class="ed-submit-section">
      <van-button
        type="primary"
        block
        round
        loading="{{ loading }}"
        disabled="{{ loading || !feedback.trim() }}"
        loading-text="发送中..."
        bind:click="submitFeedback"
        custom-class="ed-btn-primary btn-active"
      >
        发送反馈
      </van-button>
    </view>
  </view>

  <van-toast id="van-toast" />
</view>
