/* 学生详情页面样式 */

.student-detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 学生卡片 */
.student-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 40rpx 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.student-avatar {
  flex-shrink: 0;
}

.student-basic {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.student-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.student-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #666;
}

/* 标签页内容 */
.tab-content {
  padding: 24rpx 0;
}

/* 考勤统计 */
.attendance-stats {
  display: flex;
  background-color: #fff;
  padding: 32rpx 30rpx;
  margin: 0 30rpx 20rpx;
  border-radius: 12rpx;
  gap: 12rpx;
  border: 2rpx solid #e8e8e8;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border-radius: 8rpx;
  background-color: #f5f5f5;
}

.stat-item.success {
  background-color: #f0fdf4;
}

.stat-item.warning {
  background-color: #fff7e6;
}

.stat-item.danger {
  background-color: #fff1f0;
}

.stat-item.primary {
  background-color: #f0f9ff;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.stat-item.success .stat-value {
  color: #52c41a;
}

.stat-item.warning .stat-value {
  color: #ff9800;
}

.stat-item.danger .stat-value {
  color: #ff4d4f;
}

.stat-item.primary .stat-value {
  color: #1890ff;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 考勤历史列表 */
.attendance-list {
  padding: 0 30rpx;
}

.attendance-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e8e8e8;
}

.attendance-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.date {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.attendance-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}
