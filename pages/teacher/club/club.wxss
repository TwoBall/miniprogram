/* 教师社团管理页面样式 */
/* 引入公共样式 */
@import '../../../styles/student-list-base.wxss';

/* 教师角色头部渐变色 */
.teacher-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

/* ========== 学部班级筛选区域 ========== */
.filter-section {
  background-color: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.filter-picker {
  flex: 1;
}

.filter-picker-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s;
}

.filter-picker-content:active {
  background-color: #e6f7ff;
  border-color: #1890ff;
}

.filter-picker-content.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.filter-label {
  font-size: 22rpx;
  color: #999;
}

.filter-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.filter-reset {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #1890ff;
  background-color: #e6f7ff;
  border-radius: 8rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.filter-reset:active {
  background-color: #bae7ff;
}

.filter-reset.disabled {
  color: #999;
  background-color: #f5f5f5;
  pointer-events: none;
}

.filter-result {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
  padding: 12rpx 16rpx;
  background-color: #f0f9ff;
  border-radius: 6rpx;
  border-left: 4rpx solid #1890ff;
}
