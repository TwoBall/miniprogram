.club-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 社团信息卡片 */
.club-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 32rpx;
  color: #fff;
}

.club-info {
  margin-bottom: 32rpx;
}

.club-name-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.club-name {
  font-size: 40rpx;
  font-weight: 700;
}

.club-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  opacity: 0.9;
}

.teacher-name,
.department {
  font-size: 28rpx;
}

.stats-quick {
  display: flex;
  gap: 48rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.stat-item.warning {
  background-color: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
}

.stat-item.warning .stat-value {
  color: #fff;
}

.stat-item.warning .stat-label {
  color: rgba(255, 255, 255, 0.9);
}

/* Tab 切换 */
.tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #1890ff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #1890ff;
  border-radius: 3rpx;
}

/* 内容区域 */
.content {
  margin-top: 20rpx;
}

.loading-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

/* 学生卡片 */
.student-card {
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  overflow: hidden;
  transition: all 0.2s ease;
}

.student-card:active {
  transform: scale(0.98);
  background-color: #fafafa;
  border-color: #d0d0d0;
}

.student-info {
  width: 100%;
}

.student-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.name-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex-shrink: 0;
}

.warning-tag {
  flex-shrink: 0;
}

.student-meta {
  display: flex;
  gap: 32rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666;
}

/* 排行榜 */
.rank-list {
  padding: 0 32rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  transition: all 0.2s ease;
}

.rank-item:active {
  transform: scale(0.98);
  background-color: #fafafa;
  border-color: #d0d0d0;
}

.rank-item.top-rank {
  background: linear-gradient(135deg, #fff9e6 0%, #fff 100%);
  border: 2rpx solid #ffd700;
}

.rank-badge {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.rank-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #999;
}

.rank-number.first {
  color: #ffd700;
}

.rank-number.second {
  color: #c0c0c0;
}

.rank-number.third {
  color: #cd7f32;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rank-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rank-header .student-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.class-name {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.rank-stats {
  font-size: 24rpx;
  color: #999;
}

.rank-rate {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.rank-rate.excellent {
  background-color: #f0f9ff;
  color: #1890ff;
}

.rank-rate.good {
  background-color: #f0fdf4;
  color: #52c41a;
}

.rank-rate.normal {
  background-color: #fffbeb;
  color: #ff9800;
}

.rank-rate.poor {
  background-color: #fef2f2;
  color: #ff4d4f;
}

.rate-value {
  font-size: 32rpx;
}
