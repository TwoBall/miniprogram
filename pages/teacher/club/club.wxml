<view class="student-list-container">
  <!-- 初始加载骨架屏 -->
  <block wx:if="{{ pageLoading }}">
    <skeleton type="list" count="{{6}}" avatar="{{true}}" />
  </block>

  <!-- 实际内容 -->
  <block wx:else>
  <!-- 社团信息卡片 -->
  <view class="list-header teacher-header fade-in-up">
    <view class="header-info">
      <view class="header-title-wrapper">
        <van-icon name="cluster-o" size="40rpx" color="#fff" />
        <text class="header-title">{{ clubInfo.name }}</text>
      </view>
      <view class="header-meta">
        <text class="header-meta-item">负责人：{{ clubInfo.teacher }}</text>
        <text class="header-meta-item">{{ clubInfo.department }}</text>
      </view>
    </view>
    <view class="header-stats">
      <view class="header-stat-item">
        <text class="header-stat-value">{{ stats.totalCount }}</text>
        <text class="header-stat-label">学生数</text>
      </view>
      <view class="header-stat-item" wx:if="{{ activeTab === 'rank' }}">
        <text class="header-stat-value">{{ stats.avgAttendanceRate }}%</text>
        <text class="header-stat-label">平均出勤率</text>
      </view>
      <view class="header-stat-item warning" wx:if="{{ activeTab === 'students' && stats.warningCount > 0 }}">
        <text class="header-stat-value">{{ stats.warningCount }}</text>
        <text class="header-stat-label">缺勤预警</text>
      </view>
    </view>
  </view>

  <!-- 学部班级筛选 -->
  <view class="filter-section" wx:if="{{ departments.length > 1 }}">
    <view class="filter-row">
      <!-- 学部选择 -->
      <view class="filter-picker icon-tap" bindtap="onShowDeptPicker">
        <view class="filter-picker-content">
          <text class="filter-label">学部</text>
          <view class="filter-value">
            <text>{{ selectedDepartment }}</text>
            <van-icon name="arrow-down" size="12px" color="#999" />
          </view>
        </view>
      </view>

      <!-- 班级选择 -->
      <view class="filter-picker icon-tap" bindtap="onShowClassPicker">
        <view class="filter-picker-content {{ selectedDepartment === '全部学部' ? 'disabled' : '' }}">
          <text class="filter-label">班级</text>
          <view class="filter-value">
            <text>{{ selectedClass }}</text>
            <van-icon name="arrow-down" size="12px" color="#999" />
          </view>
        </view>
      </view>

      <!-- 重置按钮 -->
      <view
        class="filter-reset icon-tap {{ selectedDepartment === '全部学部' && selectedClass === '全部班级' ? 'disabled' : '' }}"
        bindtap="onResetFilter"
      >
        <van-icon name="replay" size="14px" />
        <text>重置</text>
      </view>
    </view>

    <!-- 筛选结果统计 -->
    <view class="filter-result" wx:if="{{ selectedDepartment !== '全部学部' || selectedClass !== '全部班级' }}">
      <text>筛选结果：{{ filteredStudents.length }} 人</text>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="student-list-tabs">
    <view
      class="student-list-tab-item {{ activeTab === 'students' ? 'active' : '' }}"
      data-tab="students"
      bindtap="onTabChange"
    >
      <van-icon name="friends-o" size="36rpx" />
      <text>学生名单</text>
    </view>
    <view
      class="student-list-tab-item {{ activeTab === 'rank' ? 'active' : '' }}"
      data-tab="rank"
      bindtap="onTabChange"
    >
      <van-icon name="bar-chart-o" size="36rpx" />
      <text>出勤排行</text>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="student-list-search" wx:if="{{ activeTab === 'students' }}">
    <van-search
      value="{{ searchValue }}"
      placeholder="搜索学生姓名或班级"
      bind:search="onSearch"
      bind:clear="onSearchClear"
      bind:change="onSearch"
    />
  </view>

  <!-- 学生名单 -->
  <view wx:if="{{ activeTab === 'students' }}" class="student-list-content">
    <view wx:if="{{ loading }}" class="student-list-loading">
      <van-loading type="spinner" size="48rpx">加载中...</van-loading>
    </view>

    <scroll-view
      wx:elif="{{ filteredStudents.length > 0 }}"
      class="student-list-scroll"
      scroll-y
      bindscroll="onVirtualScroll"
      style="height: calc(100vh - 420rpx);"
    >
      <view class="student-list-wrapper" style="height: {{totalHeight}}px; position: relative;">
        <view style="transform: translateY({{offsetY}}px);">
          <view
            wx:for="{{ virtualList }}"
            wx:key="_id"
            class="student-card card-tap"
            bindtap="onStudentTap"
            bindlongpress="onStudentLongPress"
            data-student="{{ item }}"
          >
            <view class="student-card-avatar">
              <van-icon name="user-circle-o" size="40px" color="#1890ff" />
            </view>
            <view class="student-card-info">
              <view class="student-card-header">
                <view class="student-card-name-wrapper">
                  <text class="student-card-name">{{ item.studentName }}</text>
                  <van-tag
                    wx:if="{{ warningStudentIds.includes(item._id) }}"
                    type="danger"
                    plain
                    size="medium"
                  >
                    <van-icon name="warning-o" size="14px" />
                    缺勤预警
                  </van-tag>
                </view>
                <van-tag type="primary" plain size="medium">{{ item.className }}</van-tag>
              </view>
              <view class="student-card-meta">
                <view class="student-card-meta-item">
                  <van-icon name="location-o" size="28rpx" color="#999" />
                  <text>{{ item.department }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <empty-state
      wx:else
      type="students"
    />
  </view>

  <!-- 出勤率排行 -->
  <view wx:if="{{ activeTab === 'rank' }}" class="student-list-content">
    <view wx:if="{{ loading }}" class="student-list-loading">
      <van-loading type="spinner" size="48rpx">加载中...</van-loading>
    </view>

    <view wx:elif="{{ attendanceRank.length > 0 }}" class="student-rank-list">
      <view
        wx:for="{{ attendanceRank }}"
        wx:key="studentName"
        class="student-rank-item {{ index < 3 ? 'top-rank' : '' }}"
      >
        <view class="student-rank-badge">
          <text class="student-rank-number {{ index === 0 ? 'first' : index === 1 ? 'second' : index === 2 ? 'third' : '' }}">{{ index + 1 }}</text>
        </view>
        <view class="student-rank-info">
          <view class="student-rank-header">
            <text class="student-rank-name">{{ item.studentName }}</text>
            <text class="student-rank-class">{{ item.className }}</text>
          </view>
          <view class="student-rank-stats">
            <text>到课 {{ item.present }} / 总计 {{ item.total }} 次</text>
          </view>
        </view>
        <view class="student-rank-rate {{ item.rate >= 90 ? 'excellent' : item.rate >= 80 ? 'good' : item.rate >= 60 ? 'normal' : 'poor' }}">
          <text class="student-rank-rate-value">{{ item.rate }}%</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:else
      type="attendance"
    />
  </view>

  <van-toast id="van-toast" />

  <!-- 学生操作菜单 -->
  <van-action-sheet
    show="{{ showStudentActions }}"
    actions="{{ studentActions }}"
    cancel-text="取消"
    description="{{ currentStudent.studentName || '' }}"
    bind:select="onStudentActionSelect"
    bind:close="onStudentActionClose"
    bind:cancel="onStudentActionClose"
  />

  <!-- 学部选择弹出层 -->
  <van-popup show="{{ showDeptPicker }}" position="bottom" bind:close="onDeptPickerClose">
    <van-picker
      show-toolbar
      title="选择学部"
      columns="{{ departments }}"
      bind:confirm="onDeptPickerConfirm"
      bind:cancel="onDeptPickerClose"
    />
  </van-popup>

  <!-- 班级选择弹出层 -->
  <van-popup show="{{ showClassPicker }}" position="bottom" bind:close="onClassPickerClose">
    <van-picker
      show-toolbar
      title="选择班级"
      columns="{{ classes }}"
      bind:confirm="onClassPickerConfirm"
      bind:cancel="onClassPickerClose"
    />
  </van-popup>
  </block>
</view>
