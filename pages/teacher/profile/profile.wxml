<!-- 教师个人中心 - 教育杂志风 -->
<view class="ed-page ed-profile-page">
  <!-- Hero 头部 -->
  <view class="ed-hero ed-hero-teacher fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="manager-o" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>个人中心</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">我的</text>
      </view>
    </view>
  </view>

  <!-- 用户信息卡片 -->
  <view class="ed-user-card card-pop-in">
    <view class="ed-user-header">
      <view class="ed-user-avatar teacher">
        <van-icon name="manager-o" size="48rpx" color="#fff" />
      </view>
      <view class="ed-user-info">
        <view class="ed-user-name">{{ userInfo.userName || '未登录' }}</view>
        <view class="ed-user-role teacher">
          <van-icon name="manager-o" size="24rpx" />
          <text>社团老师</text>
        </view>
      </view>
    </view>
    <view class="ed-user-details">
      <view wx:if="{{ userInfo.clubName }}" class="ed-detail-item">
        <van-icon name="cluster-o" size="24rpx" />
        <text>{{ userInfo.clubName }}</text>
      </view>
      <view wx:if="{{ userInfo.department }}" class="ed-detail-item">
        <van-icon name="location-o" size="24rpx" />
        <text>{{ userInfo.department }}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="ed-menu-section">
    <view class="ed-menu-group">
      <view
        wx:for="{{ menuList }}"
        wx:key="id"
        class="ed-menu-item card-tap"
        data-url="{{ item.url }}"
        data-action="{{ item.action }}"
        bindtap="onMenuTap"
      >
        <view class="ed-menu-icon {{ item.iconType || 'primary' }}">
          <van-icon name="{{ item.icon }}" size="32rpx" color="{{ item.iconColor || '#1a365d' }}" />
        </view>
        <view class="ed-menu-content">
          <text class="ed-menu-title">{{ item.text }}</text>
        </view>
        <view class="ed-menu-right">
          <view wx:if="{{ item.showBadge && unreadCount > 0 }}" class="ed-menu-badge">
            {{ unreadCount > 99 ? '99+' : unreadCount }}
          </view>
          <van-icon name="arrow" size="28rpx" color="#a0aec0" />
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="ed-logout-section">
    <view class="ed-logout-btn card-tap" bindtap="onLogout">
      <van-icon name="revoke" size="32rpx" color="#c53030" />
      <text>退出登录</text>
    </view>
  </view>

  <!-- 底部 TabBar -->
  <custom-tabbar role="teacher" active="{{ tabIndex }}" />

  <van-dialog id="van-dialog" />
</view>
