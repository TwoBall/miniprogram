.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

.user-info {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  padding: 60rpx 40rpx;
  color: #fff;
  display: flex;
  align-items: center;
}

.avatar {
  margin-right: 30rpx;
}

.user-details {
  flex: 1;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.role-tag {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.role-tag text {
  margin-left: 8rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.9;
}

.info-item text {
  margin-left: 8rpx;
}

.menu-section {
  margin-top: 20rpx;
}
