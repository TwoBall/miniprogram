<!-- 历史记录页 - 教育杂志风 -->
<view class="ed-page ed-history-page">
  <!-- 顶部信息栏 - Editorial Hero -->
  <view class="ed-hero ed-hero-teacher fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="notes-o" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>点名记录</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">历史记录</text>
      </view>
      <view class="ed-hero-divider"></view>
      <view class="ed-hero-meta">
        <view class="ed-meta-item" wx:if="{{records.length > 0}}">
          <van-icon name="records" size="26rpx" />
          <text>共 {{totalCount || records.length}} 条记录</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{pageLoading}}" class="ed-skeleton-wrapper">
    <skeleton type="history-card" count="{{4}}" />
  </view>

  <!-- 记录列表 -->
  <view class="ed-section" wx:elif="{{records.length > 0}}">
    <view class="ed-section-header">
      <view class="ed-section-title">
        <text class="ed-section-num">01</text>
        <text class="ed-section-text">点名记录</text>
      </view>
    </view>

    <view class="ed-card-list">
      <view
        class="ed-record-card list-item-enter card-tap"
        wx:for="{{records}}"
        wx:key="_id"
        bindtap="viewDetail"
        data-record="{{item}}"
      >
        <!-- 左侧日期标签 -->
        <view class="ed-date-badge">
          <text class="ed-date-day">{{item.dateDay || '--'}}</text>
          <text class="ed-date-month">{{item.dateMonth || '--'}}</text>
        </view>

        <view class="ed-card-body">
          <view class="ed-card-header">
            <view class="ed-record-main">
              <text class="ed-record-date">{{item.date}}</text>
              <text class="ed-record-time">{{item.time}}</text>
            </view>
          </view>

          <view class="ed-record-teacher" wx:if="{{item.teacherName}}">
            <van-icon name="manager-o" size="24rpx" color="#718096" />
            <text class="ed-teacher-label">点名老师：</text>
            <text class="ed-teacher-name">{{item.teacherName}}</text>
          </view>

          <view class="ed-record-stats">
            <view class="ed-stat-item">
              <text class="ed-stat-label">总人数</text>
              <text class="ed-stat-value">{{item.totalCount}}</text>
            </view>
            <view class="ed-stat-item ed-stat-success">
              <text class="ed-stat-label">到课</text>
              <text class="ed-stat-value">{{item.presentCount}}</text>
            </view>
            <view class="ed-stat-item ed-stat-error">
              <text class="ed-stat-label">缺课</text>
              <text class="ed-stat-value">{{item.absentCount}}</text>
            </view>
          </view>
        </view>

        <view class="ed-card-arrow">
          <van-icon name="arrow" size="28rpx" color="#a0aec0" />
        </view>
      </view>
    </view>

    <!-- 加载更多提示 -->
    <view class="ed-load-more" wx:if="{{loading && !pageLoading}}">
      <van-loading size="24px">加载中...</van-loading>
    </view>
    <view class="ed-no-more" wx:elif="{{!hasMore}}">
      <text>— 没有更多了 —</text>
    </view>
  </view>

  <empty-state wx:if="{{!pageLoading && records.length === 0}}" type="history" />

  <van-toast id="van-toast" />
</view>
