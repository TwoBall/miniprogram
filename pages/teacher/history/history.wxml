<view class="history-container">
  <!-- 顶部信息栏 -->
  <view class="header-section">
    <view class="header-top">
      <view class="club-info">
        <van-icon name="notes-o" size="40rpx" color="#ffffff" />
        <text class="club-name">历史记录</text>
      </view>
    </view>
  </view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{pageLoading}}" class="skeleton-wrapper">
    <skeleton type="history-card" count="{{4}}" />
  </view>

  <!-- 记录列表 -->
  <view class="record-list" wx:elif="{{records.length > 0}}">
    <view class="card record-card" wx:for="{{records}}" wx:key="_id" bindtap="viewDetail" data-record="{{item}}">
      <view class="record-header">
        <view class="date">{{item.date}}</view>
        <view class="time">{{item.time}}</view>
      </view>

      <view class="record-info" wx:if="{{item.teacherName}}">
        <text class="teacher-label">点名老师：</text>
        <text class="teacher-name">{{item.teacherName}}</text>
      </view>

      <view class="record-stats">
        <view class="stat-item">
          <text class="label">总人数：</text>
          <text class="value">{{item.totalCount}}</text>
        </view>
        <view class="stat-item">
          <text class="label">到课：</text>
          <text class="value present">{{item.presentCount}}</text>
        </view>
        <view class="stat-item">
          <text class="label">缺课：</text>
          <text class="value absent">{{item.absentCount}}</text>
        </view>
      </view>

      <view class="arrow">›</view>
    </view>

    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{loading && !pageLoading}}">
      <van-loading size="24px">加载中...</van-loading>
    </view>
    <view class="no-more" wx:elif="{{!hasMore}}">
      <text>— 没有更多了 —</text>
    </view>
  </view>

  <van-empty wx:if="{{!pageLoading && records.length === 0}}" description="暂无历史记录" image="search" />
</view>

<van-toast id="van-toast" />
