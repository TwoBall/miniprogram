/* 历史记录页样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-history-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
}

/* ========== 骨架屏包装器 ========== */
.ed-skeleton-wrapper {
  padding: 24rpx;
}

/* ========== Hero 头部 - Teacher 深蓝主题 ========== */
.ed-hero-teacher {
  background: linear-gradient(165deg, #1a365d 0%, #2c5282 100%);
}

/* ========== 区域容器 ========== */
.ed-section {
  padding: 0 24rpx 100rpx;
}

.ed-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-top: 24rpx;
}

.ed-section-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ed-section-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-accent, #ed8936);
  font-family: 'Georgia', serif;
}

.ed-section-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gray-800, #2d3748);
  letter-spacing: 1rpx;
}

/* ========== 卡片列表 ========== */
.ed-card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ========== 记录卡片 ========== */
.ed-record-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  overflow: hidden;
  transition: all 0.2s ease;
}

/* 左侧日期标签 */
.ed-date-badge {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(165deg, var(--color-primary, #1a365d) 0%, var(--color-primary-light, #2c5282) 100%);
  flex-shrink: 0;
}

.ed-date-day {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
}

.ed-date-month {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

/* 卡片主体 */
.ed-card-body {
  flex: 1;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ed-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ed-record-main {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.ed-record-date {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-900, #1a202c);
}

.ed-record-time {
  font-size: 24rpx;
  color: var(--gray-500, #a0aec0);
}

/* 老师信息 */
.ed-record-teacher {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.ed-teacher-label {
  color: var(--gray-500, #a0aec0);
}

.ed-teacher-name {
  color: var(--gray-700, #4a5568);
  font-weight: 500;
}

/* 统计信息 */
.ed-record-stats {
  display: flex;
  gap: 32rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--gray-200, #edf2f7);
}

.ed-stat-item {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.ed-stat-label {
  font-size: 22rpx;
  color: var(--gray-500, #a0aec0);
}

.ed-stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gray-700, #4a5568);
}

.ed-stat-item.ed-stat-success .ed-stat-value {
  color: var(--color-success, #38a169);
}

.ed-stat-item.ed-stat-error .ed-stat-value {
  color: var(--color-error, #c53030);
}

/* 右侧箭头 */
.ed-card-arrow {
  display: flex;
  align-items: center;
  padding-right: 16rpx;
}

/* ========== 加载更多和没有更多 ========== */
.ed-load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.ed-no-more {
  text-align: center;
  padding: 32rpx 0;
  color: var(--gray-400, #cbd5e0);
  font-size: 24rpx;
}
