/* 历史记录页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */
/* 使用公共类: .page-container, .card, .stat-item, .load-more, .no-more */

.history-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 社团信息 */
.club-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.club-name {
  font-size: 40rpx;
  font-weight: bold;
}

/* 记录列表 */
.record-list {
  padding: 20rpx;
  padding-bottom: 100rpx;
}

/* 记录卡片 - 继承公共 .card，仅覆盖特有样式 */
.record-card {
  position: relative;
  padding: 30rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.date {
  font-size: 32rpx;
  font-weight: 500;
}

.time {
  font-size: 28rpx;
  color: #999999;
}

.record-info {
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.teacher-label {
  color: #999999;
}

.teacher-name {
  color: #666666;
  font-weight: 500;
}

.record-stats {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  font-size: 28rpx;
}

.label {
  color: #999999;
}

.value {
  color: #333333;
  font-weight: 500;
}

.present {
  color: #52c41a;
}

.absent {
  color: #ff4d4f;
}

.arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #cccccc;
}
