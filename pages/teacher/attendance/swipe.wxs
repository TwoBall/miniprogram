/**
 * 滑动手势处理 WXS 模块
 * 在视图层直接处理触摸事件，避免逻辑层通信延迟
 * 参考：https://developers.weixin.qq.com/miniprogram/dev/framework/view/interactive-animation.html
 */

// 状态变量
var startX = 0
var startY = 0
var isHorizontalSwipe = false

/**
 * 触摸开始事件处理
 */
function handleTouchStart(event, ownerInstance) {
  var touch = event.touches[0]
  startX = touch.clientX
  startY = touch.clientY
  isHorizontalSwipe = false
  
  // 通知逻辑层记录起始位置（用于后续判断）
  ownerInstance.callMethod('onWxsTouchStart', {
    startX: startX,
    startY: startY
  })
  
  return false
}

/**
 * 触摸移动事件处理
 * 在视图层直接更新样式，实现流畅动画
 */
function handleTouchMove(event, ownerInstance) {
  var touch = event.touches[0]
  var moveX = touch.clientX - startX
  var moveY = touch.clientY - startY
  
  // 首次移动时判断滑动方向
  if (!isHorizontalSwipe && Math.abs(moveX) < 10 && Math.abs(moveY) < 10) {
    return false
  }
  
  // 如果是垂直滑动，不处理
  if (!isHorizontalSwipe && Math.abs(moveY) > Math.abs(moveX)) {
    return false
  }
  
  isHorizontalSwipe = true
  
  // 计算旋转角度和透明度
  var rotation = moveX * 0.05
  var presentOpacity = moveX > 0 ? Math.min(moveX / 100, 1) : 0
  var absentOpacity = moveX < 0 ? Math.min(-moveX / 100, 1) : 0
  
  // 获取卡片元素并直接设置样式
  var card = ownerInstance.selectComponent('.card-current')
  var presentHint = ownerInstance.selectComponent('.present-indicator')
  var absentHint = ownerInstance.selectComponent('.absent-indicator')
  
  if (card) {
    card.setStyle({
      'transform': 'translateX(' + moveX + 'px) rotate(' + rotation + 'deg)',
      'transition': 'none'
    })
  }
  
  if (presentHint) {
    presentHint.setStyle({
      'opacity': presentOpacity
    })
  }
  
  if (absentHint) {
    absentHint.setStyle({
      'opacity': absentOpacity
    })
  }
  
  // 添加滑动方向 class
  if (moveX > 50) {
    card && card.addClass('swiping-right')
    card && card.removeClass('swiping-left')
  } else if (moveX < -50) {
    card && card.addClass('swiping-left')
    card && card.removeClass('swiping-right')
  } else {
    card && card.removeClass('swiping-right')
    card && card.removeClass('swiping-left')
  }
  
  return false
}

/**
 * 触摸结束事件处理
 */
function handleTouchEnd(event, ownerInstance) {
  var touch = event.changedTouches[0]
  var moveX = touch.clientX - startX
  
  // 通知逻辑层处理滑动结果
  ownerInstance.callMethod('onWxsTouchEnd', {
    moveX: moveX,
    threshold: 100
  })
  
  // 重置状态
  isHorizontalSwipe = false
  
  return false
}

/**
 * 重置卡片样式（由逻辑层调用）
 */
function resetCard(newValue, oldValue, ownerInstance) {
  if (newValue) {
    var card = ownerInstance.selectComponent('.card-current')
    var presentHint = ownerInstance.selectComponent('.present-indicator')
    var absentHint = ownerInstance.selectComponent('.absent-indicator')
    
    if (card) {
      card.setStyle({
        'transform': 'translateX(0) rotate(0)',
        'transition': 'all 0.3s ease'
      })
      card.removeClass('swiping-right')
      card.removeClass('swiping-left')
    }
    
    if (presentHint) {
      presentHint.setStyle({ 'opacity': 0 })
    }
    
    if (absentHint) {
      absentHint.setStyle({ 'opacity': 0 })
    }
  }
}

/**
 * 滑出动画（由逻辑层调用）
 */
function swipeOut(newValue, oldValue, ownerInstance) {
  if (!newValue) return
  
  var card = ownerInstance.selectComponent('.card-current')
  var presentHint = ownerInstance.selectComponent('.present-indicator')
  var absentHint = ownerInstance.selectComponent('.absent-indicator')
  
  var direction = newValue.direction // 'left' 或 'right'
  var translateX = direction === 'right' ? 500 : -500
  var rotation = direction === 'right' ? 30 : -30
  
  if (card) {
    card.setStyle({
      'transform': 'translateX(' + translateX + 'px) rotate(' + rotation + 'deg)',
      'transition': 'all 0.3s ease'
    })
  }
  
  if (direction === 'right' && presentHint) {
    presentHint.setStyle({ 'opacity': 1 })
  }
  
  if (direction === 'left' && absentHint) {
    absentHint.setStyle({ 'opacity': 1 })
  }
}

module.exports = {
  handleTouchStart: handleTouchStart,
  handleTouchMove: handleTouchMove,
  handleTouchEnd: handleTouchEnd,
  resetCard: resetCard,
  swipeOut: swipeOut
}