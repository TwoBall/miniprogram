/* 页面容器 */
.attendance-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 社团信息 */
.club-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.club-name {
  font-size: 40rpx;
  font-weight: bold;
}

.date-time {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.remaining-info {
  font-size: 28rpx;
  opacity: 0.85;
}

/* 非上课日提示 */
.no-class-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 60rpx 30rpx;
}

.no-class-tips {
  margin-top: 30rpx;
  padding: 20rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
  text-align: center;
}

.no-class-tips text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 点名完成提示 */
.complete-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

.complete-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.complete-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.complete-stats {
  display: flex;
  gap: 40rpx;
}

.present-stat {
  font-size: 32rpx;
  color: #07c160;
  font-weight: 500;
}

.absent-stat {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: 500;
}

/* 卡片堆叠区 */
.card-stack {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  padding: 20rpx;
  min-height: 600rpx;
}

/* 学生卡片基础样式 */
.student-card {
  position: absolute;
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 60rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

/* 背景卡片（第3张） */
.card-bg-2 {
  transform: scale(0.9) translateY(40rpx);
  opacity: 0.5;
  z-index: 1;
}

/* 背景卡片（第2张） */
.card-bg-1 {
  transform: scale(0.95) translateY(20rpx);
  opacity: 0.75;
  z-index: 2;
}

/* 当前卡片 */
.card-current {
  z-index: 10;
  transition: transform 0.1s ease-out;
}

/* 卡片内容 */
.card-content {
  padding: 50rpx 40rpx;
  text-align: center;
}

/* 头像区域 */
.student-avatar {
  margin-bottom: 30rpx;
}

.avatar-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.avatar-circle.male {
  background: linear-gradient(135deg, #1F6FAD 0%, #2E8B9A 100%);
}

.avatar-circle.female {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

/* 学生姓名 */
.student-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

/* 性别标签 */
.student-gender {
  margin-bottom: 30rpx;
}

/* 学生信息 */
.student-info {
  text-align: left;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

/* 滑动反馈指示器 */
.swipe-indicator {
  position: absolute;
  top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 20;
  pointer-events: none;
}

.swipe-indicator text {
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 10rpx;
}

.present-indicator {
  right: 40rpx;
  color: #07c160;
  transform: rotate(15deg);
}

.absent-indicator {
  left: 40rpx;
  color: #ff4d4f;
  transform: rotate(-15deg);
}

/* 滑动中的卡片边框效果 */
.swiping-right {
  border: 4rpx solid #07c160;
}

.swiping-left {
  border: 4rpx solid #ff4d4f;
}

/* 底部操作按钮 */
.action-section {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 50rpx;
  padding: 30rpx;
}

.action-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s, box-shadow 0.2s;
}

.action-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.present-btn {
  border: 4rpx solid #07c160;
}

.absent-btn {
  border: 4rpx solid #ff4d4f;
}

.undo-btn {
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid #ddd;
}

/* 底部进度栏 */
.progress-section {
  background: #ffffff;
  border-top: 1rpx solid #eee;
  padding: 20rpx 30rpx 40rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-stats {
  display: flex;
  gap: 30rpx;
}

.stat-item-inline {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.stat-num.present {
  color: #07c160;
}

.stat-num.absent {
  color: #ff4d4f;
}

.stat-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.progress-actions {
  display: flex;
  gap: 16rpx;
}


/* 已点名学生列表 */
.marked-list {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.marked-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.marked-students-scroll {
  max-height: 300rpx;
  margin-top: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.marked-student-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.marked-student-item:last-child {
  border-bottom: none;
}

.marked-student-info {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.marked-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.marked-class {
  font-size: 24rpx;
  color: #999;
}

/* 滑出动画 */
.swipe-out-right {
  animation: swipeOutRight 0.3s ease forwards;
}

.swipe-out-left {
  animation: swipeOutLeft 0.3s ease forwards;
}

@keyframes swipeOutRight {
  to {
    transform: translateX(200%) rotate(30deg);
    opacity: 0;
  }
}

@keyframes swipeOutLeft {
  to {
    transform: translateX(-200%) rotate(-30deg);
    opacity: 0;
  }
}
