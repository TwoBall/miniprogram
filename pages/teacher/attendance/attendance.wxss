/* 筛选区域样式 */
.filter-section {
  padding: 20rpx 30rpx;
}

.dept-scroll {
  display: flex;
  white-space: nowrap;
  height: 64rpx;
}

.dept-tag {
  display: inline-block;
  padding: 10rpx 32rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.dept-tag.active {
  background-color: #e6f7ff;
  color: #1890ff;
  border-color: #1890ff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.15);
}

/* 统计卡片样式 */
.stats-card {
  margin: 0 30rpx 30rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-num.present { color: #07c160; }
.stat-num.absent { color: #ff4d4f; }

.stat-desc {
  font-size: 24rpx;
  color: #999;
}

/* 一键全到按钮 */
.quick-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding-left: 30rpx;
  border-left: 2rpx solid #eee;
  min-width: 120rpx;
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.2);
}

.quick-action text {
  font-size: 22rpx;
  color: #1890ff;
  font-weight: 500;
}

.student-list {
  padding: 0 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 学生卡片样式 */
.student-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-left {
  flex: 1;
  padding-right: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.student-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.gender-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.gender-badge.male {
  background-color: #e6f7ff;
  color: #1890ff;
}

.gender-badge.female {
  background-color: #fff0f6;
  color: #eb2f96;
}

.sub-info {
  font-size: 24rpx;
  color: #666;
}

.divider {
  margin: 0 10rpx;
  color: #ddd;
}

.teacher-info {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.phone-link {
  color: #1890ff;
  margin-left: 10rpx;
  text-decoration: underline;
}

/* 操作按钮样式 */
.card-right {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.action-buttons {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 4rpx;
  gap: 4rpx;
}

.status-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #999;
  transition: all 0.2s;
}

.status-btn van-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.status-btn.present.active {
  background-color: #fff;
  color: #07c160;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.1);
  font-weight: 500;
}

.status-btn.absent.active {
  background-color: #fff;
  color: #ff4d4f;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.1);
  font-weight: 500;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx 50rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.attendance-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.header-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: #ffffff;
}

.club-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.club-name {
  font-size: 40rpx;
  font-weight: bold;
}

.date-time {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.stats-section {
  margin: -40rpx 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.stat-content {
  padding: 30rpx 0;
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #333333;
}

.stat-number.present {
  color: #07c160;
}

.stat-number.absent {
  color: #ee0a24;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.student-list {
  margin: 0 30rpx;
}

.student-cell {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.student-info {
  flex: 1;
}

.student-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.gender-tag {
  font-size: 24rpx;
  color: #666666;
  background-color: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.student-class {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.student-club {
  font-size: 24rpx;
  color: #1890ff;
  margin-bottom: 4rpx;
}

.teacher-info {
  font-size: 22rpx;
  color: #666666;
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}

.teacher-phone {
  color: #07c160;
}

.attendance-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  min-width: 120rpx !important;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}
