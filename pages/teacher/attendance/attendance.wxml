
<view class="attendance-container">
  <!-- 顶部信息栏 -->
  <view class="header-section">
    <view class="header-top">
      <view class="club-info">
        <van-icon name="friends-o" size="40rpx" color="#ffffff" />
        <text class="club-name">{{clubName}}</text>
      </view>
    </view>
    <view class="date-time">
      <van-icon name="clock-o" size="28rpx" color="rgba(255,255,255,0.9)" />
      <text>{{currentDate}} {{currentTime}}</text>
    </view>
    <view class="remaining-info" wx:if="{{isClassDay}}">
      <text>剩余 {{remainingCount}} 人</text>
    </view>
  </view>

  <!-- 非上课日提示 -->
  <view class="no-class-section" wx:if="{{!isClassDay}}">
    <van-empty
      image="search"
      description="{{noClassMessage}}"
    />
    <view class="no-class-tips">
      <text>上课时间：周二（职教一部、职教二部）、周四（医药护理部）</text>
    </view>
  </view>

  <!-- 卡片区域（仅上课日显示） -->
  <block wx:if="{{isClassDay}}">
    <!-- 加载骨架屏 -->
    <view wx:if="{{pageLoading}}" class="skeleton-wrapper">
      <skeleton type="attendance-card" count="{{1}}" />
    </view>

    <!-- 已完成提示 -->
    <view class="complete-section" wx:if="{{!pageLoading && currentIndex >= students.length && students.length > 0}}">
      <view class="complete-icon">🎉</view>
      <view class="complete-text">点名完成！</view>
      <view class="complete-stats">
        <text class="present-stat">到课 {{presentCount}} 人</text>
        <text class="absent-stat">缺课 {{absentCount}} 人</text>
      </view>
    </view>

    <!-- 引入 WXS 模块 -->
    <wxs module="swipe" src="./swipe.wxs" />
  
      <!-- 卡片堆叠区 -->
      <view class="card-stack" wx:if="{{!pageLoading && currentIndex < students.length}}">
        <!-- 背景卡片（第3张） -->
        <view class="student-card card-bg-2" wx:if="{{currentIndex + 2 < students.length}}">
          <view class="card-content">
            <view class="student-avatar">
              <van-icon name="user-o" size="80rpx" color="#ccc" />
            </view>
          </view>
        </view>
  
        <!-- 背景卡片（第2张） -->
        <view class="student-card card-bg-1" wx:if="{{currentIndex + 1 < students.length}}">
          <view class="card-content">
            <view class="student-avatar">
              <van-icon name="user-o" size="80rpx" color="#999" />
            </view>
          </view>
        </view>
  
        <!-- 当前卡片（可滑动） -->
        <view
          class="student-card card-current {{swipeDirection}}"
          style="{{cardStyle}}"
          bindtouchstart="{{swipe.touchStart}}"
          bindtouchmove="{{swipe.touchMove}}"
          bindtouchend="{{swipe.touchEnd}}"
        >
          <!-- 滑动反馈图标 -->
          <view class="swipe-indicator present-indicator" style="opacity: {{presentOpacity}}">
            <van-icon name="success" size="120rpx" color="#52c41a" />
            <text>到课</text>
          </view>
          <view class="swipe-indicator absent-indicator" style="opacity: {{absentOpacity}}">
            <van-icon name="cross" size="120rpx" color="#ff4d4f" />
            <text>缺课</text>
          </view>

        <!-- 卡片内容 -->
        <view class="card-content">
          <view class="student-avatar">
            <view class="avatar-circle {{currentStudent.gender === '男' ? 'male' : 'female'}}">
              <van-icon name="{{currentStudent.gender === '男' ? 'friends' : 'friends-o'}}" size="80rpx" color="#fff" />
            </view>
          </view>
          <view class="student-name">{{currentStudent.studentName}}</view>
          <view class="student-gender">
            <van-tag plain type="{{currentStudent.gender === '男' ? 'primary' : 'danger'}}">{{currentStudent.gender}}</van-tag>
          </view>
          <view class="student-info">
            <view class="info-item">
              <van-icon name="location-o" size="28rpx" />
              <text>{{currentStudent.department}}</text>
            </view>
            <view class="info-item">
              <van-icon name="home-o" size="28rpx" />
              <text>{{currentStudent.className}}</text>
            </view>
            <view class="info-item" wx:if="{{currentStudent.classTeacher}}">
              <van-icon name="manager-o" size="28rpx" />
              <text>班主任：{{currentStudent.classTeacher}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作按钮 -->
    <view class="action-section" wx:if="{{!pageLoading && currentIndex < students.length}}">
      <view class="action-btn absent-btn" bindtap="markAbsentByBtn">
        <van-icon name="cross" size="56rpx" color="#ff4d4f" />
      </view>
      <view class="action-btn undo-btn {{currentIndex === 0 ? 'disabled' : ''}}" bindtap="undoLast">
        <van-icon name="revoke" size="40rpx" color="{{currentIndex === 0 ? '#ccc' : '#999'}}" />
      </view>
      <view class="action-btn present-btn" bindtap="markPresentByBtn">
        <van-icon name="success" size="56rpx" color="#52c41a" />
      </view>
    </view>

    <!-- 底部进度栏 -->
    <view class="progress-section" wx:if="{{!pageLoading}}">
      <!-- 统计信息和操作按钮 -->
      <view class="progress-header">
        <view class="progress-stats">
          <view class="stat-item-inline">
            <text class="stat-num present">{{presentCount}}</text>
            <text class="stat-text">到课</text>
          </view>
          <view class="stat-item-inline">
            <text class="stat-num absent">{{absentCount}}</text>
            <text class="stat-text">缺课</text>
          </view>
          <view class="stat-item-inline">
            <text class="stat-num">{{students.length - currentIndex}}</text>
            <text class="stat-text">剩余</text>
          </view>
        </view>
        <view class="progress-actions">
          <van-button 
            size="small" 
            plain
            type="primary"
            bindtap="markAllPresent"
            disabled="{{currentIndex >= students.length}}"
          >一键全到</van-button>
          <van-button 
            size="small" 
            type="info" 
            bindtap="submitAttendance"
            disabled="{{currentIndex < students.length}}"
            loading="{{loading}}"
          >提交</van-button>
        </view>
      </view>

      <!-- 已点名学生列表 -->
      <view class="marked-list" wx:if="{{currentIndex > 0}}" bindtap="toggleMarkedList">
        <view class="marked-list-header">
          <text>已点名学生 ({{currentIndex}}人)</text>
          <van-icon name="{{showMarkedList ? 'arrow-up' : 'arrow-down'}}" />
        </view>
      </view>

      <!-- 展开的已点名列表 -->
      <scroll-view scroll-y class="marked-students-scroll" wx:if="{{showMarkedList && currentIndex > 0}}">
        <view class="marked-student-item" 
              wx:for="{{markedStudents}}" 
              wx:key="index"
              data-index="{{index}}"
              bindtap="toggleMarkedStudentStatus">
          <view class="marked-student-info">
            <text class="marked-name">{{item.studentName}}</text>
            <text class="marked-class">{{item.className}}</text>
          </view>
          <view class="status-toggle">
            <van-tag type="{{item.status === 'present' ? 'success' : 'danger'}}">
              {{item.status === 'present' ? '到课' : '缺课'}}
            </van-tag>
            <van-icon name="exchange" size="28rpx" color="#999" class="toggle-icon" />
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <van-toast id="van-toast" />
  <van-dialog id="van-dialog" />

  <!-- 底部 TabBar -->
  <custom-tabbar role="teacher" active="0" />
</view>
