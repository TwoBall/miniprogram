<!-- 点名详情页 - 教育杂志风 -->
<view class="ed-page ed-detail-page">
  <!-- 顶部信息栏 - Editorial Hero -->
  <view class="ed-hero ed-hero-teacher fade-in-up" wx:if="{{record}}">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="friends-o" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>点名详情</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">{{record.clubName}}</text>
      </view>
      <view class="ed-hero-divider"></view>
      <view class="ed-hero-meta">
        <view class="ed-meta-item">
          <van-icon name="clock-o" size="26rpx" />
          <text>{{record.date}} {{record.time}}</text>
        </view>
        <view class="ed-meta-item" wx:if="{{record.teacherName}}">
          <van-icon name="manager-o" size="26rpx" />
          <text>{{record.teacherName}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="ed-stats-grid" wx:if="{{record}}">
    <view class="ed-stat-card">
      <view class="ed-stat-icon">
        <van-icon name="friends-o" size="40rpx" color="#1a365d" />
      </view>
      <view class="ed-stat-info">
        <view class="ed-stat-number">{{record.records.length}}</view>
        <view class="ed-stat-label">总人数</view>
      </view>
    </view>
    <view class="ed-stat-card ed-stat-success">
      <view class="ed-stat-icon">
        <van-icon name="passed" size="40rpx" color="#38a169" />
      </view>
      <view class="ed-stat-info">
        <view class="ed-stat-number">{{presentCount}}</view>
        <view class="ed-stat-label">到课</view>
      </view>
    </view>
    <view class="ed-stat-card ed-stat-error">
      <view class="ed-stat-icon">
        <van-icon name="cross" size="40rpx" color="#c53030" />
      </view>
      <view class="ed-stat-info">
        <view class="ed-stat-number">{{absentCount}}</view>
        <view class="ed-stat-label">缺课</view>
      </view>
    </view>
  </view>

  <!-- 学生列表 -->
  <view class="ed-section" wx:if="{{record && record.records.length > 0}}">
    <view class="ed-section-header">
      <view class="ed-section-title">
        <text class="ed-section-num">01</text>
        <text class="ed-section-text">点名详情</text>
      </view>
      <view class="ed-section-tip">点击可修改状态</view>
    </view>

    <scroll-view
      scroll-y
      style="height: {{listHeight}}px;"
      bindscroll="onVirtualScroll"
      enhanced
      show-scrollbar="{{false}}"
    >
      <view style="height: {{totalHeight}}px; position: relative;">
        <view class="ed-student-list" style="transform: translateY({{offsetY}}px);">
          <view
            wx:for="{{virtualList}}"
            wx:key="studentId"
            class="ed-student-card card-tap"
            data-student-id="{{item.studentId}}"
            bindtap="toggleStudentStatus"
          >
            <!-- 左侧状态指示条 -->
            <view class="ed-card-indicator {{ item.status === 'present' ? 'success' : 'error' }}"></view>

            <view class="ed-card-body">
              <view class="ed-student-header">
                <view class="ed-student-main">
                  <view class="ed-student-avatar {{ item.status === 'present' ? 'present' : 'absent' }}">
                    <van-icon name="user-o" size="32rpx" color="#fff" />
                  </view>
                  <view class="ed-student-info">
                    <view class="ed-student-name-row">
                      <text class="ed-student-name">{{item.studentName}}</text>
                      <view wx:if="{{item.gender}}" class="ed-gender-tag {{ item.gender === '男' ? 'male' : 'female' }}">
                        {{item.gender}}
                      </view>
                    </view>
                    <text class="ed-student-class">{{item.department}} · {{item.className}}</text>
                  </view>
                </view>
              </view>

              <view class="ed-student-meta" wx:if="{{item.classTeacher}}">
                <view class="ed-meta-row">
                  <van-icon name="phone-o" size="22rpx" color="#718096" />
                  <text class="ed-meta-text">班主任: {{item.classTeacher}}</text>
                  <text wx:if="{{item.classTeacherPhone}}" class="ed-meta-phone">{{item.classTeacherPhone}}</text>
                </view>
              </view>

              <view class="ed-feedback-info" wx:if="{{item.feedback}}">
                <van-icon name="comment-o" size="22rpx" color="#dd6b20" />
                <text>班主任反馈: {{item.feedback}}</text>
              </view>
            </view>

            <view class="ed-status-toggle">
              <view class="ed-status-badge {{ item.status === 'present' ? 'success' : 'error' }}">
                {{item.status === 'present' ? '到课' : '缺课'}}
              </view>
              <van-icon name="exchange" size="28rpx" color="#a0aec0" />
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <empty-state
    wx:if="{{!loading && (!record || record.records.length === 0)}}"
    type="attendance"
  />

  <!-- 固定在底部的保存按钮 -->
  <view class="ed-save-section" wx:if="{{hasChanges}}">
    <van-button
      type="primary"
      block
      loading="{{saving}}"
      bindtap="saveChanges"
      custom-class="ed-btn-primary btn-active"
    >
      保存修改
    </van-button>
  </view>

  <van-toast id="van-toast" />
</view>
