<view class="detail-container">
  <view class="header-section fade-in-up" wx:if="{{record}}">
    <view class="club-info">
      <van-icon name="friends-o" size="40rpx" color="#ffffff" />
      <text class="club-name">{{record.clubName}}</text>
    </view>
    <view class="date-time">
      <van-icon name="clock-o" size="28rpx" color="rgba(255,255,255,0.9)" />
      <text>{{record.date}} {{record.time}}</text>
    </view>
    <view class="teacher-info">
      <van-icon name="manager-o" size="28rpx" color="rgba(255,255,255,0.9)" />
      <text>点名老师: {{record.teacherName}}</text>
    </view>
  </view>

  <view class="stats-section" wx:if="{{record}}">
    <van-grid column-num="3" border="{{ false }}">
      <van-grid-item use-slot>
        <view class="stat-content">
          <view class="stat-number">{{record.records.length}}</view>
          <view class="stat-label">总人数</view>
        </view>
      </van-grid-item>
      <van-grid-item use-slot>
        <view class="stat-content">
          <view class="stat-number present">{{presentCount}}</view>
          <view class="stat-label">到课</view>
        </view>
      </van-grid-item>
      <van-grid-item use-slot>
        <view class="stat-content">
          <view class="stat-number absent">{{absentCount}}</view>
          <view class="stat-label">缺课</view>
        </view>
      </van-grid-item>
    </van-grid>
  </view>

  <view class="student-list" wx:if="{{record && record.records.length > 0}}">
    <view class="list-title">点名详情 (点击可修改)</view>
    <scroll-view
      scroll-y
      style="height: {{listHeight}}px;"
      bindscroll="onVirtualScroll"
      enhanced
      show-scrollbar="{{false}}"
    >
      <view style="height: {{totalHeight}}px; position: relative;">
        <view class="student-list-wrapper" style="transform: translateY({{offsetY}}px);">
          <view
            wx:for="{{virtualList}}"
            wx:key="studentId"
            class="student-cell"
            data-student-id="{{item.studentId}}"
            bindtap="toggleStudentStatus"
          >
            <view class="student-info">
              <view class="student-name">
                <van-icon name="user-o" size="32rpx" color="#1890ff" />
                <text>{{item.studentName}}</text>
                <van-tag wx:if="{{item.gender}}" plain type="{{item.gender === '男' ? 'primary' : 'danger'}}" size="mini">{{item.gender}}</van-tag>
              </view>
              <view class="student-class">{{item.department}} · {{item.className}}</view>
              <view class="teacher-contact" wx:if="{{item.classTeacher}}">
                <text>班主任: {{item.classTeacher}}</text>
                <text wx:if="{{item.classTeacherPhone}}" class="phone">{{item.classTeacherPhone}}</text>
              </view>
              <view class="feedback-info" wx:if="{{item.feedback}}">
                <van-icon name="comment-o" size="24rpx" color="#faad14" />
                <text>班主任反馈: {{item.feedback}}</text>
              </view>
            </view>
            <view class="status-toggle">
              <van-tag
                type="{{ item.status === 'present' ? 'success' : 'danger' }}"
                size="large"
              >
                {{item.status === 'present' ? '到课' : '缺课'}}
              </van-tag>
              <van-icon name="exchange" size="32rpx" color="#999" />
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <empty-state
    wx:if="{{!loading && (!record || record.records.length === 0)}}"
    type="attendance"
  />

  <!-- 固定在底部的保存按钮 -->
  <view class="save-section-fixed" wx:if="{{hasChanges}}">
    <van-button type="primary" block loading="{{saving}}" bindtap="saveChanges" custom-class="btn-active">
      保存修改
    </van-button>
  </view>

  <van-toast id="van-toast" />
</view>
