.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header-section {
  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);
  padding: 40rpx 30rpx;
  color: #ffffff;
}

.club-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.club-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-left: 16rpx;
}

.date-time,
.teacher-info {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
}

.date-time text,
.teacher-info text {
  margin-left: 12rpx;
}

.stats-section {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat-content {
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.stat-number.present {
  color: #52c41a;
}

.stat-number.absent {
  color: #ff4d4f;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.student-list {
  margin: 20rpx;
}

.student-cell {
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
}

.student-info {
  flex: 1;
}

.student-name {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.student-name text {
  margin-left: 12rpx;
}

.gender-tag {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.student-class {
  font-size: 24rpx;
  color: #666;
  margin-left: 44rpx;
}

.teacher-contact {
  font-size: 22rpx;
  color: #999;
  margin-left: 44rpx;
  margin-top: 8rpx;
}

.teacher-contact .phone {
  margin-left: 16rpx;
  color: #1890ff;
}

.feedback-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  margin-left: 44rpx;
  font-size: 24rpx;
  color: #faad14;
  background: #fffbe6;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  width: fit-content;
}
