/* 点名详情页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */

.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 社团信息 */
.club-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.club-name {
  font-size: 40rpx;
  font-weight: bold;
}

.date-time,
.teacher-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
}

/* 学生列表 */
.student-list {
  margin-top: 20rpx;
}

.list-title {
  font-size: 28rpx;
  color: #969799;
  padding: 16rpx 32rpx;
}

.student-list-wrapper {
  padding: 0 24rpx;
}

.student-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.student-info {
  flex: 1;
}

.student-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.gender-tag {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.student-class {
  font-size: 24rpx;
  color: #666;
  margin-left: 44rpx;
}

.teacher-contact {
  font-size: 22rpx;
  color: #999;
  margin-left: 44rpx;
  margin-top: 8rpx;
}

.teacher-contact .phone {
  margin-left: 16rpx;
  color: #1F6FAD;
}

.feedback-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  margin-left: 44rpx;
  font-size: 24rpx;
  color: #faad14;
  background: #fffbe6;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.status-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 固定底部保存按钮 */
.save-section-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}
