/* 点名详情页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */

.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 社团信息 */
.club-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.club-name {
  font-size: 40rpx;
  font-weight: bold;
}

.date-time,
.teacher-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
}

/* 学生列表 */
.student-list {
  margin: 20rpx;
}

.student-cell {
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
}

.student-info {
  flex: 1;
}

.student-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.gender-tag {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.student-class {
  font-size: 24rpx;
  color: #666;
  margin-left: 44rpx;
}

.teacher-contact {
  font-size: 22rpx;
  color: #999;
  margin-left: 44rpx;
  margin-top: 8rpx;
}

.teacher-contact .phone {
  margin-left: 16rpx;
  color: #1F6FAD;
}

.feedback-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  margin-left: 44rpx;
  font-size: 24rpx;
  color: #faad14;
  background: #fffbe6;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  width: fit-content;
}
