/* 用户管理页样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-users-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== 骨架屏包装器 ========== */
.ed-skeleton-wrapper {
  padding: 24rpx;
}

/* ========== Hero 头部 - Admin 紫色主题 ========== */
.ed-hero-admin {
  background: linear-gradient(165deg, #553c9a 0%, #805ad5 100%);
}

/* ========== 搜索栏 ========== */
.ed-search-wrapper {
  padding: 0 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 10;
}

.ed-search-wrapper .ed-search {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* ========== Tab 切换 - 悬浮卡片样式 ========== */
.ed-tabs-wrapper {
  padding: 16rpx 24rpx;
}

.ed-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow-x: auto;
}

.ed-tab-item {
  flex: 1;
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  color: var(--gray-600, #718096);
  border-radius: 12rpx;
  transition: all 0.3s ease;
  font-weight: 500;
  white-space: nowrap;
}

.ed-tab-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary, #1a365d) 0%, var(--color-primary-light, #2c5282) 100%);
  box-shadow: 0 4rpx 16rpx rgba(26, 54, 93, 0.25);
}

/* ========== Tab 内容区 ========== */
.ed-tab-content {
  padding: 0 24rpx 24rpx;
  min-height: calc(100vh - 500rpx);
}

/* ========== 卡片列表 ========== */
.ed-card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ========== 用户卡片 ========== */
.ed-user-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  overflow: hidden;
  transition: all 0.2s ease;
}

/* 左侧状态指示条 */
.ed-card-indicator {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--gray-300, #e2e8f0);
}

.ed-card-indicator.success {
  background: var(--color-success, #38a169);
}

.ed-card-indicator.warning {
  background: var(--color-warning, #dd6b20);
}

.ed-card-indicator.default {
  background: var(--gray-400, #a0aec0);
}

/* 卡片主体 */
.ed-card-body {
  flex: 1;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ed-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ed-user-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 用户头像 */
.ed-user-avatar {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}

.ed-user-avatar.bound {
  background: linear-gradient(135deg, #276749 0%, #38a169 100%);
}

.ed-user-avatar.unbound {
  background: linear-gradient(135deg, #c05621 0%, #dd6b20 100%);
}

/* 用户信息 */
.ed-user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ed-user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ed-user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-900, #1a202c);
}

/* 状态标签 */
.ed-status-tag {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.ed-status-tag.success {
  background: var(--color-success-bg, #c6f6d5);
  color: var(--color-success, #38a169);
}

.ed-status-tag.warning {
  background: var(--color-warning-bg, #feebc8);
  color: var(--color-warning, #dd6b20);
}

.ed-status-tag.error {
  background: var(--color-error-bg, #fed7d7);
  color: var(--color-error, #c53030);
}

/* 角色标签 */
.ed-role-tag {
  font-size: 24rpx;
  color: var(--color-primary, #1a365d);
  font-weight: 500;
}

/* 卡片元信息 */
.ed-card-meta {
  padding-top: 8rpx;
}

.ed-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ed-meta-value {
  font-size: 24rpx;
  color: var(--gray-600, #718096);
}

/* 绑定状态 */
.ed-bind-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--gray-200, #edf2f7);
}

.ed-bind-status.bound {
  color: var(--color-success, #38a169);
}

.ed-bind-status.unbound {
  color: var(--color-warning, #dd6b20);
}

/* 右侧箭头 */
.ed-card-arrow {
  display: flex;
  align-items: center;
  padding-right: 16rpx;
}

/* ========== 滑动操作按钮 ========== */
.ed-swipe-actions {
  display: flex;
  height: 100%;
}

.ed-action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 100%;
  color: #fff;
  font-size: 22rpx;
  gap: 4rpx;
}

.ed-action-edit {
  background: var(--color-primary, #1a365d);
}

.ed-action-delete {
  background: var(--color-error, #c53030);
}

/* ========== 加载状态 ========== */
.ed-loading-center {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.ed-load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.ed-no-more {
  text-align: center;
  padding: 32rpx 0;
  color: var(--gray-400, #cbd5e0);
  font-size: 24rpx;
}

/* ========== 浮动操作按钮 ========== */
.ed-fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(200rpx + constant(safe-area-inset-bottom));
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  z-index: 100;
  transition: all 0.2s ease;
}

.ed-fab:active {
  transform: scale(0.9);
}

.ed-fab-admin {
  background: linear-gradient(135deg, var(--color-primary, #1a365d) 0%, var(--color-primary-light, #2c5282) 100%);
}
