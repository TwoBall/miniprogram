/* 用户管理页面样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */
/* 使用公共类: .page-container, .search-bar, .user-header, .user-name, .user-meta, .meta-text */
/* 使用公共类: .swipe-actions, .swipe-action-btn, .fab-btn, .loading-wrapper, .load-more */

.users-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.users-list {
  margin-top: 20rpx;
}

/* 用户卡片 - 仅覆盖特有样式 */
.user-card {
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.user-info {
  width: 100%;
}

.user-name-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-extra {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.extra-text {
  font-size: 28rpx;
  color: #666;
}

/* 滑动操作按钮 - 扩展公共类 */
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  color: #fff;
  font-size: 28rpx;
}

.edit-btn {
  background-color: #1890ff;
}

.delete-btn {
  background-color: #ff4d4f;
}

/* 加载状态 - 使用公共 .loading-wrapper */
.loading-center {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}
