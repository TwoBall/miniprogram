.users-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.search-bar {
  background-color: #fff;
  padding-bottom: 20rpx;
}

.users-list {
  margin-top: 20rpx;
}

.user-card {
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.user-info {
  width: 100%;
}

.user-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-name-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.user-extra {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.extra-text {
  font-size: 28rpx;
  color: #666;
}

.user-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #999;
}

.swipe-actions {
  display: flex;
  height: 100%;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  color: #fff;
  font-size: 28rpx;
}

.edit-btn {
  background-color: #1890ff;
}

.delete-btn {
  background-color: #ff4d4f;
}

.loading-center {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.add-btn-wrapper {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  padding: 0 32rpx;
  z-index: 100;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}
