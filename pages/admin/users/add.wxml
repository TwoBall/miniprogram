<view class="add-user-container">
  <view class="form-section">
    <van-cell-group title="基本信息">
      <van-field
        label="姓名"
        value="{{ formData.userName }}"
        placeholder="请输入姓名"
        required
        bind:change="onNameInput"
      />

      <van-cell
        title="角色"
        is-link
        required
        value="{{ roleLabel || '请选择角色' }}"
        bind:click="showRolePicker"
      />
    </van-cell-group>

    <van-cell-group title="详细信息" wx:if="{{ formData.role }}">
      <van-cell
        wx:if="{{ formData.role === 'leader' || formData.role === 'classTeacher' }}"
        title="学部"
        is-link
        required="{{ formData.role === 'leader' }}"
        value="{{ formData.department || '请选择学部' }}"
        bind:click="showDepartmentPicker"
      />

      <van-cell
        wx:if="{{ formData.role === 'classTeacher' }}"
        title="班级"
        is-link
        required
        value="{{ formData.className || '请选择班级' }}"
        bind:click="showClassPicker"
      />

      <van-cell
        wx:if="{{ formData.role === 'teacher' }}"
        title="社团"
        is-link
        required
        value="{{ formData.clubName || '请选择社团' }}"
        bind:click="showClubPicker"
      />
    </van-cell-group>

    <view class="tips-section">
      <van-icon name="info-o" size="32rpx" color="#1890ff" />
      <text class="tips-text">
        添加的用户将自动审批通过，用户首次登录时可通过姓名和角色关联此账号
      </text>
    </view>
  </view>

  <view class="action-buttons">
    <view class="btn-wrapper">
      <van-button
        type="default"
        size="large"
        block
        bind:click="cancel"
      >
        取消
      </van-button>
    </view>
    <view class="btn-wrapper">
      <van-button
        type="primary"
        size="large"
        block
        bind:click="submitForm"
      >
        {{ mode === 'add' ? '添加' : '保存' }}
      </van-button>
    </view>
  </view>

  <!-- 角色选择器 -->
  <van-action-sheet
    show="{{ showRolePicker }}"
    actions="{{ roleOptions }}"
    bind:select="onRoleConfirm"
    bind:close="onRoleCancel"
    cancel-text="取消"
  />

  <!-- 学部选择器 -->
  <van-action-sheet
    show="{{ showDepartmentPicker }}"
    actions="{{ departmentOptions }}"
    bind:select="onDepartmentConfirm"
    bind:close="onDepartmentCancel"
    cancel-text="取消"
  />

  <!-- 班级选择器 -->
  <van-action-sheet
    show="{{ showClassPicker }}"
    actions="{{ classOptions }}"
    bind:select="onClassConfirm"
    bind:close="onClassCancel"
    cancel-text="取消"
  />

  <!-- 社团选择器 -->
  <van-action-sheet
    show="{{ showClubPicker }}"
    actions="{{ clubOptions }}"
    bind:select="onClubConfirm"
    bind:close="onClubCancel"
    cancel-text="取消"
  />

  <van-toast id="van-toast" />
</view>
