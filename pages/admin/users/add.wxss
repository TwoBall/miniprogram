.add-user-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.form-section {
  padding-top: 20rpx;
}

.tips-section {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 32rpx;
  margin: 32rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #f0f9ff 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #1890ff;
}

.tips-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 32rpx;
}

.btn-wrapper {
  flex: 1;
}
