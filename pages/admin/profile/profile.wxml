<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-info card-pop-in">
    <view class="avatar">
      <van-icon name="user-circle-o" size="64px" color="#722ed1" />
    </view>
    <view class="user-details">
      <view class="name">{{ userInfo.userName || '未登录' }}</view>
      <view class="role-tag">
        <van-icon name="shield-o" size="14px" />
        <text class="role-text">系统管理员</text>
      </view>
      <view class="info-item" wx:if="{{ userInfo.department }}">
        <van-icon name="location-o" size="14px" />
        <text class="info-text">{{ userInfo.department }}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <van-cell-group>
      <van-cell
        wx:for="{{ menuList }}"
        wx:key="id"
        title="{{ item.text }}"
        icon="{{ item.icon }}"
        is-link="{{ !item.action }}"
        value="{{ item.showBadge && unreadCount > 0 ? (unreadCount > 99 ? '99+' : unreadCount) : '' }}"
        data-url="{{ item.url }}"
        data-action="{{ item.action }}"
        bindtap="onMenuTap"
      />
    </van-cell-group>
  </view>

  <!-- 底部 TabBar -->
  <custom-tabbar role="admin" active="{{ tabIndex }}" />

  <van-dialog id="van-dialog" />
</view>
