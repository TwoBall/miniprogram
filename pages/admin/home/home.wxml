<view class="home-container">
  <!-- 骨架屏 -->
  <skeleton wx:if="{{ pageLoading }}" />

  <block wx:else>
    <!-- 欢迎信息 -->
    <view class="welcome-section">
      <view class="greeting">
        <text class="greeting-text">您好，{{ userInfo.userName || '管理员' }}</text>
        <van-tag type="primary" size="medium">管理员</van-tag>
      </view>
      <view class="subtitle">欢迎使用智慧社团管理系统</view>
    </view>

    <!-- 统计卡片 -->
    <view class="card stats-section card-pop-in">
      <view class="stats-grid">
        <view class="stat-card card-tap" bindtap="navigateTo" data-url="/pages/admin/users/users">
          <view class="stat-value">{{ stats.totalUsers }}</view>
          <view class="stat-label">总用户数</view>
        </view>
        <view class="stat-card card-tap" bindtap="navigateTo" data-url="/pages/admin/approval/approval">
          <view class="stat-value warning">{{ stats.pendingUsers }}</view>
          <view class="stat-label">待审批</view>
        </view>
        <view class="stat-card card-tap" bindtap="navigateTo" data-url="/pages/admin/data/data">
          <view class="stat-value">{{ stats.totalClubs }}</view>
          <view class="stat-label">社团数量</view>
        </view>
        <view class="stat-card card-tap" bindtap="navigateTo" data-url="/pages/admin/data/data">
          <view class="stat-value">{{ stats.todayAttendance }}</view>
          <view class="stat-label">今日点名</view>
        </view>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions">
      <view class="section-title">快捷操作</view>
      <van-grid column-num="4" border="{{ false }}">
        <van-grid-item
          icon="manager-o"
          text="用户管理"
          data-url="/pages/admin/users/users"
          bindtap="navigateTo"
        />
        <van-grid-item
          icon="bar-chart-o"
          text="数据中心"
          data-url="/pages/admin/data/data"
          bindtap="navigateTo"
        />
        <van-grid-item
          icon="orders-o"
          text="审批中心"
          data-url="/pages/admin/approval/approval"
          bindtap="navigateTo"
        />
        <van-grid-item
          icon="bell"
          text="通知中心"
          data-url="/pages/common/notifications/notifications"
          bindtap="navigateTo"
        />
      </van-grid>
    </view>
  </block>

  <!-- 底部 TabBar -->
  <custom-tabbar role="admin" active="0" />
</view>

<van-toast id="van-toast" />
