<view class="admin-home">
  <view class="header-section">
    <view class="admin-avatar">
      <van-icon name="manager" size="80rpx" color="#ffffff" />
    </view>
    <view class="admin-info">
      <text class="admin-name">{{adminInfo.name || '管理员'}}</text>
      <van-tag type="primary" size="medium">系统管理员</van-tag>
    </view>
    <view class="debug-badge">
      <van-icon name="fire-o" size="24rpx" color="#ff4d4f" />
      <text>调试模式</text>
    </view>
  </view>

  <view class="section-title">
    <van-icon name="apps-o" size="32rpx" color="#1890ff" />
    <text>角色切换（调试）</text>
  </view>

  <view class="role-grid">
    <view
      wx:for="{{debugRoles}}"
      wx:key="key"
      class="role-card"
      style="border-color: {{item.color}}20;"
      bindtap="switchToRole"
      data-role="{{item.key}}"
    >
      <view class="role-icon" style="background: {{item.color}}15;">
        <van-icon name="{{item.icon}}" size="48rpx" color="{{item.color}}" />
      </view>
      <view class="role-info">
        <text class="role-name">{{item.name}}</text>
        <text class="role-desc">{{item.desc}}</text>
      </view>
      <van-icon name="arrow" size="28rpx" color="#999" />
    </view>
  </view>

  <view class="section-title">
    <van-icon name="setting-o" size="32rpx" color="#1890ff" />
    <text>管理功能</text>
  </view>

  <view class="function-list">
    <van-cell
      title="用户审批管理"
      icon="friends-o"
      is-link
      bind:click="goToApproval"
    />
  </view>

  <view class="tips-section">
    <van-icon name="info-o" size="28rpx" color="#ff9800" />
    <text class="tips-text">调试模式下可切换到任意角色页面进行测试，测试数据使用模拟数据</text>
  </view>

  <view class="logout-section">
    <van-button
      type="default"
      block
      round
      icon="revoke"
      bind:click="logout"
    >
      退出登录
    </van-button>
  </view>

  <van-toast id="van-toast" />
</view>
