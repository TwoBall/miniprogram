.home-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

.welcome-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx;
  color: #fff;
}

.greeting {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.greeting-text {
  font-size: 44rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.stats-section {
  margin: -40rpx 30rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  padding: 30rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.stat-card {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 10rpx;
}

.stat-value.warning {
  color: #ff4d4f;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.quick-actions {
  margin: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
