.admin-home {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header-section {
  background: linear-gradient(135deg, #722ed1 0%, #9254de 100%);
  padding: 60rpx 30rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.admin-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.admin-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.admin-name {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.debug-badge {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.debug-badge text {
  font-size: 22rpx;
  color: #ff4d4f;
}

.section-title {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  gap: 12rpx;
}

.section-title text {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.role-grid {
  padding: 0 20rpx;
}

.role-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.role-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.role-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.role-desc {
  font-size: 24rpx;
  color: #999;
}

.function-list {
  margin: 0 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.tips-section {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 30rpx;
  margin: 20rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  gap: 12rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #fa8c16;
  line-height: 1.6;
  flex: 1;
}

.logout-section {
  padding: 40rpx 30rpx;
}
