<!-- 数据中心 - 教育杂志风 -->
<view class="ed-page ed-data-page">
  <!-- Hero 头部 -->
  <view class="ed-hero ed-hero-admin fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="chart-trending-o" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>统计分析</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">数据中心</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{ loading }}" class="ed-skeleton-wrapper">
    <skeleton type="stats" count="{{4}}" />
  </view>

  <view wx:else class="ed-data-content">
    <!-- 用户统计 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">01</text>
          <text class="ed-section-text">用户统计</text>
        </view>
        <van-icon name="friends-o" size="36rpx" color="#1a365d" />
      </view>

      <view class="ed-stat-card card-pop-in">
        <!-- 核心数据 -->
        <view class="ed-stat-hero">
          <text class="ed-stat-number">{{ userStats.total }}</text>
          <text class="ed-stat-unit">总用户数</text>
        </view>

        <!-- 角色分布 -->
        <view class="ed-stat-grid">
          <view class="ed-stat-item">
            <text class="ed-stat-value">{{ userStats.byRole.teacher }}</text>
            <text class="ed-stat-label">社团老师</text>
          </view>
          <view class="ed-stat-item">
            <text class="ed-stat-value">{{ userStats.byRole.classTeacher }}</text>
            <text class="ed-stat-label">班主任</text>
          </view>
          <view class="ed-stat-item">
            <text class="ed-stat-value">{{ userStats.byRole.leader }}</text>
            <text class="ed-stat-label">学部领导</text>
          </view>
          <view class="ed-stat-item">
            <text class="ed-stat-value">{{ userStats.byRole.admin }}</text>
            <text class="ed-stat-label">管理员</text>
          </view>
        </view>

        <!-- 状态分布 -->
        <view class="ed-status-row">
          <view class="ed-status-tag success">
            <van-icon name="success" size="24rpx" />
            <text>已通过 {{ userStats.byStatus.approved }}</text>
          </view>
          <view class="ed-status-tag warning">
            <van-icon name="clock-o" size="24rpx" />
            <text>待审批 {{ userStats.byStatus.pending }}</text>
          </view>
          <view class="ed-status-tag error">
            <van-icon name="close" size="24rpx" />
            <text>已拒绝 {{ userStats.byStatus.rejected }}</text>
          </view>
        </view>

        <!-- 绑定状态 -->
        <view class="ed-bind-row">
          <view class="ed-bind-item">
            <van-icon name="link-o" size="28rpx" color="#38a169" />
            <text>已绑定: {{ userStats.bound }}</text>
          </view>
          <view class="ed-bind-item">
            <van-icon name="warning-o" size="28rpx" color="#ed8936" />
            <text>未绑定: {{ userStats.unbound }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 学生统计 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">02</text>
          <text class="ed-section-text">学生统计</text>
        </view>
        <van-icon name="user-o" size="36rpx" color="#38a169" />
      </view>

      <view class="ed-stat-card card-pop-in">
        <!-- 核心数据 -->
        <view class="ed-stat-hero green">
          <text class="ed-stat-number">{{ studentStats.total }}</text>
          <text class="ed-stat-unit">学生总数</text>
        </view>

        <!-- 学部分布 -->
        <view class="ed-dept-list" wx:if="{{ Object.keys(studentStats.byDepartment).length > 0 }}">
          <view
            wx:for="{{ Object.keys(studentStats.byDepartment) }}"
            wx:key="*this"
            class="ed-dept-item"
          >
            <view class="ed-dept-info">
              <view class="ed-dept-indicator"></view>
              <text class="ed-dept-name">{{ item }}</text>
            </view>
            <text class="ed-dept-count">{{ studentStats.byDepartment[item] }} 人</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 社团统计 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">03</text>
          <text class="ed-section-text">社团统计</text>
        </view>
        <van-icon name="cluster-o" size="36rpx" color="#ed8936" />
      </view>

      <view class="ed-stat-card card-pop-in">
        <!-- 核心数据 -->
        <view class="ed-stat-hero orange">
          <text class="ed-stat-number">{{ clubStats.total }}</text>
          <text class="ed-stat-unit">社团总数</text>
        </view>
      </view>
    </view>

    <!-- 考勤统计 -->
    <view class="ed-section">
      <view class="ed-section-header">
        <view class="ed-section-title">
          <text class="ed-section-num">04</text>
          <text class="ed-section-text">考勤统计</text>
        </view>
        <van-icon name="records" size="36rpx" color="#805ad5" />
      </view>

      <view class="ed-attendance-cards">
        <view class="ed-attendance-card today card-pop-in">
          <text class="ed-att-title">今日</text>
          <text class="ed-att-count">{{ attendanceStats.todayTotal }}</text>
          <text class="ed-att-label">点名次数</text>
          <view class="ed-att-rate">
            <text>出勤率 {{ attendanceStats.todayRate }}%</text>
          </view>
        </view>
        <view class="ed-attendance-card week card-pop-in">
          <text class="ed-att-title">本周</text>
          <text class="ed-att-count">{{ attendanceStats.weekTotal }}</text>
          <text class="ed-att-label">点名次数</text>
          <view class="ed-att-rate">
            <text>出勤率 {{ attendanceStats.weekRate }}%</text>
          </view>
        </view>
        <view class="ed-attendance-card month card-pop-in">
          <text class="ed-att-title">本月</text>
          <text class="ed-att-count">{{ attendanceStats.monthTotal }}</text>
          <text class="ed-att-label">点名次数</text>
          <view class="ed-att-rate">
            <text>出勤率 {{ attendanceStats.monthRate }}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 导出按钮 -->
    <view class="ed-export-section">
      <van-button
        type="primary"
        size="large"
        icon="down"
        bind:click="exportData"
        block
        custom-class="ed-btn-primary btn-active"
      >
        导出统计报表
      </van-button>
    </view>
  </view>

  <van-toast id="van-toast" />

  <custom-tabbar role="admin" active="0" />
</view>
