/* 数据中心样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-data-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== Hero 头部 - 管理员紫色 ========== */
.ed-hero-admin {
  background: linear-gradient(165deg, #553c9a 0%, #805ad5 100%);
}

/* ========== 数据内容区 ========== */
.ed-data-content {
  padding-top: 24rpx;
}

/* ========== 区域容器 ========== */
.ed-section {
  margin-bottom: 32rpx;
  padding: 0 24rpx;
}

.ed-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ed-section-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ed-section-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-accent, #ed8936);
  font-family: 'Georgia', serif;
}

.ed-section-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gray-800, #2d3748);
  letter-spacing: 1rpx;
}

/* ========== 统计卡片 ========== */
.ed-stat-card {
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  padding: 32rpx;
  overflow: hidden;
}

/* 核心数据展示 */
.ed-stat-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 32rpx;
  border-bottom: 1rpx solid var(--gray-100, #f7fafc);
  margin-bottom: 24rpx;
}

.ed-stat-number {
  font-size: 72rpx;
  font-weight: 800;
  font-family: 'Georgia', serif;
  background: linear-gradient(135deg, #1a365d 0%, #2c5282 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
}

.ed-stat-hero.green .ed-stat-number {
  background: linear-gradient(135deg, #276749 0%, #38a169 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.ed-stat-hero.orange .ed-stat-number {
  background: linear-gradient(135deg, #c05621 0%, #ed8936 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.ed-stat-unit {
  font-size: 28rpx;
  color: var(--gray-500, #a0aec0);
  margin-top: 8rpx;
}

/* 统计网格 */
.ed-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ed-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: var(--gray-50, #f7fafc);
  border-radius: 12rpx;
}

.ed-stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary, #1a365d);
  font-family: 'Georgia', serif;
}

.ed-stat-label {
  font-size: 22rpx;
  color: var(--gray-500, #a0aec0);
  margin-top: 6rpx;
}

/* 状态分布行 */
.ed-status-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.ed-status-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.ed-status-tag.success {
  background: rgba(56, 161, 105, 0.1);
  color: #38a169;
}

.ed-status-tag.warning {
  background: rgba(237, 137, 54, 0.1);
  color: #ed8936;
}

.ed-status-tag.error {
  background: rgba(197, 48, 48, 0.1);
  color: #c53030;
}

/* 绑定状态行 */
.ed-bind-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--gray-100, #f7fafc);
}

.ed-bind-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--gray-600, #718096);
}

/* 学部分布列表 */
.ed-dept-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ed-dept-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--gray-50, #f7fafc);
  border-radius: 12rpx;
}

.ed-dept-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ed-dept-indicator {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #38a169 0%, #276749 100%);
  border-radius: 4rpx;
}

.ed-dept-name {
  font-size: 28rpx;
  color: var(--gray-700, #4a5568);
}

.ed-dept-count {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-800, #2d3748);
  font-family: 'Georgia', serif;
}

/* ========== 考勤统计卡片 ========== */
.ed-attendance-cards {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
  overflow-x: auto;
}

.ed-attendance-card {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  color: #fff;
}

.ed-attendance-card.today {
  background: linear-gradient(165deg, #553c9a 0%, #805ad5 100%);
}

.ed-attendance-card.week {
  background: linear-gradient(165deg, #1a365d 0%, #2c5282 100%);
}

.ed-attendance-card.month {
  background: linear-gradient(165deg, #276749 0%, #38a169 100%);
}

.ed-att-title {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.ed-att-count {
  font-size: 48rpx;
  font-weight: 800;
  font-family: 'Georgia', serif;
  margin-bottom: 6rpx;
}

.ed-att-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 16rpx;
}

.ed-att-rate {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* ========== 导出按钮区 ========== */
.ed-export-section {
  padding: 32rpx 24rpx;
}

.ed-btn-primary {
  background: linear-gradient(135deg, #1a365d 0%, #2c5282 100%) !important;
  border: none !important;
}

/* ========== 骨架屏 ========== */
.ed-skeleton-wrapper {
  padding: 24rpx;
}
