.data-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.loading-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80vh;
}

.content {
  padding: 20rpx 0;
}

.section {
  background-color: #fff;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.stats-overview {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.stat-item-large {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-number {
  font-size: 64rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1890ff, #722ed1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.stat-label {
  font-size: 28rpx;
  color: #999;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background-color: #f5f7fa;
  border-radius: 12rpx;
}

.stat-card .value {
  font-size: 36rpx;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.stat-card .label {
  font-size: 24rpx;
  color: #666;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-top: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-text {
  font-size: 28rpx;
  color: #666;
}

.stats-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stats-list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #f5f7fa;
  border-radius: 12rpx;
}

.item-label {
  font-size: 28rpx;
  color: #666;
}

.item-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.attendance-cards {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
}

.attendance-card {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  color: #fff;
}

.card-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.card-count {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 16rpx;
}

.card-rate {
  padding: 8rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 24rpx;
}

.action-section {
  padding: 32rpx;
}
