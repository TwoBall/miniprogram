/* 审批管理页样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-approval-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
}

/* ========== 骨架屏包装器 ========== */
.ed-skeleton-wrapper {
  padding: 24rpx;
}

/* ========== Hero 头部 - Admin 紫色主题 ========== */
.ed-hero-admin {
  background: linear-gradient(165deg, #553c9a 0%, #805ad5 100%);
}

/* ========== Tab 切换 - 悬浮卡片样式 ========== */
.ed-tabs-wrapper {
  padding: 0 24rpx;
  margin-top: -32rpx;
  position: relative;
  z-index: 10;
}

.ed-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.ed-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--gray-600, #718096);
  border-radius: 12rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.ed-tab-item.active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary, #1a365d) 0%, var(--color-primary-light, #2c5282) 100%);
  box-shadow: 0 4rpx 16rpx rgba(26, 54, 93, 0.25);
}

.ed-tab-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ed-tab-badge.warning {
  background: var(--color-warning-bg, #feebc8);
  color: var(--color-warning, #dd6b20);
}

.ed-tab-badge.success {
  background: var(--color-success-bg, #c6f6d5);
  color: var(--color-success, #38a169);
}

.ed-tab-badge.error {
  background: var(--color-error-bg, #fed7d7);
  color: var(--color-error, #c53030);
}

.ed-tab-item.active .ed-tab-badge {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

/* ========== Tab 内容区 ========== */
.ed-tab-content {
  padding: 24rpx;
  min-height: calc(100vh - 400rpx);
}

/* ========== 卡片列表 ========== */
.ed-card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ========== 用户卡片 ========== */
.ed-user-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  overflow: hidden;
  transition: all 0.2s ease;
}

/* 左侧状态指示条 */
.ed-card-indicator {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--gray-300, #e2e8f0);
}

.ed-card-indicator.warning {
  background: var(--color-warning, #dd6b20);
}

.ed-card-indicator.success {
  background: var(--color-success, #38a169);
}

.ed-card-indicator.error {
  background: var(--color-error, #c53030);
}

/* 卡片主体 */
.ed-card-body {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ed-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ed-user-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ed-user-avatar {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary, #1a365d) 0%, var(--color-primary-light, #2c5282) 100%);
  border-radius: 50%;
  flex-shrink: 0;
}

.ed-user-avatar.success {
  background: linear-gradient(135deg, #276749 0%, #38a169 100%);
}

.ed-user-avatar.error {
  background: linear-gradient(135deg, #9b2c2c 0%, #c53030 100%);
}

.ed-user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-900, #1a202c);
}

/* 状态标签 */
.ed-status-tag {
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.ed-status-tag.warning {
  background: var(--color-warning-bg, #feebc8);
  color: var(--color-warning, #dd6b20);
}

.ed-status-tag.success {
  background: var(--color-success-bg, #c6f6d5);
  color: var(--color-success, #38a169);
}

.ed-status-tag.error {
  background: var(--color-error-bg, #fed7d7);
  color: var(--color-error, #c53030);
}

/* 卡片元信息 */
.ed-card-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--gray-200, #edf2f7);
  border-bottom: 1rpx solid var(--gray-200, #edf2f7);
}

.ed-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ed-meta-label {
  font-size: 24rpx;
  color: var(--gray-500, #a0aec0);
  min-width: 80rpx;
}

.ed-meta-value {
  font-size: 26rpx;
  color: var(--gray-700, #4a5568);
  flex: 1;
}

.ed-meta-value.ed-meta-error {
  color: var(--color-error, #c53030);
}

/* 卡片操作 */
.ed-card-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

/* 按钮样式覆盖 */
.ed-btn-primary {
  background: linear-gradient(135deg, var(--color-primary, #1a365d) 0%, var(--color-primary-light, #2c5282) 100%) !important;
  border: none !important;
}

.ed-btn-outline {
  border-color: var(--gray-300, #e2e8f0) !important;
  color: var(--gray-600, #718096) !important;
}

.ed-btn-error {
  border-color: var(--color-error, #c53030) !important;
  color: var(--color-error, #c53030) !important;
}

/* ========== 加载更多和没有更多 ========== */
.ed-load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.ed-no-more {
  text-align: center;
  padding: 32rpx 0;
  color: var(--gray-400, #cbd5e0);
  font-size: 24rpx;
}

/* ========== 对话框样式 ========== */
.ed-dialog {
  padding: 16rpx;
}

.ed-dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gray-900, #1a202c);
  margin-bottom: 24rpx;
  text-align: center;
}

.ed-dialog-content {
  margin-bottom: 24rpx;
}

.ed-dialog-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
