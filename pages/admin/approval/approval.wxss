.approval-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tab-content {
  padding: 20rpx;
  min-height: calc(100vh - 88rpx);
}

.user-list {
  padding-bottom: 40rpx;
}

.user-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.user-card.approved {
  border-left: 6rpx solid #07c160;
}

.user-card.rejected {
  border-left: 6rpx solid #ee0a24;
}

.user-header {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.user-detail {
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #999999;
  min-width: 140rpx;
}

.value {
  flex: 1;
  color: #333333;
}

.value.reason {
  color: #ee0a24;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
  margin-top: 20rpx;
}

/* 拒绝对话框 */
.reject-dialog {
  padding: 20rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  text-align: center;
}

.dialog-content {
  margin-bottom: 30rpx;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}
