/* 管理员审批页面 - 页面特有样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */
/* 使用公共类: .page-container, .tabs, .tab-item, .card, .load-more, .no-more */

.approval-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Tab 内容区 */
.tab-content {
  padding: 20rpx;
  min-height: calc(100vh - 88rpx);
}

.user-list {
  padding-bottom: 40rpx;
}

/* 用户卡片 - 继承公共 .card，仅覆盖特有样式 */
.user-card {
  padding: 30rpx;
}

.user-card.approved {
  border-left: 6rpx solid #52c41a;
}

.user-card.rejected {
  border-left: 6rpx solid #ff4d4f;
}

.user-header {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.user-detail {
  margin-bottom: 20rpx;
}

/* 覆盖公共 detail-row 样式 */
.label {
  color: #999999;
  flex-shrink: 0;
  white-space: nowrap;
}

.value {
  flex: 1;
  color: #333333;
}

.value.reason {
  color: #ff4d4f;
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
  margin-top: 20rpx;
}

/* 拒绝对话框 */
.reject-dialog {
  padding: 20rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  text-align: center;
}

.dialog-content {
  margin-bottom: 30rpx;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}
