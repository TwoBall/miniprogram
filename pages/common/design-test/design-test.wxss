/**
 * 教育杂志风（Editorial）设计样式
 *
 * 设计规范：
 * =========
 * 【色彩方案】
 * - 主色（深蓝）: #1a365d
 * - 强调色（暖橙）: #ed8936
 * - 背景色（奶白）: #fefcf6
 * - 辅助灰: #718096, #a0aec0, #cbd5e0, #e2e8f0
 * - 成功色: #38a169
 * - 警告色: #dd6b20
 * - 错误色: #c53030
 *
 * 【字体策略】
 * - 标题：粗体，大字号，形成视觉冲击
 * - 正文：适中字号，良好可读性
 * - 标签：小字号，辅助信息
 *
 * 【布局特点】
 * - 不对称排版，打破传统居中布局
 * - 大量留白，呼吸感强
 * - 编号系统（01、02...）增强杂志感
 * - 细线分割，精致感
 */

/* ========== 全局容器 ========== */
.editorial-container {
  min-height: 100vh;
  background-color: #fefcf6;
  padding-bottom: 60rpx;
}

/* ========== 1. 头部区域 ========== */
.hero-section {
  position: relative;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(165deg, #1a365d 0%, #2c5282 100%);
  overflow: hidden;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-eyebrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 8rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.hero-title {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title-line {
  font-size: 72rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
  letter-spacing: 4rpx;
}

.title-accent {
  color: #ed8936;
}

.hero-divider {
  width: 80rpx;
  height: 6rpx;
  background-color: #ed8936;
  margin: 32rpx 0;
}

.hero-subtitle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.dot-separator {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #ed8936;
}

/* 装饰元素 */
.hero-decoration {
  position: absolute;
  top: 40rpx;
  right: -60rpx;
  z-index: 1;
}

.deco-circle {
  width: 300rpx;
  height: 300rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.deco-line {
  position: absolute;
  top: 150rpx;
  left: -100rpx;
  width: 200rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(237, 137, 54, 0.5));
}

/* ========== 2. 统计卡片区 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 30rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
}

.stat-card {
  background-color: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  background-color: #1a365d;
}

.stat-card-large {
  grid-column: span 2;
}

.stat-card-large::before {
  width: 100%;
  height: 4rpx;
}

.stat-card-accent {
  background-color: #ed8936;
  border-color: #ed8936;
}

.stat-card-accent::before {
  background-color: #dd6b20;
}

.stat-card-accent .stat-label,
.stat-card-accent .stat-number,
.stat-card-accent .stat-sub {
  color: #ffffff;
}

.stat-label {
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.stat-number {
  font-size: 56rpx;
  font-weight: 800;
  color: #1a365d;
  line-height: 1;
}

.stat-unit {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 4rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: #a0aec0;
  margin-top: 8rpx;
}

.stat-trend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.stat-trend.positive {
  color: #38a169;
}

.stat-trend.negative {
  color: #c53030;
}

/* ========== 3. 区块通用样式 ========== */
.section-block {
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 32rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.title-number {
  font-size: 28rpx;
  font-weight: 700;
  color: #ed8936;
  font-family: 'Georgia', serif;
}

.title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a365d;
  letter-spacing: 2rpx;
}

.section-action {
  font-size: 26rpx;
  color: #ed8936;
  padding-bottom: 4rpx;
  border-bottom: 2rpx solid #ed8936;
}

/* ========== 4. 进度条区域 ========== */
.progress-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.progress-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-label {
  font-size: 28rpx;
  color: #2d3748;
  font-weight: 500;
}

.progress-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a365d;
}

.progress-bar {
  height: 12rpx;
  background-color: #e2e8f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1a365d, #2c5282);
  border-radius: 6rpx;
  transition: width 0.6s ease;
}

.progress-fill.fill-secondary {
  background: linear-gradient(90deg, #2c5282, #4299e1);
}

.progress-fill.fill-warning {
  background: linear-gradient(90deg, #dd6b20, #ed8936);
}

/* ========== 5. 卡片列表 ========== */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.editorial-card {
  display: flex;
  background-color: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.card-indicator {
  width: 8rpx;
  flex-shrink: 0;
}

.card-pending .card-indicator {
  background-color: #ed8936;
}

.card-success .card-indicator {
  background-color: #38a169;
}

.card-warning .card-indicator {
  background-color: #c53030;
}

.card-body {
  flex: 1;
  padding: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a365d;
}

.card-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  font-weight: 500;
}

.badge-pending {
  background-color: #feebc8;
  color: #c05621;
}

.badge-success {
  background-color: #c6f6d5;
  color: #276749;
}

.badge-warning {
  background-color: #fed7d7;
  color: #c53030;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #718096;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e2e8f0;
}

.btn-reject {
  color: #718096 !important;
  border-color: #cbd5e0 !important;
}

.btn-approve {
  background-color: #1a365d !important;
  border-color: #1a365d !important;
}

/* ========== 6. 排行榜 ========== */
.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
}

.rank-position {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.rank-first .rank-position {
  background: linear-gradient(135deg, #f6e05e, #ecc94b);
}

.rank-second .rank-position {
  background: linear-gradient(135deg, #e2e8f0, #cbd5e0);
}

.rank-third .rank-position {
  background: linear-gradient(135deg, #fbd38d, #ed8936);
}

.rank-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a365d;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a365d;
  margin-bottom: 6rpx;
}

.rank-dept {
  font-size: 24rpx;
  color: #718096;
}

.rank-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a365d;
}

.score-unit {
  font-size: 24rpx;
  color: #718096;
}

/* ========== 7. 快捷操作网格 ========== */
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 16rpx;
  background-color: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.action-item:active {
  background-color: #fefcf6;
  border-color: #ed8936;
  transform: scale(0.98);
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fefcf6;
  border-radius: 16rpx;
}

.action-label {
  font-size: 24rpx;
  color: #1a365d;
  font-weight: 500;
  text-align: center;
}

/* ========== 8. Tab 切换 ========== */
.editorial-tabs {
  display: flex;
  border-bottom: 2rpx solid #e2e8f0;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #718096;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item.active {
  color: #1a365d;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: #ed8936;
}

/* ========== 9. 学生列表 ========== */
.student-list {
  display: flex;
  flex-direction: column;
}

.student-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.student-item:last-child {
  border-bottom: none;
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-avatar.male {
  background: linear-gradient(135deg, #2c5282, #1a365d);
}

.student-avatar.female {
  background: linear-gradient(135deg, #ed8936, #dd6b20);
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a365d;
  margin-bottom: 6rpx;
}

.student-class {
  font-size: 24rpx;
  color: #718096;
}

.student-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.status-present {
  background-color: #c6f6d5;
  color: #276749;
}

.status-absent {
  background-color: #fed7d7;
  color: #c53030;
}

/* ========== 10. 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f7fafc;
  border-radius: 50%;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a365d;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #718096;
}

/* ========== 11. 底部信息 ========== */
.footer-section {
  padding: 60rpx 30rpx;
  text-align: center;
}

.footer-line {
  width: 80rpx;
  height: 4rpx;
  background-color: #ed8936;
  margin: 0 auto 24rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 8rpx;
}

.footer-version {
  font-size: 22rpx;
  color: #a0aec0;
  letter-spacing: 2rpx;
}
