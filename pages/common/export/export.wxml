<!-- 数据导出页 - 教育杂志风 -->
<view class="ed-page ed-export-page">
  <!-- Hero 头部 -->
  <view class="ed-hero ed-hero-compact fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="down" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>数据管理</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">数据导出</text>
      </view>
    </view>
  </view>

  <!-- 历史记录入口 -->
  <view class="ed-history-entry card-tap" bind:tap="goToHistory">
    <view class="ed-entry-left">
      <van-icon name="orders-o" size="40rpx" color="#1a365d" />
      <text>查看导出历史</text>
    </view>
    <van-icon name="arrow" size="28rpx" color="#a0aec0" />
  </view>

  <!-- 导出类型选择 -->
  <view class="ed-section">
    <view class="ed-section-header">
      <view class="ed-section-title">
        <text class="ed-section-num">01</text>
        <text class="ed-section-text">导出类型</text>
      </view>
    </view>

    <view class="ed-option-card">
      <view
        class="ed-option-item {{ exportType === 'attendance' ? 'active' : '' }}"
        bindtap="onExportTypeChange"
        data-type="attendance"
      >
        <view class="ed-option-radio {{ exportType === 'attendance' ? 'checked' : '' }}">
          <van-icon wx:if="{{ exportType === 'attendance' }}" name="success" size="24rpx" color="#fff" />
        </view>
        <view class="ed-option-info">
          <text class="ed-option-title">考勤明细</text>
          <text class="ed-option-desc">导出每日点名详细记录</text>
        </view>
      </view>
      <view
        class="ed-option-item {{ exportType === 'summary' ? 'active' : '' }}"
        bindtap="onExportTypeChange"
        data-type="summary"
      >
        <view class="ed-option-radio {{ exportType === 'summary' ? 'checked' : '' }}">
          <van-icon wx:if="{{ exportType === 'summary' }}" name="success" size="24rpx" color="#fff" />
        </view>
        <view class="ed-option-info">
          <text class="ed-option-title">考勤汇总</text>
          <text class="ed-option-desc">导出出勤率统计数据</text>
        </view>
      </view>
      <view
        class="ed-option-item {{ exportType === 'students' ? 'active' : '' }}"
        bindtap="onExportTypeChange"
        data-type="students"
      >
        <view class="ed-option-radio {{ exportType === 'students' ? 'checked' : '' }}">
          <van-icon wx:if="{{ exportType === 'students' }}" name="success" size="24rpx" color="#fff" />
        </view>
        <view class="ed-option-info">
          <text class="ed-option-title">学生名单</text>
          <text class="ed-option-desc">导出学生基础信息</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 日期范围选择 -->
  <view class="ed-section" wx:if="{{ exportType === 'attendance' || exportType === 'summary' }}">
    <view class="ed-section-header">
      <view class="ed-section-title">
        <text class="ed-section-num">02</text>
        <text class="ed-section-text">日期范围</text>
      </view>
    </view>

    <view class="ed-option-card">
      <view
        class="ed-option-item {{ dateRange === 'today' ? 'active' : '' }}"
        bindtap="onDateRangeChange"
        data-range="today"
      >
        <view class="ed-option-radio {{ dateRange === 'today' ? 'checked' : '' }}">
          <van-icon wx:if="{{ dateRange === 'today' }}" name="success" size="24rpx" color="#fff" />
        </view>
        <text class="ed-option-title">今日</text>
      </view>
      <view
        class="ed-option-item {{ dateRange === 'week' ? 'active' : '' }}"
        bindtap="onDateRangeChange"
        data-range="week"
      >
        <view class="ed-option-radio {{ dateRange === 'week' ? 'checked' : '' }}">
          <van-icon wx:if="{{ dateRange === 'week' }}" name="success" size="24rpx" color="#fff" />
        </view>
        <text class="ed-option-title">本周</text>
      </view>
      <view
        class="ed-option-item {{ dateRange === 'month' ? 'active' : '' }}"
        bindtap="onDateRangeChange"
        data-range="month"
      >
        <view class="ed-option-radio {{ dateRange === 'month' ? 'checked' : '' }}">
          <van-icon wx:if="{{ dateRange === 'month' }}" name="success" size="24rpx" color="#fff" />
        </view>
        <text class="ed-option-title">本月</text>
      </view>
      <view
        class="ed-option-item {{ dateRange === 'custom' ? 'active' : '' }}"
        bindtap="onDateRangeChange"
        data-range="custom"
      >
        <view class="ed-option-radio {{ dateRange === 'custom' ? 'checked' : '' }}">
          <van-icon wx:if="{{ dateRange === 'custom' }}" name="success" size="24rpx" color="#fff" />
        </view>
        <text class="ed-option-title">自定义</text>
      </view>
    </view>

    <!-- 自定义日期范围 -->
    <view wx:if="{{ dateRange === 'custom' }}" class="ed-custom-date">
      <view class="ed-date-item" bindtap="onShowStartDatePicker">
        <text class="ed-date-label">开始日期</text>
        <view class="ed-date-value">
          <text>{{ startDate || '请选择' }}</text>
          <van-icon name="arrow" size="24rpx" color="#a0aec0" />
        </view>
      </view>
      <view class="ed-date-item" bindtap="onShowEndDatePicker">
        <text class="ed-date-label">结束日期</text>
        <view class="ed-date-value">
          <text>{{ endDate || '请选择' }}</text>
          <van-icon name="arrow" size="24rpx" color="#a0aec0" />
        </view>
      </view>
    </view>
  </view>

  <!-- 筛选条件 -->
  <view class="ed-section">
    <view class="ed-section-header">
      <view class="ed-section-title">
        <text class="ed-section-num">{{ exportType === 'students' ? '02' : '03' }}</text>
        <text class="ed-section-text">筛选条件</text>
      </view>
    </view>

    <view class="ed-filter-card">
      <!-- 学部选择 -->
      <view
        wx:if="{{ userInfo.role === 'admin' || userInfo.role === 'leader' }}"
        class="ed-filter-item"
        bindtap="showDepartmentPicker"
      >
        <view class="ed-filter-label">
          <van-icon name="shop-o" size="28rpx" color="#718096" />
          <text>学部</text>
        </view>
        <view class="ed-filter-value">
          <text>{{ department || '全部' }}</text>
          <van-icon name="arrow" size="24rpx" color="#a0aec0" />
        </view>
      </view>

      <!-- 社团选择 -->
      <view
        wx:if="{{ userInfo.role === 'admin' || userInfo.role === 'leader' || userInfo.role === 'teacher' }}"
        class="ed-filter-item {{ userInfo.role === 'teacher' ? 'disabled' : '' }}"
        bindtap="showClubPicker"
      >
        <view class="ed-filter-label">
          <van-icon name="apps-o" size="28rpx" color="#718096" />
          <text>社团</text>
        </view>
        <view class="ed-filter-value">
          <text>{{ clubName || (userInfo.role === 'teacher' ? userInfo.clubName : '全部') }}</text>
          <van-icon wx:if="{{ userInfo.role !== 'teacher' }}" name="arrow" size="24rpx" color="#a0aec0" />
        </view>
      </view>

      <!-- 班级选择 -->
      <view
        wx:if="{{ userInfo.role === 'admin' || userInfo.role === 'classTeacher' }}"
        class="ed-filter-item {{ userInfo.role === 'classTeacher' ? 'disabled' : '' }}"
        bindtap="showClassPicker"
      >
        <view class="ed-filter-label">
          <van-icon name="location-o" size="28rpx" color="#718096" />
          <text>班级</text>
        </view>
        <view class="ed-filter-value">
          <text>{{ className || (userInfo.role === 'classTeacher' ? userInfo.className : '全部') }}</text>
          <van-icon wx:if="{{ userInfo.role !== 'classTeacher' }}" name="arrow" size="24rpx" color="#a0aec0" />
        </view>
      </view>
    </view>
  </view>

  <!-- 导出按钮 -->
  <view class="ed-export-btn">
    <van-button
      type="primary"
      size="large"
      block
      bind:click="onExport"
      loading="{{ exporting }}"
      disabled="{{ exporting }}"
      custom-class="ed-btn-primary btn-active"
    >
      {{ exporting ? '导出中...' : '开始导出' }}
    </van-button>
  </view>

  <!-- 说明提示 -->
  <view class="ed-tips-card">
    <view class="ed-tips-icon">
      <van-icon name="info-o" size="32rpx" color="#1a365d" />
    </view>
    <text class="ed-tips-text">
      导出的 Excel 文件将保存在小程序缓存中，可以通过微信分享给他人
    </text>
  </view>

  <!-- 日期选择器 -->
  <van-calendar
    show="{{ showCalendar }}"
    type="single"
    min-date="{{ calendarMinDate }}"
    max-date="{{ calendarMaxDate }}"
    default-date="{{ calendarDefaultDate }}"
    bind:close="onCalendarClose"
    bind:confirm="onCalendarConfirm"
    color="#1a365d"
  />

  <!-- 学部选择器 -->
  <van-popup show="{{ showDepartmentPicker }}" position="bottom" bind:close="onCloseDepartmentPicker">
    <van-picker
      show-toolbar
      title="选择学部"
      columns="{{ departmentColumns }}"
      bind:confirm="onConfirmDepartment"
      bind:cancel="onCloseDepartmentPicker"
    />
  </van-popup>

  <!-- 社团选择器 -->
  <van-popup show="{{ showClubPicker }}" position="bottom" bind:close="onCloseClubPicker">
    <van-picker
      show-toolbar
      title="选择社团"
      columns="{{ clubColumns }}"
      bind:confirm="onConfirmClub"
      bind:cancel="onCloseClubPicker"
    />
  </van-popup>

  <!-- 班级选择器 -->
  <van-popup show="{{ showClassPicker }}" position="bottom" bind:close="onCloseClassPicker">
    <van-picker
      show-toolbar
      title="选择班级"
      columns="{{ classColumns }}"
      bind:confirm="onConfirmClass"
      bind:cancel="onCloseClassPicker"
    />
  </van-popup>
</view>
