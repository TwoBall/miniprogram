.export-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.history-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e8e8e8;
  font-size: 28rpx;
  color: #333;
}

.history-entry text {
  flex: 1;
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.custom-date {
  margin-top: 20rpx;
}

.export-btn {
  margin: 40rpx 0;
  padding: 0 30rpx;
}

.tips {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 30rpx;
  margin-top: 20rpx;
  background-color: #fff8e6;
  border-radius: 8rpx;
}

.tips-text {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #856404;
  line-height: 1.6;
}
