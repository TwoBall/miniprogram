/* 数据导出页样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-export-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ========== Hero 头部 ========== */
/* 使用全局 ed-hero 标准高度: padding: 40rpx 32rpx 56rpx */

/* ========== 历史记录入口 ========== */
.ed-history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -32rpx 24rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 10;
}

.ed-entry-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-primary, #1a365d);
}

/* ========== 区域容器 ========== */
.ed-section {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.ed-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ed-section-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ed-section-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-accent, #ed8936);
  font-family: 'Georgia', serif;
}

.ed-section-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gray-800, #2d3748);
  letter-spacing: 1rpx;
}

/* ========== 选项卡片 (van-radio-group) ========== */
.ed-radio-group {
  background: #fff !important;
  border-radius: 16rpx !important;
  border: 2rpx solid var(--gray-200, #edf2f7) !important;
  overflow: hidden;
  margin: 0 !important;
}

.ed-radio-cell {
  padding: 24rpx !important;
}

/* 日期范围 radio 组 */
.ed-date-radio-group {
  display: flex !important;
  flex-wrap: wrap;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  padding: 24rpx;
}

.ed-date-radio {
  flex: 1;
  min-width: calc(50% - 12rpx);
}

/* ========== 自定义日期范围 ========== */
.ed-custom-date {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ed-date-range-display {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ed-date-range-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ed-date-range-separator {
  flex-shrink: 0;
  padding: 0 8rpx;
}

.ed-date-value-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-800, #2d3748);
}

.ed-date-label {
  font-size: 24rpx;
  color: var(--gray-500, #a0aec0);
}

/* ========== 筛选卡片 ========== */
.ed-filter-card {
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  overflow: hidden;
}

.ed-filter-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--gray-100, #f7fafc);
}

.ed-filter-item:last-child {
  border-bottom: none;
}

.ed-filter-item.disabled {
  background: var(--gray-50, #f7fafc);
  opacity: 0.7;
}

.ed-filter-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--gray-600, #718096);
}

.ed-filter-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gray-800, #2d3748);
}

/* ========== 导出按钮 ========== */
.ed-export-btn {
  margin: 32rpx 24rpx;
}

.ed-btn-primary {
  background: linear-gradient(135deg, #1a365d 0%, #2c5282 100%) !important;
  border: none !important;
  font-weight: 600 !important;
  letter-spacing: 2rpx !important;
}

/* ========== 提示卡片 ========== */
.ed-tips-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 0 24rpx;
  padding: 24rpx;
  background: rgba(26, 54, 93, 0.06);
  border-radius: 16rpx;
  border-left: 6rpx solid var(--color-primary, #1a365d);
}

.ed-tips-icon {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 54, 93, 0.1);
  border-radius: 50%;
}

.ed-tips-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--gray-600, #718096);
  line-height: 1.6;
}
