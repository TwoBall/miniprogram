.history-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 记录列表 */
.record-list {
  padding-bottom: 20rpx;
}

.record-item {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.type-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  color: #fff;
}

.type-tag.attendance {
  background-color: #1989fa;
}

.type-tag.summary {
  background-color: #07c160;
}

.type-tag.students {
  background-color: #ff976a;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-body {
  margin-bottom: 20rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.record-count {
  font-size: 24rpx;
  color: #666;
}

.filter-desc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
}
