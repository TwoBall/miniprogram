/* 导出历史页样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-history-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ========== Hero 头部 ========== */
/* 使用全局 ed-hero 标准高度: padding: 40rpx 32rpx 56rpx */

/* ========== 骨架屏容器 ========== */
.ed-skeleton-wrapper {
  padding: 0 24rpx;
  margin-top: -20rpx;
}

/* ========== 历史记录列表 ========== */
.ed-history-list {
  padding: 0 24rpx;
  margin-top: -20rpx;
}

.ed-history-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 左侧类型指示条 */
.ed-card-indicator {
  width: 8rpx;
  flex-shrink: 0;
}

.ed-card-indicator.attendance {
  background: linear-gradient(180deg, #1a365d 0%, #2c5282 100%);
}

.ed-card-indicator.summary {
  background: linear-gradient(180deg, #276749 0%, #38a169 100%);
}

.ed-card-indicator.students {
  background: linear-gradient(180deg, #c05621 0%, #ed8936 100%);
}

/* 卡片主体 */
.ed-card-body {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 头部：类型标签 + 时间 */
.ed-history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ed-type-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.ed-type-badge.attendance {
  background: rgba(26, 54, 93, 0.1);
  color: var(--color-primary, #1a365d);
}

.ed-type-badge.summary {
  background: rgba(56, 161, 105, 0.1);
  color: var(--color-success, #38a169);
}

.ed-type-badge.students {
  background: rgba(237, 137, 54, 0.1);
  color: var(--color-accent, #ed8936);
}

.ed-history-time {
  font-size: 24rpx;
  color: var(--gray-500, #a0aec0);
}

/* 文件信息 */
.ed-file-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ed-file-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gray-800, #2d3748);
  word-break: break-all;
  line-height: 1.4;
}

.ed-file-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--gray-600, #718096);
}

/* 筛选条件 */
.ed-filter-desc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: var(--gray-50, #f7fafc);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--gray-600, #718096);
}

/* 操作按钮 */
.ed-history-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--gray-100, #f7fafc);
}

.ed-btn-download {
  background: linear-gradient(135deg, #1a365d 0%, #2c5282 100%) !important;
  border: none !important;
}

.ed-btn-delete {
  background: #fff !important;
  color: var(--gray-600, #718096) !important;
  border: 2rpx solid var(--gray-300, #e2e8f0) !important;
}

/* ========== 加载更多 ========== */
.ed-loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

/* ========== 没有更多 ========== */
.ed-no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--gray-400, #a0aec0);
}
