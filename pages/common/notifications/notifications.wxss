/* 通知列表页样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-notifications-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: 40rpx;
}

/* ========== Hero 头部 ========== */
/* 使用全局 ed-hero 标准高度: padding: 40rpx 32rpx 56rpx */

/* ========== Tab 切换 ========== */
.ed-tabs-wrapper {
  padding: 0 24rpx;
  margin-top: -32rpx;
  position: relative;
  z-index: 10;
}

.ed-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.ed-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--gray-600, #718096);
  border-radius: 12rpx;
  transition: all 0.3s ease;
  font-weight: 500;
  position: relative;
}

.ed-tab-item.active {
  color: #fff;
  background: linear-gradient(135deg, #1a365d 0%, #2c5282 100%);
  box-shadow: 0 4rpx 16rpx rgba(26, 54, 93, 0.25);
}

/* Tab 徽章 */
.ed-tab-badge {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: var(--color-error, #c53030);
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-weight: 600;
}

/* ========== 全部标记为已读 ========== */
.ed-action-wrapper {
  padding: 20rpx 24rpx 0;
}

.ed-mark-all-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-success, #38a169);
  border: 2rpx solid var(--color-success, #38a169);
  font-weight: 500;
  transition: all 0.2s ease;
}

.ed-mark-all-btn:active {
  background-color: var(--color-success-bg, #c6f6d5);
  transform: scale(0.98);
}

/* ========== 骨架屏包装器 ========== */
.ed-skeleton-wrapper {
  padding: 24rpx;
}

/* ========== 通知列表 ========== */
.ed-notifications-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx 24rpx;
}

/* ========== 通知卡片 ========== */
.ed-notification-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  overflow: hidden;
  transition: all 0.2s ease;
}

.ed-notification-card.unread {
  border-color: rgba(26, 54, 93, 0.15);
  box-shadow: 0 2rpx 12rpx rgba(26, 54, 93, 0.08);
}

/* 左侧状态指示条 */
.ed-card-indicator {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--gray-300, #e2e8f0);
}

.ed-card-indicator.unread {
  background: linear-gradient(180deg, #1a365d 0%, #2c5282 100%);
}

/* 卡片主体 */
.ed-card-body {
  flex: 1;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 通知头部 */
.ed-notification-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 类型标签 */
.ed-type-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.ed-type-tag.type-absence_warning {
  background: var(--color-warning-bg, #feebc8);
  color: var(--color-warning, #dd6b20);
}

.ed-type-tag.type-transfer_request {
  background: rgba(26, 54, 93, 0.1);
  color: var(--color-primary, #1a365d);
}

.ed-type-tag.type-transfer_result {
  background: var(--color-success-bg, #c6f6d5);
  color: var(--color-success, #38a169);
}

.ed-type-tag.type-register_result {
  background: rgba(128, 90, 213, 0.1);
  color: #805ad5;
}

/* 时间 */
.ed-notification-time {
  font-size: 22rpx;
  color: var(--gray-500, #a0aec0);
  white-space: nowrap;
}

/* 标题 */
.ed-notification-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-900, #1a202c);
  line-height: 1.4;
}

/* 内容 */
.ed-notification-text {
  font-size: 26rpx;
  color: var(--gray-600, #718096);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ========== 右侧操作 ========== */
.ed-notification-action {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.ed-mark-read-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-success-bg, #c6f6d5);
  transition: all 0.2s ease;
}

.ed-mark-read-btn:active {
  transform: scale(0.9);
  background: var(--color-success, #38a169);
}

.ed-mark-read-btn:active .van-icon {
  color: #fff !important;
}

/* ========== 没有更多 ========== */
.ed-no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: var(--gray-400, #a0aec0);
}
