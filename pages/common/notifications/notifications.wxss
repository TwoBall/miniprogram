/* 通知中心页面样式 */

.notifications-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* Tab 切换 */
.tabs-wrapper {
  background-color: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs {
  display: flex;
  align-items: center;
  height: 88rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 100%;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #1890ff;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #1890ff;
  border-radius: 2rpx;
}

.badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: #ee0a24;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 全部标记为已读 */
.mark-all-wrapper {
  padding: 24rpx 30rpx 0;
}

.mark-all-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #07c160;
  border: 2rpx solid #07c160;
  transition: all 0.3s;
}

.mark-all-btn:active {
  opacity: 0.7;
  transform: scale(0.98);
}

/* 通知列表 */
.notifications-list {
  padding: 24rpx 30rpx 0;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  position: relative;
  transition: all 0.3s;
}

.notification-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.notification-item.unread {
  background: linear-gradient(135deg, #f0f9ff 0%, #fff 100%);
  border-left: 6rpx solid #1890ff;
}

/* 未读指示器 */
.unread-dot {
  position: absolute;
  top: 32rpx;
  left: 8rpx;
  width: 12rpx;
  height: 12rpx;
  background-color: #ee0a24;
  border-radius: 50%;
}

/* 通知内容 */
.notification-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notification-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 类型标签 */
.type-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.type-badge.type-absence_warning {
  background-color: #fff7e6;
  color: #ff9800;
}

.type-badge.type-transfer_request {
  background-color: #e6f7ff;
  color: #1890ff;
}

.type-badge.type-transfer_result {
  background-color: #f0fdf4;
  color: #52c41a;
}

.type-badge.type-register_result {
  background-color: #f9f0ff;
  color: #722ed1;
}

.time {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

/* 标题 */
.notification-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}

/* 内容 */
.notification-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧操作 */
.notification-action {
  display: flex;
  align-items: center;
  padding-top: 8rpx;
}

.mark-read-btn {
  padding: 12rpx;
  border-radius: 50%;
  transition: all 0.3s;
}

.mark-read-btn:active {
  background-color: #f0f9ff;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999;
}
