<!-- 通知列表页 - 教育杂志风 -->
<view class="ed-page ed-notifications-page">
  <!-- Hero 头部 -->
  <view class="ed-hero ed-hero-compact fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="bell" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>消息中心</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">通知提醒</text>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <van-tabs
    active="{{ activeTab }}"
    bind:change="onTabChange"
    color="#667eea"
    title-active-color="#667eea"
    custom-class="ed-van-tabs"
  >
    <van-tab title="全部" name="all" />
    <van-tab title="未读" name="unread" info="{{ unreadCount > 0 ? (unreadCount > 99 ? '99+' : unreadCount) : '' }}" />
    <van-tab title="已读" name="read" />
  </van-tabs>

  <!-- 全部标记为已读按钮 -->
  <view wx:if="{{ notifications.length > 0 && unreadCount > 0 }}" class="ed-action-wrapper">
    <view class="ed-mark-all-btn btn-active" bindtap="markAllAsRead">
      <van-icon name="checked" size="28rpx" />
      <text>全部标记为已读</text>
    </view>
  </view>

  <!-- 骨架屏加载 -->
  <view wx:if="{{ loading }}" class="ed-skeleton-wrapper">
    <skeleton type="list" count="{{5}}" />
  </view>

  <!-- 通知列表 -->
  <view wx:elif="{{ notifications.length > 0 }}" class="ed-notifications-list">
    <view
      wx:for="{{ notifications }}"
      wx:key="_id"
      class="ed-notification-card card-tap {{ !item.read ? 'unread' : '' }}"
      bindtap="onNotificationTap"
      data-notification="{{ item }}"
      data-id="{{ item._id }}"
    >
      <!-- 左侧状态指示条 -->
      <view class="ed-card-indicator {{ !item.read ? 'unread' : '' }}"></view>

      <view class="ed-card-body">
        <!-- 顶部：类型标签 + 时间 -->
        <view class="ed-notification-header">
          <view class="ed-type-tag type-{{ item.type }}">
            <van-icon
              name="{{ item.type === 'absence_warning' ? 'warning-o' : item.type === 'transfer_request' ? 'question-o' : item.type === 'transfer_result' ? 'passed' : 'bell' }}"
              size="24rpx"
            />
            <text>{{ formatNotificationType(item.type) }}</text>
          </view>
          <text class="ed-notification-time">{{ item.createTime }}</text>
        </view>

        <!-- 标题 -->
        <view class="ed-notification-title">{{ item.title }}</view>

        <!-- 内容 -->
        <view class="ed-notification-text">{{ item.content }}</view>
      </view>

      <!-- 右侧操作 -->
      <view wx:if="{{ !item.read }}" class="ed-notification-action">
        <view
          class="ed-mark-read-btn"
          catchtap="markAsRead"
          data-id="{{ item._id }}"
        >
          <van-icon name="success" size="36rpx" color="#38a169" />
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:if="{{ !loading && notifications.length === 0 }}"
    type="notification"
    description="{{ activeTab === 'unread' ? '暂无未读通知' : activeTab === 'read' ? '暂无已读通知' : '' }}"
  />

  <!-- 没有更多 -->
  <view wx:if="{{ !loading && notifications.length > 0 && !hasMore }}" class="ed-no-more">
    没有更多了
  </view>
</view>

<van-toast id="van-toast" />
<van-dialog id="van-dialog" />
