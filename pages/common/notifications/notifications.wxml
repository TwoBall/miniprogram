<view class="notifications-container">
  <!-- Tab 切换 -->
  <view class="tabs-wrapper">
    <view class="tabs">
      <view
        class="tab-item {{ activeTab === 'all' ? 'active' : '' }}"
        bindtap="onTabChange"
        data-tab="all"
      >
        <text>全部</text>
      </view>
      <view
        class="tab-item {{ activeTab === 'unread' ? 'active' : '' }}"
        bindtap="onTabChange"
        data-tab="unread"
      >
        <text>未读</text>
        <view wx:if="{{ unreadCount > 0 }}" class="badge">{{ unreadCount > 99 ? '99+' : unreadCount }}</view>
      </view>
      <view
        class="tab-item {{ activeTab === 'read' ? 'active' : '' }}"
        bindtap="onTabChange"
        data-tab="read"
      >
        <text>已读</text>
      </view>
    </view>
  </view>

  <!-- 全部标记为已读按钮 -->
  <view wx:if="{{ notifications.length > 0 && unreadCount > 0 }}" class="mark-all-wrapper">
    <view class="mark-all-btn" bindtap="markAllAsRead">
      <van-icon name="checked" size="32rpx" />
      <text>全部标记为已读</text>
    </view>
  </view>

  <!-- 通知列表 -->
  <view class="notifications-list">
    <view
      wx:for="{{ notifications }}"
      wx:key="_id"
      class="card notification-item {{ !item.read ? 'unread' : '' }}"
      bindtap="onNotificationTap"
      data-notification="{{ item }}"
      data-id="{{ item._id }}"
    >
      <!-- 未读指示器 -->
      <view wx:if="{{ !item.read }}" class="unread-dot"></view>

      <!-- 通知内容 -->
      <view class="notification-content">
        <!-- 顶部：类型标签 + 时间 -->
        <view class="notification-header">
          <view class="type-badge type-{{ item.type }}">
            <van-icon
              name="{{ item.type === 'absence_warning' ? 'warning-o' : item.type === 'transfer_request' ? 'question-o' : item.type === 'transfer_result' ? 'passed' : 'bell' }}"
              size="24rpx"
            />
            <text>{{ formatNotificationType(item.type) }}</text>
          </view>
          <text class="time">{{ item.createTime }}</text>
        </view>

        <!-- 标题 -->
        <view class="notification-title">{{ item.title }}</view>

        <!-- 内容 -->
        <view class="notification-text">{{ item.content }}</view>
      </view>

      <!-- 右侧操作 -->
      <view wx:if="{{ !item.read }}" class="notification-action">
        <view
          class="mark-read-btn"
          catchtap="markAsRead"
          data-id="{{ item._id }}"
        >
          <van-icon name="success" size="32rpx" color="#52c41a" />
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:if="{{ !loading && notifications.length === 0 }}"
    type="notification"
    description="{{ activeTab === 'unread' ? '暂无未读通知' : activeTab === 'read' ? '暂无已读通知' : '' }}"
  />

  <!-- 骨架屏加载 -->
  <skeleton wx:if="{{ loading }}" type="list" count="{{5}}" />

  <!-- 没有更多 -->
  <view wx:if="{{ !loading && notifications.length > 0 && !hasMore }}" class="no-more">
    没有更多了
  </view>
</view>

<van-toast id="van-toast" />
<van-dialog id="van-dialog" />
