/* 创建转社团申请页样式 - Editorial 教育杂志风 */
/* 公共样式已在 app.wxss 中引入 editorial.wxss */

/* ========== 页面容器 ========== */
.ed-create-transfer-page {
  min-height: 100vh;
  background-color: var(--bg-page, #fefcf6);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== Hero 头部 ========== */
/* 使用全局 ed-hero 标准高度: padding: 40rpx 32rpx 56rpx */

/* ========== 区域容器 ========== */
.ed-section {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.ed-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ed-section-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ed-section-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-accent, #ed8936);
  font-family: 'Georgia', serif;
}

.ed-section-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gray-800, #2d3748);
  letter-spacing: 1rpx;
}

/* ========== 信息卡片 ========== */
.ed-info-card {
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  overflow: hidden;
}

.ed-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--gray-100, #f7fafc);
}

.ed-info-row:last-child {
  border-bottom: none;
}

.ed-info-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--gray-600, #718096);
}

.ed-info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gray-900, #1a202c);
}

.ed-value-highlight {
  color: var(--color-primary, #1a365d);
  font-weight: 600;
}

/* ========== 表单卡片 ========== */
.ed-form-card {
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--gray-200, #edf2f7);
  overflow: hidden;
}

.ed-form-item {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--gray-100, #f7fafc);
}

.ed-form-item:last-child {
  border-bottom: none;
}

.ed-form-item-textarea {
  padding-bottom: 16rpx;
}

.ed-form-label {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 28rpx;
  color: var(--gray-700, #4a5568);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.ed-label-required {
  color: var(--color-error, #c53030);
  font-weight: 600;
}

.ed-form-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: var(--gray-50, #f7fafc);
  border-radius: 12rpx;
}

.ed-form-value {
  font-size: 28rpx;
  color: var(--gray-900, #1a202c);
  font-weight: 500;
}

.ed-form-placeholder {
  font-size: 28rpx;
  color: var(--gray-400, #a0aec0);
}

.ed-textarea {
  background: var(--gray-50, #f7fafc) !important;
  border-radius: 12rpx !important;
}

/* ========== 提示卡片 ========== */
.ed-tips-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 24rpx;
  padding: 24rpx;
  background: rgba(26, 54, 93, 0.06);
  border-radius: 16rpx;
  border-left: 6rpx solid var(--color-primary, #1a365d);
}

.ed-tips-icon {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(26, 54, 93, 0.1);
  border-radius: 50%;
}

.ed-tips-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ed-tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary, #1a365d);
}

.ed-tips-text {
  font-size: 26rpx;
  color: var(--gray-600, #718096);
  line-height: 1.6;
}

/* ========== 底部操作按钮 ========== */
.ed-bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.ed-bottom-actions van-button {
  flex: 1;
}

.ed-btn-cancel {
  background: #fff !important;
  color: var(--gray-700, #4a5568) !important;
  border: 2rpx solid var(--gray-300, #e2e8f0) !important;
}

.ed-btn-primary {
  background: linear-gradient(135deg, #1a365d 0%, #2c5282 100%) !important;
  border: none !important;
}
