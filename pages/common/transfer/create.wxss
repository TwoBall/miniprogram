/* 复用公共样式: .page-container, .card, .info-row, .action-buttons 来自 common.wxss */

/* 学生信息卡片 */
.student-info-card {
  margin: 24rpx;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.info-content {
  padding: 0 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-row .label {
  font-size: 28rpx;
  color: #999;
}

.info-row .value {
  font-size: 28rpx;
  color: #333;
}

.info-row .value.highlight {
  color: #1890ff;
  font-weight: 500;
}

/* 表单卡片 */
.form-card {
  margin: 24rpx;
}

.form-item {
  padding: 24rpx 0 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

/* 占位符样式 */
.placeholder {
  color: #c8c9cc !important;
}

/* 提示区域 - 复用 add.wxss 样式 */
.tips-section {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 32rpx;
  margin: 32rpx 24rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #f0f9ff 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #1890ff;
}

.tips-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 操作按钮 - 复用 add.wxss 样式 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 32rpx;
}

.btn-wrapper {
  flex: 1;
}
