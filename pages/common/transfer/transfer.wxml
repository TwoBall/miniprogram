<!-- 转社团申请页 - 教育杂志风 -->
<view class="ed-page ed-transfer-page">
  <!-- Hero 头部 -->
  <view class="ed-hero ed-hero-compact fade-in-up">
    <view class="ed-hero-content">
      <view class="ed-hero-eyebrow">
        <van-icon name="exchange" size="28rpx" color="rgba(255,255,255,0.9)" />
        <text>社团管理</text>
      </view>
      <view class="ed-hero-title">
        <text class="ed-hero-title-line">转社团申请</text>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <van-tabs
    active="{{ activeTab }}"
    bind:change="onTabChange"
    color="#667eea"
    title-active-color="#667eea"
    swipeable
    custom-class="ed-van-tabs"
  >
    <van-tab title="待处理" name="pending_teacher" />
    <van-tab wx:if="{{ role === 'classTeacher' }}" title="待审批" name="pending_classTeacher" />
    <van-tab title="已通过" name="approved" />
    <van-tab title="已拒绝" name="rejected" />
    <van-tab title="全部" name="all" />
  </van-tabs>

  <!-- 骨架屏加载 -->
  <view wx:if="{{ loading }}" class="ed-skeleton-wrapper">
    <skeleton type="list" count="{{5}}" />
  </view>

  <!-- 转社团申请列表 -->
  <view wx:elif="{{ transfers.length > 0 }}" class="ed-transfer-list">
    <view
      wx:for="{{ transfers }}"
      wx:key="_id"
      class="ed-transfer-card card-tap"
      bindtap="onViewDetail"
      data-transfer="{{ item }}"
    >
      <!-- 左侧状态指示条 -->
      <view class="ed-card-indicator {{ item.status === 'approved' ? 'success' : item.status === 'rejected' ? 'error' : 'pending' }}"></view>

      <view class="ed-card-body">
        <!-- 头部：学生信息 + 状态 -->
        <view class="ed-transfer-header">
          <view class="ed-student-info">
            <text class="ed-student-name">{{ item.studentName }}</text>
            <view class="ed-class-tag">{{ item.className }}</view>
          </view>
          <view class="ed-status-tag {{ item.status === 'approved' ? 'success' : item.status === 'rejected' ? 'error' : 'pending' }}">
            {{ statusMap[item.status].text }}
          </view>
        </view>

        <!-- 转社团方向 -->
        <view class="ed-direction-wrapper">
          <view class="ed-club-badge from">
            <van-icon name="shop-o" size="24rpx" />
            <text>{{ item.fromClub }}</text>
          </view>
          <view class="ed-direction-arrow">
            <van-icon name="arrow" size="28rpx" color="#a0aec0" />
          </view>
          <view class="ed-club-badge to">
            <van-icon name="shop-o" size="24rpx" />
            <text>{{ item.toClub }}</text>
          </view>
        </view>

        <!-- 申请详情 -->
        <view class="ed-transfer-info">
          <view class="ed-info-row">
            <van-icon name="manager-o" size="24rpx" color="#718096" />
            <text class="ed-info-label">发起人</text>
            <text class="ed-info-value">{{ item.initiatorName }}</text>
          </view>
          <view wx:if="{{ item.reason }}" class="ed-info-row">
            <van-icon name="comment-o" size="24rpx" color="#718096" />
            <text class="ed-info-label">理由</text>
            <text class="ed-info-value">{{ item.reason }}</text>
          </view>
          <view class="ed-info-row">
            <van-icon name="clock-o" size="24rpx" color="#718096" />
            <text class="ed-info-label">时间</text>
            <text class="ed-info-value">{{ item.createTime }}</text>
          </view>
        </view>

        <!-- 确认状态 -->
        <view class="ed-confirm-status">
          <view class="ed-status-item {{ item.fromTeacherConfirmed ? 'confirmed' : '' }}">
            <van-icon name="{{ item.fromTeacherConfirmed ? 'success' : 'circle' }}" size="28rpx" />
            <text>转出老师</text>
          </view>
          <view class="ed-status-item {{ item.toTeacherConfirmed ? 'confirmed' : '' }}">
            <van-icon name="{{ item.toTeacherConfirmed ? 'success' : 'circle' }}" size="28rpx" />
            <text>转入老师</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="ed-transfer-actions" wx:if="{{ item.status !== 'approved' && item.status !== 'rejected' }}" catchtap="stopPropagation">
          <!-- 老师确认按钮 -->
          <van-button
            wx:if="{{ role === 'teacher' && item.status === 'pending_teacher' && ((item.fromClub === userInfo.clubName && !item.fromTeacherConfirmed) || (item.toClub === userInfo.clubName && !item.toTeacherConfirmed)) }}"
            type="primary"
            size="small"
            bindtap="onConfirm"
            data-id="{{ item._id }}"
            custom-class="ed-btn-primary btn-active"
          >
            确认
          </van-button>

          <!-- 班主任审批按钮 -->
          <view wx:if="{{ role === 'classTeacher' && item.status === 'pending_classTeacher' }}" class="ed-action-buttons">
            <van-button
              type="primary"
              size="small"
              bindtap="onApprove"
              data-id="{{ item._id }}"
              custom-class="ed-btn-success btn-active"
            >
              通过
            </van-button>
            <van-button
              type="danger"
              size="small"
              bindtap="onReject"
              data-id="{{ item._id }}"
              custom-class="ed-btn-danger btn-active"
            >
              拒绝
            </van-button>
          </view>

          <!-- 老师拒绝按钮 -->
          <van-button
            wx:if="{{ role === 'teacher' && item.status === 'pending_teacher' && (item.fromClub === userInfo.clubName || item.toClub === userInfo.clubName) }}"
            type="danger"
            size="small"
            bindtap="onReject"
            data-id="{{ item._id }}"
            custom-class="ed-btn-danger btn-active"
          >
            拒绝
          </van-button>
        </view>

        <!-- 审批/拒绝结果 -->
        <view wx:if="{{ item.status === 'approved' }}" class="ed-result-info success">
          <van-icon name="passed" size="28rpx" color="#38a169" />
          <text>审批人：{{ item.approvedByName }} · {{ item.approvedTime ? formatTime(item.approvedTime) : '' }}</text>
        </view>
        <view wx:if="{{ item.status === 'rejected' }}" class="ed-result-info error">
          <van-icon name="close" size="28rpx" color="#c53030" />
          <view class="ed-result-content">
            <text>拒绝人：{{ item.rejectedByName }}</text>
            <text class="ed-reject-reason">原因：{{ item.rejectReason }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:if="{{ !loading && transfers.length === 0 }}"
    type="transfer"
  />

  <!-- 没有更多 -->
  <view wx:if="{{ !loading && !hasMore && transfers.length > 0 }}" class="ed-no-more">
    没有更多了
  </view>

  <!-- 拒绝对话框 -->
  <van-dialog
    id="rejectDialog"
    use-slot
    title="拒绝申请"
    show-cancel-button
    confirm-button-text="确定"
    cancel-button-text="取消"
    bind:confirm="onRejectConfirm"
    bind:cancel="onRejectCancel"
  >
    <van-field
      value="{{ rejectReason }}"
      type="textarea"
      placeholder="请输入拒绝原因"
      autosize
      border="{{ false }}"
      bind:change="onRejectReasonInput"
    />
  </van-dialog>

  <van-toast id="van-toast" />
  <van-dialog id="van-dialog" />
</view>
