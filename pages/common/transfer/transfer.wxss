/* 转社团申请页面样式 */
/* 公共样式已在 app.wxss 中引入 common.wxss */
/* 使用公共类: .page-container, .info-row, .loading-wrapper, .no-more */

.transfer-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 转社团申请列表 */
.transfer-list {
  padding: 24rpx 30rpx;
}

/* 转社团申请项 - 继承公共 .card，仅覆盖特有样式 */
.transfer-item {
  padding: 32rpx 24rpx;
}

/* 申请头部 */
.transfer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.student-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.student-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.student-class {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 4rpx;
}

/* 转社团方向 */
.transfer-direction {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid #f0f0f0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.club-badge {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
}

.club-badge.from {
  background-color: #fff7e6;
  color: #ff9800;
  border: 2rpx solid #ffe7ba;
}

.club-badge.to {
  background-color: #e6f7ff;
  color: #1890ff;
  border: 2rpx solid #bae7ff;
}

/* 申请详情 */
.transfer-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.info-row {
  align-items: flex-start;
  font-size: 26rpx;
  line-height: 1.6;
}

.info-row .label {
  min-width: 120rpx;
}

.info-row .value {
  flex: 1;
}

/* 确认状态 */
.confirm-status {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.status-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.status-item.confirmed {
  color: #52c41a;
}

/* 操作按钮 */
.transfer-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

/* 审批/拒绝信息 */
.result-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 20rpx;
  flex-wrap: wrap;
}

.result-info.approved {
  color: #52c41a;
}

.result-info.rejected {
  color: #ff4d4f;
}

.reject-reason {
  width: 100%;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(255, 77, 79, 0.1);
}
